# The bitmap game for the browser, serving plain HTTP and its WebSocket on port
# 8081. Releases publish it as ghcr.io/lagergren/rylween. `./rylween serve` runs
# it through deploy/compose.yaml, and deploy/compose.https.yaml puts the released
# image behind Caddy for HTTPS; deploy/README.md covers both.
#
# By hand, from the repository root:
#   docker build -f deploy/docker/Dockerfile.bitmap -t rylween-bitmap .
#   docker run --rm -it -p 127.0.0.1:8081:8081 -v rylween-data:/data \
#     -e RYLWEEN_AUTH_SECURE_COOKIES=false rylween-bitmap

# The builder runs on the build machine's own platform even when the image is for
# another: Gradle's output is platform-independent jars and JavaScript, so a
# multi-platform build compiles once, and only the JRE stage below differs.
FROM --platform=$BUILDPLATFORM eclipse-temurin:25-jdk AS builder

# The Node.js that Gradle downloads to compile the TypeScript client (nodejs in
# gradle/libs.versions.toml) needs libatomic, which the JDK image leaves out.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libatomic1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY gradle/wrapper gradle/wrapper
COPY gradlew ./
RUN ./gradlew --no-daemon --version

COPY gradle/libs.versions.toml gradle/libs.versions.toml
COPY settings.gradle.kts build.gradle.kts ./
COPY build-logic build-logic
COPY . .
# Every source change invalidates COPY . ., so keep Gradle's dependency and build
# caches (which include the Gradle-managed Node.js download) and npm's cache in
# cache mounts that survive between image builds.
RUN --mount=type=cache,target=/root/.gradle/caches \
    --mount=type=cache,target=/root/.npm \
    ./gradlew --no-daemon :runtime-bitmap-web:installRuntimeBitmapWeb --console=plain

FROM eclipse-temurin:25-jre AS runtime

ARG RYLWEEN_DATA_DIR=/data
ENV RYLWEEN_DATA_DIR="${RYLWEEN_DATA_DIR}"
ENV RYLWEEN_BITMAP_HOST=0.0.0.0
ENV RYLWEEN_BITMAP_PORT=8081
ENV RYLWEEN_BITMAP_STATE=fresh-replay
ENV RYLWEEN_BITMAP_MAP_TILES=8
ENV RYLWEEN_BITMAP_TILE_SIZE=64
ENV RYLWEEN_BITMAP_SAVE_FILE=/data/saves/world.rsave
ENV RYLWEEN_AUTH_SECURE_COOKIES=true

WORKDIR /app
# --link builds this layer apart from the JRE under it, so the amd64 and arm64
# images share one copy of the game instead of storing it twice.
COPY --link --from=builder /src/runtimes/runtime-bitmap-web/build/install/rylween-bitmap-web /app/rylween-bitmap-web

ENV PATH="/app/rylween-bitmap-web/bin:${PATH}"
VOLUME ["/data"]
EXPOSE 8081
STOPSIGNAL SIGTERM

ENTRYPOINT ["sh", "-c", "mkdir -p \"$RYLWEEN_DATA_DIR/saves\" \"$RYLWEEN_DATA_DIR/logs/runtime-bitmap-web\" \"$RYLWEEN_DATA_DIR/auth\" && exec /app/rylween-bitmap-web/bin/rylween-bitmap-web --data \"$RYLWEEN_DATA_DIR\" --host \"$RYLWEEN_BITMAP_HOST\" --port \"$RYLWEEN_BITMAP_PORT\" --state \"$RYLWEEN_BITMAP_STATE\" --map-tiles \"$RYLWEEN_BITMAP_MAP_TILES\" --tile-size \"$RYLWEEN_BITMAP_TILE_SIZE\" --save \"$RYLWEEN_BITMAP_SAVE_FILE\" \"$@\"", "rylween-bitmap-web"]
