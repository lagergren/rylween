# Example settings for `docker compose` / `podman compose`, described at the top
# of compose.yaml. Copy this file to .env (git-ignored) next to compose.yaml and
# uncomment what you change; commented lines show the defaults. Variables
# exported in the shell take precedence over .env.

# Host address and port to publish on. The root ./deploy.sh detects this
# machine's LAN address unless .env sets the address; plain `docker compose up`
# publishes on 127.0.0.1.
# RYLWEEN_PUBLISH_HOST=127.0.0.1
RYLWEEN_HOST_PORT=8081

# Named volume or host directory (./path, ~/path, /path) for saves, accounts,
# and logs. A ./path is relative to deploy/.
# RYLWEEN_DATA_VOLUME=data

# Initial compiled state, wilderness viewport edge length, and tile size in px.
# RYLWEEN_BITMAP_STATE=fresh-replay
# RYLWEEN_BITMAP_MAP_TILES=6
# RYLWEEN_BITMAP_TILE_SIZE=68

# Set to true only when players reach the game over HTTPS.
# RYLWEEN_AUTH_SECURE_COOKIES=false

# Optional account to create or verify at startup.
# RYLWEEN_AUTH_ACCOUNT=
# RYLWEEN_AUTH_EMAIL=
# RYLWEEN_AUTH_PASSWORD=

# The sysop account, which gets the secret wilderness keys. Players cannot
# register it; the server creates it at startup, with RYLWEEN_ADMIN_PASSWORD or
# else a generated password saved in auth/admin-password.txt on the data volume.
# RYLWEEN_ADMIN_ACCOUNT=admin
# RYLWEEN_ADMIN_PASSWORD=

# An account the sysop gods hunt down every 101 moves. Unset means nobody.
# RYLWEEN_VICTIM_ACCOUNT=
