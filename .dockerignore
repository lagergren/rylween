# Build artifacts are regenerated inside the image. Patterns without a leading
# **/ only match at the context root, and each module keeps its own .gradle/
# (including a Gradle-managed host Node.js) and node_modules/.
**/.gradle/
**/.kotlin/
**/build/
**/node_modules/
**/.venv/
**/__pycache__/

# Editor / local tool state.
.DS_Store
.claude/
.idea/
.vscode/
*~

# Local repo and scratch state.
.git/
.gitignore
scratch/

# Local compose settings; may hold account passwords.
.env
