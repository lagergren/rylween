root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 140
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Standard Kotlin coding conventions, enforced by ktlint.
# These are enabled by ktlint's default ruleset; listing them here
# makes the project's stance explicit and survives any future tweak
# of the default ruleset.
#
# property-naming distinguishes `const val` (SCREAMING_SNAKE_CASE) from
# regular `val` / `var` (camelCase) — a top-level `val x = listOf(...)`
# is camelCase even though the reference is reassignment-free, because
# only `const val` is a true compile-time constant.
ktlint_standard_property-naming = enabled
ktlint_standard_function-naming = enabled
ktlint_standard_class-naming = enabled
ktlint_standard_no-wildcard-imports = enabled
ktlint_standard_enum-entry-name-case = enabled
