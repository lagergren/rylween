# towne-thord-church-resurrect: pin the temple's (R)aise dead branch
# end-to-end. Slot 3 starts dead via RYL_FORCE_DEAD_SLOT so the
# fixture exercises the dead-target arm of the church R action
# without a combat detour. This path was the one broken by the
# pre-§23 bug fixed in commits 089277e (towne.church 'who' rebind),
# b5cda77 ('0' arithmetic via single-char string), and 051557d
# (digit_range index_var: auto-bind kills the who_key indirection).
# Without this fixture, those fixes could regress unnoticed.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
RYL_FORCE_DEAD_SLOT=3
