# §22.5 #3 combat-mage-fire: pin one mage Fire Cloud cast over a
# multi-foe encounter so the for_monster loop walks 1..noc with the
# per-iteration RNG draw preserved on dead slots (the legacy quirk
# § 22 Lane A inherited verbatim). NOC=2 keeps the fight short while
# exercising the loop body twice.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=2
RYL_NO_DELAY=1
RYL_FORCE_ENCOUNTER=wild_dog
RYL_FORCE_ENCOUNTER_NOC=2
