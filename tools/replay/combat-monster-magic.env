# §23.A combat-monster-magic: pin a monster nasty-magic encounter so
# the post-§23.A dispatcher (battle.c::g==5 → res_monster_spell_node →
# play_spell_body) is exercised under byte-identity. Single
# hobgoblin_chief: sp=40 → ryl_chance(15+40/2)=35% per round, h1=150
# to h2=230 (tough but survivable for a level-15 party), ws=100. The
# party-level bump is what lets the fight resolve cleanly within a
# bounded keystroke budget; without it the party gets ground down
# before enough rounds elapse to land at least one cast.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
RYL_FORCE_ENCOUNTER=hobgoblin_chief
RYL_FORCE_ENCOUNTER_NOC=1
RYL_FORCE_PARTY_LV=15
