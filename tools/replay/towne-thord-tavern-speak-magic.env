# Q→M (magic) gate for the speak.* slug-spliced emit_indexed path.
# Same setup as towne-thord-tavern-speak-people (C22ETSA — continue
# from title, walk south to Thord, enter, tavern, speak, NPC A) but
# Q→M→<any-key> exercises the speak.magic dispatcher:
# play_script("speak.magic") binds `job_sym` to the selected NPC's
# slug ("merchant" under seed 42), emit_indexed splices the slug
# into 'speak.magic.j{}', resolving to speak.magic.jmerchant. The
# people fixture covers the P arm; this one covers the parallel M
# arm so the slug-spliced path is gated on both Q-branch dispatchers.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
