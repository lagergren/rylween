# §22.5 #4b combat-mage-antimagic: single antimagic cast — the third
# arm of the flag trio that didn't fit alongside confusion + hold in
# #4a (combined cost would exceed slot 1 mage's ma cap of 67). Pinned
# alone here so the silence emit, the 2800ms pause (vs confusion /
# hold's 2000ms — preserved verbatim from legacy timing), and the
# battle_flag antimagic set 1 mutate all land on the byte stream.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=2
RYL_NO_DELAY=1
RYL_FORCE_ENCOUNTER=wild_dog
RYL_FORCE_ENCOUNTER_NOC=1
