// Potions shard — ids 36–38. Each declares an `effect:` block that
// inventory.c::apply_potion dispatches on; new potion kinds are a
// data-only addition once their `kind` is registered in apply_potion.
{
  red_potion: {
    id: 36, name: 'Red Potion', cost: 30,
    effect: { kind: 'heal',         amount: 15 },
  },
  blue_potion: {
    id: 37, name: 'Blue Potion', cost: 100,
    effect: { kind: 'poison',       amount: 15 },
  },
  amber_potion: {
    id: 38, name: 'Amber Potion', cost: 500,
    effect: { kind: 'restore_mana' },
  },
}
