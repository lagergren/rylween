// §20 T1: terrain-transition narration script. Replaces the inline
// switch in src/interact.c::check_terrain. The C wrapper passes the
// previous and current tile bytes (state.last_terrain and the new
// map cell) as int bindings; this script owns the same-tile guard,
// the 1-in-9 chance gate, the clw, and the per-tile-class text
// dispatch.
//
// Bindings:
//   old, new — ASCII byte values of the previous / current tile.
//
// Tile-byte → narration mapping (keys match the world.json5 terrain
// subtree; the script DSL coerces a 1-char string literal in an int
// position to its ASCII byte, so `match: 's'` is the tile byte for
// plainland).
//
// Other tiles fall through with no narration; the trailing `blank`
// emit still fires because `tx("\r\n")` in the original ran after
// the switch unconditionally.
{
  transition: [
    { if: {
        cond: { ne: [{ var: 'old' }, { var: 'new' }] },
        then: [
          { if: { cond: { chance: 9 }, then: [
            { engine_call: 'clw' },
            { switch: { expr: { var: 'new' }, cases: [
              { match: 's', then: [{ emit: 'plainland' }] },
              { match: '1', then: [{ emit: 'hut'       }] },
              { match: '0', then: [{ emit: 'towne'     }] },
              { match: 'f', then: [{ emit: 'foothills' }] },
              { match: 'd', then: [{ emit: 'desert'    }] },
              { match: 't', then: [{ emit: 'swamp'     }] },
              { match: 'g', then: [{ emit: 'forest'    }] },
              { match: '2', then: [{ emit: 'castle'    }] },
            ] } },
            { emit: 'blank' },
          ] } },
        ],
    } },
  ],
}
