// Mission triggers — port-plan Tier 0.1.
//
// Walked top-to-bottom by missions.c::dispatch_triggers; the first
// entry whose `where` matches the call site, whose `flag_tag` /
// `when_state` pair matches the live party (NULL/missing = no flag
// gate, always pass), and whose guard predicate fires runs its
// action. Order is load-bearing: blocks 1-16 reproduce the historical
// `mission_control()` if/else cascade in src/missions.c, and the
// trailing three Castle Ydarg entries are the E-key path migrated
// out of `towne.c::enter`.
//
// Schema (matches the C `mission_trigger` struct one-for-one — keep
// fields in the same order so a side-by-side diff against missions.h
// stays readable):
//
//   flag_tag    string  Optional. Slug under data/world/flags.json5.
//                       Omit (or set null) for an always-pass trigger
//                       — the Castle Ydarg entries take this path.
//   when_state  string  Optional. The values[] name in `flag_tag`'s
//                       shard; required when flag_tag is set.
//   where       enum    Optional. 'step' (default) = step-poll, fired
//                       from random_wilderness on every wilderness
//                       move. 'enter_key' = E-key, fired from
//                       towne.c::enter when the party stands on a
//                       settlement tile.
//   kind        enum    Required. Guard predicate kind:
//                       'pos'          x == a && y == b
//                       'dungeon_idx'  x == dx[a] && y == dy[a]
//                       'terrain'      wld_tile_at(x,y) == (char)a
//                       'chance'       ryl_chance(a) — % roll
//                       'tile_at_pos'  pos matches `pos_path` AND
//                                      terrain class == `tile_class`
//                       'special_eq'   tile_at_pos AND
//                                      pa_special(special_tag) == a
//   a, b        int     Kind-specific args. See the C comment block
//                       above each block in missions.c for the
//                       per-kind interpretation. `a` is the only one
//                       used by chance / terrain / dungeon_idx /
//                       special_eq; `pos` uses both.
//   tile_class  string  tile_at_pos / special_eq — terrain-class slug
//                       to match (e.g. 'castle').
//   pos_path    string  tile_at_pos / special_eq — dotted path to a
//                       {x, y} subtree under the world tree, resolved
//                       at guard time via res_int_path.
//   special_tag string  special_eq — special-flag slug, resolved to
//                       PS_* via inv_special_id_for_tag and compared
//                       against `a`.
//   action      enum    Optional. 'script' (default) — play_script
//                       on `script`. 'c_fn' — call into C via a slug
//                       resolved by mission_resolve_c_fn (today only
//                       'ydarg' is wired).
//   script      string  action='script' — DSL script id.
//   c_fn        string  action='c_fn' — C-function slug. Unknown
//                       slugs hard-fail at fold time.
//   returns_on_skip bool Optional, default false. When true, the
//                       dispatcher's caller short-circuits its turn
//                       even if the user dismissed the trigger
//                       (mirrors the historical `return 1` in blocks
//                       9, 11, 12, 14, 16).
//   post        enum    Optional. 'none' (default) or 'set_jazzyfoot'
//                       — runs after the script/c_fn returns.
//   binds       array   Optional. {name, kind, arg?, npc_role?}
//                       records, max 4. Pass-through to play_script.
//                         kind='npc_name'    arg ignored; npc_role
//                                            resolves to the NPC's
//                                            display name via
//                                            res_npc_name(res_npc_role()).
//                         kind='player_name' party-slot name at index
//                                            `arg` via pa_name(arg).
//                         kind='dx_str'      stringified
//                                            wld_location_x(arg).
//                         kind='dy_str'      stringified
//                                            wld_location_y(arg).
[
  // Block 1: Erethor temple at (6, 20).
  { flag_tag: 'erethor.lute', when_state: 'rumour_told',
    kind: 'pos', a: 6, b: 20,
    script: 'missions.erethor_entry' },

  // Block 2: Husband cave at (42, 23). Binds {name19} to the
  // peasant-husband NPC's display name.
  { flag_tag: 'peasant_wife', when_state: 'accepted',
    kind: 'pos', a: 42, b: 23,
    script: 'missions.husband_cave',
    binds: [
      { name: 'name19', kind: 'npc_name', npc_role: 'peasant_husband' },
    ] },

  // Block 3: Bandit cargo. 9% chance gate.
  { flag_tag: 'garth.bandits', when_state: 'accepted',
    kind: 'chance', a: 9,
    script: 'missions.bandits' },

  // Block 4: Troll tooth. 9% chance gate.
  { flag_tag: 'hermit.troll_tooth', when_state: 'accepted',
    kind: 'chance', a: 9,
    script: 'missions.troll_tooth' },

  // Block 4b: Hermit-quest dungeon at dx[1], dy[1].
  { flag_tag: 'hermit.troll_tooth', when_state: 'delivered',
    kind: 'dungeon_idx', a: 1,
    script: 'missions.hermit_dungeon' },

  // Block 6: Kobold village at dx[3], dy[3].
  { flag_tag: 'mastercrown', when_state: 'task1_assigned',
    kind: 'dungeon_idx', a: 3,
    script: 'missions.kobold_village' },

  // Block 7: Skullweed on terrain 't'.
  { flag_tag: 'mastercrown', when_state: 'task2_assigned',
    kind: 'terrain', a: 116,   // 't'
    script: 'missions.skullweed' },

  // Block 8: Borin first visit at dx[4], dy[4]. Binds {dx5}/{dy5}
  // for the crypt-location screen + journal.
  { flag_tag: 'mastercrown', when_state: 'task3_assigned',
    kind: 'dungeon_idx', a: 4,
    script: 'missions.borin_meet',
    binds: [
      { name: 'dx5', kind: 'dx_str', arg: 5 },
      { name: 'dy5', kind: 'dy_str', arg: 5 },
    ] },

  // Block 9: Nolrim crypt at dx[5], dy[5].
  { flag_tag: 'mastercrown', when_state: 'borin_met',
    kind: 'dungeon_idx', a: 5,
    script: 'missions.nolrim_crypt',
    returns_on_skip: true },

  // Block 10: Borin gift at dx[4], dy[4].
  { flag_tag: 'mastercrown', when_state: 'dagger_taken',
    kind: 'dungeon_idx', a: 4,
    script: 'missions.borin_gift' },

  // Block 11: Master crown dungeon at dx[6], dy[6].
  { flag_tag: 'mastercrown', when_state: 'crown_told',
    kind: 'dungeon_idx', a: 6,
    script: 'missions.master_crown',
    returns_on_skip: true },

  // Block 12: Ogre cave at dx[7], dy[7]. Binds {p2_name} (party
  // member 2's name, used in the note-found screen).
  { flag_tag: 'jazzy_ogre', when_state: 'accepted',
    kind: 'dungeon_idx', a: 7,
    script: 'missions.ogre_cave',
    returns_on_skip: true,
    binds: [
      { name: 'p2_name', kind: 'player_name', arg: 2 },
    ] },

  // Block 13: Foot of Jazzy altar on terrain 'f'. Post-action awards
  // the jazzyfoot special flag.
  { flag_tag: 'jazzy_ogre', when_state: 'ogres_cleared',
    kind: 'terrain', a: 102,   // 'f'
    script: 'missions.jazzy_foot',
    post: 'set_jazzyfoot' },

  // Block 14: Silver key dungeon at dx[8], dy[8].
  { flag_tag: 'silver_key', when_state: 'map_bought',
    kind: 'dungeon_idx', a: 8,
    script: 'missions.silver_key',
    returns_on_skip: true },

  // Block 15: Hobgoblin caravan. 9% chance + binds {dx9}/{dy9}
  // for the interrogate screen + journal.
  { flag_tag: 'silver_key', when_state: 'smith_confessed',
    kind: 'chance', a: 9,
    script: 'missions.hobgoblin_caravan',
    binds: [
      { name: 'dx9', kind: 'dx_str', arg: 9 },
      { name: 'dy9', kind: 'dy_str', arg: 9 },
    ] },

  // Block 16: Hobgoblin cave (pit) at dx[9], dy[9].
  { flag_tag: 'silver_key', when_state: 'cave_located',
    kind: 'dungeon_idx', a: 9,
    script: 'missions.hobgoblin_cave',
    returns_on_skip: true },

  // Castle Ydarg gate (E-key path, not step-poll). The trigger
  // fires from towne.c::enter when the party stands on the castle
  // tile at (ydarg.entry.x, ydarg.entry.y). Three arms gated by
  // silverkey state via 'special_eq':
  //   silverkey == 2 (castle is rubble): play ydarg.ruin
  //   silverkey == 0 (no key yet)      : play ydarg.no_key
  //   silverkey == 1 (legitimate entry): C fn ydarg() — the multi-
  //     floor navigation + per-room dispatch + confrontation are
  //     still in C, gated by the position+terrain match (no
  //     special filter so it fires for any non-{0,2} value, which
  //     today is just 1).
  { where: 'enter_key',
    kind: 'special_eq', a: 2,
    tile_class: 'castle', pos_path: 'ydarg.entry',
    special_tag: 'silverkey',
    action: 'script', script: 'ydarg.ruin' },
  { where: 'enter_key',
    kind: 'special_eq', a: 0,
    tile_class: 'castle', pos_path: 'ydarg.entry',
    special_tag: 'silverkey',
    action: 'script', script: 'ydarg.no_key' },
  { where: 'enter_key',
    kind: 'tile_at_pos',
    tile_class: 'castle', pos_path: 'ydarg.entry',
    action: 'c_fn', c_fn: 'ydarg' },
]
