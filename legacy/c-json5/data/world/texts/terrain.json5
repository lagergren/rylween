// §20 T1 narration atoms for the terrain-transition script.
// Authored alongside data/world/scripts/terrain.json5; emitted from
// `terrain.transition` whenever the party walks onto a different
// tile class than the previous step (gated 1-in-9 by chance(9)).
//
// Atom names match the human-readable tile-class identifier rather
// than the underlying ASCII byte. The script-side switch is the
// authoritative byte-to-class mapping.
{
  plainland: ['The rich green plainland',
              'of Rylween stretches far',
              'in all the directions.'],
  hut:       ['You have found a hut.'],
  towne:     ['You are close to a towne.'],
  foothills: ['Small foothills make your',
              'progress more arduous.'],
  desert:    ['You are in a hot and dry',
              'desert. The sun fries',
              'you mercilessly.'],
  swamp:     ['You are in the swampy',
              'marshlands of Rylween.',
              'Bubbles of gas rise to',
              'the surface where they',
              'burst and emit a foul',
              'smelling odour.'],
  forest:    ['The ancient forest is',
              'very tranquil. A soft',
              'breeze rustles the',
              'leaves of mighty oaks.'],
  castle:    ['You stand outside the',
              'castle Zadraz. The',
              'black steel building',
              'seems to want to swallow',
              'you whole.'],

  // Trailing blank line emitted after every transition narration,
  // matching the original `tx("\r\n")` after the switch in interact.c.
  // Authored as a single-element array of an empty string so the
  // text shard's "trailing \r\n appended" rule produces exactly the
  // two bytes `\r\n` (verbatim "" would emit nothing).
  blank:     [''],
}
