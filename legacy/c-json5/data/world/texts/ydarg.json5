// Castle Ydarg narrative, dungeon, and final-boss text (ydarg.c).
// ydarg() handles the approach + Jaara encounter + the per-room events
// on four 5x5 floors; confrontation() owns the roof-deck showdown with
// Baron Ydarg. Lines with %s / %d in the original tx() call stay inline
// in the C source — only pure static chains moved here.
//
// ESC (0x1b) bytes inside the final-boss banners are encoded via the
//  JSON5 escape so the SGR color sequences survive round-tripping.
{
  // --- ydarg(): approach + gate guardian --------------------------

  ruin: [
    'The once so mighty',
    'castle Zadraz is now',
    'nothing but a ruin.',
    'You have nothing else',
    'to do here.',
    '',
  ],
  approach: [
    'A black and foreboding',
    'castle looms over the',
    'horizon. Its cold, black',
    'stone walls are decorated',
    'with complex symbols and',
    'archaic runes of long',
    'forgotten language.',
    '',
  ],
  jaara_form: [
    'A shape of white mist',
    'slowly thickens to human',
    'shape. A transparent image',
    'of a beautiful woman',
    'forms in front of you.',
    '',
  ],
  jaara_speech: [
    '- Do not be afraid,',
    'adventurers. I am Jaara,',
    'guardian of the gate.',
    'Baron Ydarg has imprisoned',
    "me here forever. I can't",
    'hurt you, just stop you',
    "from entering if you don't",
    'have the Silver Key!',
    '',
  ],
  no_key: [
    "- You don't have the",
    'Key. The gate will',
    'remain sealed.',
    '',
  ],
  key_accepted: [
    'You show the Silver Key to',
    'the ghost. Her eyes widen,',
    'as she sees it. She smiles',
    'and waves her hand towards',
    'the drawbridge. It falls',
    'to the ground with a',
    'resounding KRASH. Jaara',
    'slowly fades away until',
    'nothing remains.',
    '',
  ],
  enter:      ['You enter.', ''],
  door_slams: ['The first door you enter', 'slams shut behind you!'],

  // --- per-room events (case 1..3 and 50) -------------------------

  room: {
    monster: ['You are spotted by', 'monsters!'],
    trap: {
      // §23.J case-2 lift — the legacy two `tx(...)` calls per
      // line collapse into single text-array records. Bytes are
      // identical because emit_with_col_jump emits one CSI right-
      // jump prefix per CRLF-terminated line either way.
      springs:         ['{victim} springs a',
                        'trap!!!'],
      tries_disarm:    ['{thief} tries to',
                        'disarm it...',
                        ''],
      disarm_succeed:  ['AND SUCCEEDS!'],
      disarm_fail:     ['BUT FAILS!'],
      arrows:          ['Arrows speed through',
                        'the air and hits the',
                        'party!',
                        ''],
      poison:          ['Poison needles shoot',
                        'out from the floor!',
                        ''],
      shurikens:       ['A volley of shurikens',
                        'is hurled from a hatch',
                        'in the wall!',
                        ''],
    },
    treasure: {
      find:     ['You find a',
                 '{object}.',
                 ''],
      menu:     ['(T)ake it', '(L)eave it'],
      full:     ["You can't carry more."],
      taken:    ['', 'Ok.'],
    },
    stairs: {
      intro:       ['You stand before the',
                    'stairs to the next level.',
                    ''],
      mage_offer:  ['A mage imprisoned in a',
                    'fiery sphere offers to',
                    'open trapdoor at the top',
                    'of the stairs if you',
                    'give him an item of power!',
                    'He also offers to teleport',
                    'you out of the castle,',
                    'for free.',
                    ''],
      menu:        ['Choose:',
                    '',
                    '(T)eleport Out',
                    '(G)ive him an item',
                    '(L)eave'],
      leave:       ['You take the nearest exit!'],
      teleport_vortex:  ['The world fades into a',
                         'vortex of agonizing',
                         'vertigo...',
                         ''],
      teleport_outside: ['And you are outside...'],
      give_menu:   ['Give him what?',
                    '',
                    '1. The Fire Shield',
                    '2. The Master Crown',
                    '3. The Foot of Jazzy',
                    '4. The Bracelets of Thun',
                    '5. Nothing'],
      no_have_sing: ["You don't have it!"],
      no_have_plur: ["You don't have them!"],
      mage_grateful: ['The sphere fades away',
                      'and the mage steps out.',
                      'He is grateful. Before',
                      'he teleports away, he',
                      'casts an OPEN spell on the',
                      'trapdoor above and speaks:',
                      '- I will aid thee in the',
                      'final battle!',
                      ''],
    },
  },

  // --- navigation (status_line / compass / direction chooser) -----

  nav: {
    // §23.J nav-render lift — coords/level lines were two `tx(...)`
    // calls (with one stray third arg in the legacy "You are at" call,
    // which was silently dropped). Two-line / one-line shapes match
    // the byte sequence emit_with_col_jump produced before.
    coords:    ['You are at {xl}x{yl}.', ''],
    level:     ['You are on level {lvl}.'],
    floor_1:   ['(Ground Level)', ''],
    floor_2:   ['(First Floor)',  ''],
    floor_3:   ['(Base of Tower)', ''],
    floor_4:   ['(Top of Tower)', ''],
    // Compass drawing. Blank rows pad out the header when north is
    // sealed off, so the compass always occupies three lines.
    north:     ['    8  North  ', '    |'],
    no_north:  ['', ''],
    east_west: [' 4 -+- 6  East/West'],
    east:      ['    +- 6  East'],
    west:      [' 4 -+     West'],
    south:     ['    |', '    2  South  '],
    go_north:  ['North.'],
    go_south:  ['South.'],
    go_east:   ['East.'],
    go_west:   ['West.'],
    view_who:  ['Who? (1-{party_max}/Q/A)'],
  },

  // --- confrontation() on the roof deck ---------------------------

  conf: {
    trapdoor_slam: ['The last trapdoor',
                    'slams shut behind you.',
                    'You are high above the',
                    'forest, on the roof',
                    'of this fortress.',
                    'Suddenly, a voice speaks:',
                    ''],
    fools:         ['- Fools! You have gone',
                    'long to come this far, but',
                    'here ends your journey!',
                    '',
                    'The night sky above lights',
                    'up with green flashes, and',
                    'Ydargs minions rush',
                    'to attack you!',
                    ''],
    corpses:       ['Corpses of the nightmare',
                    'terrors are strewn all',
                    'around. A dark cloaked',
                    'figure appears before you.',
                    'He takes a broad step over',
                    'the dead and dying, and',
                    'gazes at you with cold',
                    'glowing green eyes.',
                    ''],
    impress:       ['- So. You have completed',
                    'the battle test. I must',
                    'confess that you impress',
                    'me. But now...',
                    '',
                    '(He waves a pointed stick',
                    'and energy begins to form',
                    'in the air before you.)',
                    ''],
    sphere:        ['A glowing energy sphere',
                    'appears, and at a gesture',
                    "from Ydarg's stick, it",
                    'hurtles towards you!!!',
                    ''],
    // {p1_name} = state.p[cpl].name[1]; filled in by tx_fmt at call
    // time (§16.3).
    mages:         ['Suddenly! You feel someone',
                    'else near. {p1_name} turns',
                    'around and discovers the',
                    'four grey-clad mages!',
                    'They simultaneously raise',
                    'their hands, and the',
                    'sphere bounces over you',
                    'and is absorbed by their',
                    'hands!',
                    ''],
    curses:        ['- CURSES! Ydarg growls.',
                    '- So this is what has come',
                    'to! Well, you got here by',
                    'aid of cold steel, and',
                    'that is the way you shall',
                    'perish!',
                    ''],
    trident:       ['He pulls a huge trident',
                    'from his robe and utters',
                    'a single syllable. Without',
                    'warning he appears a foot',
                    'before you!!!',
                    ''],
    commence:      ['Let the battle commence!', ''],
    trident_falls: ["Ydarg's trident clatters",
                    'to the ground before you.',
                    'He shudders and falls over.',
                    'As you rush to kill him',
                    'he screams:',
                    ''],
    not_over:      ['- It is not over! I shall',
                    'see you in hell! In',
                    'another world! A time',
                    'to come! You have tainted',
                    'Zadraz with your ancient',
                    'items, but I will triumph',
                    'again!!! Anew...',
                    ''],
    cloak:         ['His cloak collapses, and',
                    'when you tear it away,',
                    'you reveal nothing but...',
                    ''],
    dust:          ['dust...', ''],
    congrats:      ['[31mCONGRATULATIONS![37m',
                    '',
                    'You have banished Ydarg',
                    'from this dimension.',
                    'Please ask your SysOp to',
                    'reset the game.',
                    ''],
    heroes:        ['Be ready for:',
                    '[31mHEROES OF RYLWEEN[37m',
                    '- The second coming.',
                    'Soon online at a BBS',
                    'near you!',
                    ''],
    signoff:       ['See Ya!!!',
                    '',
                    '     /Marcus',
                    ''],
  },
}
