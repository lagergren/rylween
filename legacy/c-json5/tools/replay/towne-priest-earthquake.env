# §22.5 #8d towne-priest-earthquake: pin the wilderness Earthquake cast.
# place=0 (wilderness) hits the else-arm of the place-eq-1 gate inside
# the spell's body and runs the full earthquake-creates-cave sequence;
# the followup cave_found_prompt offers (E)nter the new dungeon or
# (L)eave it. This fixture picks L so the cast renders end-to-end and
# returns to the map without a dungeon descent (descents have their
# own fixtures).
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=2
RYL_NO_DELAY=1
