# Lodging-fee regression gate: bargirl Q→L arm in lodge.json5.
# Picks NPC B (Deanna, the Thord bargirl, slot 34 — second NPC by
# slot in the Thord tavern after Niklas the tavernkeeper at slot 29),
# runs Q (question) → L (lodge) → Y (pay), then backs out cleanly.
# Validates:
#   - 50 * pa_first_level() fee resolved by the C wrapper
#   - gold mutate sub against {var:'price'} (gold 1000 → 950)
#   - for_member loop with `gt: hp > 1` guard, decrementing each
#     party member's hp by 1 (member_field hp mutate sub)
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
