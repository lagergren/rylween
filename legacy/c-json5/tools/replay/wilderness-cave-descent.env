# Dungeon-path regression gate: random-cave entry, descent, ascent, exit.
# Shares the seed-42 / epoch-1700000000 entropy stream with the other
# wilderness fixtures so the cave-found roll fires deterministically a
# few moves into a north/south oscillation from the seed-42 spawn at
# (12, 9). The path exercises:
#   - cave.found_prompt + random_wilderness cave dispatch (subs.c)
#   - dungeon() level driver + (D)escend / (A)scend menu (dungeon.c)
#   - dungeon.<encounter> DSL scripts at the random-fill level slots
#     migrated in §20 L1.5 / L2 (data/world/scripts/dungeon.json5)
#   - "leave the hideous cavern" exit + ryl_pause back to wilderness
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
