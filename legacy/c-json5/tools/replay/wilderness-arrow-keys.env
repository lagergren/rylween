# Arrow-key path coverage. Mirrors wilderness-terrain-narration's
# move sequence (28286226) but pipes ANSI ESC[A/B/C/D bytes instead
# of literal numpad digits. tty_getch's peek_byte_timed translates
# the CSI tail into the same digits the wilderness loop already
# consumes, so the resulting .expect / .expect_snapshot should be
# byte-identical to the digit fixture's. Pinned epoch + seed match
# the sister fixture for that same reason.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
