# Q→P (people) gate for the speak.* slug-spliced emit_indexed path.
# Same setup as towne-thord-tavern-speak (C22ETSA — continue from
# title, walk south to Thord, enter, tavern, speak, NPC A) but
# instead of `B` (back) the input does Q→P→<any-key> to exercise
# the speak.people dispatcher: play_script("speak.people") binds
# `job_sym` to the selected NPC's slug ("merchant" under seed 42),
# emit_indexed splices the slug into 'speak.people.j{}', resolving
# to speak.people.jmerchant. Without this fixture the slug-spliced
# path has no byte-identity gate; the bargirl L7 fixture only covers
# the lodge.bargirl branch which sidesteps emit_indexed.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
