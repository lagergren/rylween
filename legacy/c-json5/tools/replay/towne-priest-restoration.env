# §22.5 #7a towne-priest-restoration: pin one out-of-combat priest
# Restoration cast. Same dispatch shape as heal but the DSL skips the
# random roll and the dead-check — restoration unconditionally pegs
# target.hp to target.h (legacy quirk: works on dead targets too,
# leaves dead=1, just refills the hp pool).
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=2
RYL_NO_DELAY=1
