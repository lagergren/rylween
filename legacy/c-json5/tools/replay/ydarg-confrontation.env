# ydarg-confrontation: full Castle Ydarg dungeon walk-through plus
# the §23.I confrontation() act-1 narration and the act-1 prelude
# combat sweep (4-monster sequence). Exercises every §23 endpoint
# bundled into ydarg.c: §23.H (room dispatcher leftovers — only
# the no-op room since RYL_FORCE_YDARG_EASY_ROOMS pins room[i][j]=4),
# §23.F (stairs G+digit item-trade across all four floors), §23.I
# (tx_narrate driving conf_act1), and the §23.J knobs themselves.
#
# Path: the party warps to (14,30), enters the castle, walks all
# four floors to the stairs, gives the four pre-granted quest items
# to the floor mages (1=fireshield, 2=mastercrown, 3=jazzyfoot,
# 4=bracelets), then engages the confrontation. Bless captured a
# loss path during fight #2 (Night Gaunt's Cloud of Fire AOE
# one-shots three chars after the party kills one of two gaunts);
# the fixture pins that path per the §23.J authoring note ("pin
# whichever path the bless captures"). Coverage of conf_act2/3/4 +
# the baron fight + the heroes-file write is left for a follow-up.
#
# Knobs:
#   RYL_FORCE_POS=14,30                — drop the party at the
#       castle gate so 'E' fires ydarg() on the first wilderness key.
#   RYL_FORCE_PARTY_LV=28              — engine level ceiling so
#       attacks have ws/h/wi/ch in the high range.
#   RYL_FORCE_PARTY_WP=dancing_sword   — top mundane weapon (50 dmg)
#       so dancing_sword + lv-28 hp gives ~65 dmg per hit; without
#       this the party deals obdamage(0) damage and crypt_horror
#       alone is a 60+ round fight.
#   RYL_FORCE_PARTY_HP_FULL=1          — heal hp up to h after the
#       lv bump (rk_apply_party_lv intentionally leaves hp at the
#       lv-1 roll for fixture-snapshot stability; this fixture needs
#       hp scaled alongside h or every char one-shots in round one).
#   RYL_FORCE_YDARG_GRANTS=1           — pre-grant the four quest
#       items + silver key so the gate accepts the party and the
#       stairs G-prompt advances on every floor.
#   RYL_FORCE_YDARG_EASY_ROOMS=1       — every non-stairs room slot
#       is case 4 (no-op) so the keystroke stream is not at the
#       mercy of per-tile RNG.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
RYL_FORCE_POS=14,30
RYL_FORCE_PARTY_LV=28
RYL_FORCE_PARTY_WP=dancing_sword
RYL_FORCE_PARTY_HP_FULL=1
RYL_FORCE_YDARG_GRANTS=1
RYL_FORCE_YDARG_EASY_ROOMS=1
