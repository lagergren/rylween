# §22.5 #5 combat-mage-death: pin one mage Death Strike cast end-to-end.
# Death cost = base 78 + lv = 81 at lv 3, which exceeds the lv-1 ma cap
# (= seed wi, max 70). RYL_FORCE_PARTY_LV=3 raises every member to lv 3
# and applies the per-class levelup deltas (mage wi +7×2 = +14), so
# slot 1's ma becomes 81 — death just fits. The same input shape as
# combat-mage-frost, with C1 swapped for C4 (slot 4 in the spell menu
# is Death Strike). Whichever arm of the random(0, 199) < monster_hp
# gate the deterministic RNG draw lands on (resist or kill) is the arm
# this fixture pins; a follow-up fixture would have to alter the
# encounter to flip the gate.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=2
RYL_NO_DELAY=1
RYL_FORCE_ENCOUNTER=wild_dog
RYL_FORCE_ENCOUNTER_NOC=1
RYL_FORCE_PARTY_LV=3
