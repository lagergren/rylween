# Sourced by tools/replay.sh before running the binary. Keeps entropy
# pinned so rolled stats, ryl_pause verb choice, and getclk-derived
# state are byte-stable across runs. NO_DELAY drops the title-screen
# usleep frame pacing so the replay finishes in ~3s instead of ~15s.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
