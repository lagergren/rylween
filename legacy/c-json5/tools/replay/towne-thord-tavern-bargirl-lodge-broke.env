# Broke-arm regression for the bargirl Q→L lodge flow.
# Pays 20 times at 50 gold each (1000 → 0), then a 21st attempt
# trips the `lt: gold < price` arm of the menu_branch's Y key —
# emits speak.lodge.j13.broke + 2-second pause, no mutation. Each
# pay also burns 1 hp per member via for_member with the gt-1
# guard, so by attempt 21 hp values reflect 20 ticks of drain.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
