# L7 step 3 regression gate: subs.c camp() → rest.json5.
# Walks 14 north/south alternations from the seed-42 spawn (12, 9) so
# foodhandler ticks hours_rested down from 14 to 0; then C opens camp.
# N declines the guard prompt (default branch — no-op fall through).
# What the script then exercises depends on the temperature roll:
#   - ambush_pct = 19% post-rest dice → most seeds land on well_rested
#   - temperature_max = 15 → roll selects damage/no-damage band
# Validates every L7 DSL extension at once: hours_rested expr,
# advance_hour engine_call, pa_alive_count engine_int, food clamp:min,
# hp clamp:max, encounter tier, surprise-kill member_field mutate
# (hp/dead), pl mutate sub.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
