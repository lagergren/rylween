# ydarg-no-key: pin the castle Ydarg gate-rejection path. Party
# warps to the entry tile (14, 30) via the new RYL_FORCE_POS knob,
# then presses E to engage Jaara without a silver key. Exercises
# the approach narration (ydarg.approach + ydarg.jaara_form +
# ydarg.jaara_speech) and the pa_special(PS_SILVERKEY) == 0
# rejection branch (ydarg.no_key). Returns to wilderness without
# entering the castle proper — the per-floor walkthrough +
# confrontation paths are queued separately (would need an
# easy-rooms knob and ~80 keystrokes of navigation/give-item).
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
RYL_FORCE_POS=14,30
