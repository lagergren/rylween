# §22.5 #1 combat-attack-win: fixture pinning the encounter / reward /
# expcheck path. RYL_FORCE_ENCOUNTER fires one mandatory wild_dog fight
# on the first wilderness move; the env var is cleared after firing so
# subsequent moves resume normal RNG. Wild dog (n1=1, n2=3, h1=15, h2=40)
# is the lowest-HP weak-tier monster — small enough that a default-stats
# four-thief party can reliably finish in a few rounds, large enough to
# exercise the per-attack hp/12 + ryl_random(0,4) damage formula and the
# obdamage(0) no-weapon path.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
RYL_FORCE_ENCOUNTER=wild_dog
RYL_FORCE_ENCOUNTER_NOC=1
