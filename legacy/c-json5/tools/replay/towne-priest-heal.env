# §22.5 #6 towne-priest-heal: pin one out-of-combat priest Healing cast
# from the wilderness Z key. Seed 2 places a wi=67 character in slot 1
# (created here as a priest, class 4). subs.c::spell(0) dispatches to
# play_spell_body with caster_idx + place=0 bindings; the DSL handles
# the ma debit, the ask_target party_member prompt, and the alive /
# dead branches. No encounter is forced — this fixture exercises the
# priest cast path independent of combat.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=2
RYL_NO_DELAY=1
