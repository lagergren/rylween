# C (chitchat) gate for the speak.chit_reply slug-spliced
# emit_indexed path. Same setup as towne-thord-tavern-speak-people
# (C22ETSA — continue from title, walk south to Thord, enter,
# tavern, speak, NPC A) but instead of Q→P the input does C→<any-key>
# to exercise reply_chitchat() → play_script("speak.chit_reply",
# {subj, job_sym}). The script switches on `subj` (ryl_random(0,2)
# under seed 42) and emit_indexed splices the slug into
# 'speak.chit.reply.<subj>.j{}', resolving to one of the
# speak.chit.reply.{well,weather,health}.jmerchant bodies. Without
# this fixture the chit_reply dispatcher's two-axis (subj, job_sym)
# emit_indexed has no byte-identity gate.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
