# Arrow-key path coverage for the ydarg navigation loop. Mirrors
# ydarg-confrontation's setup (same epoch + seed + party create + the
# whole confrontation script) but pipes ANSI ESC[A/B/C/D bytes for the
# four floor-traversal `66662222` blocks instead of the literal numpad
# digits. tty_getch's peek_byte_timed translates the CSI tail into the
# same digits ydarg.c::ydarg's main loop already consumes via
# wld_dir_from_key, so the resulting .expect / .expect_snapshot files
# come out byte-identical to ydarg-confrontation's. Sister fixture is
# the digit-bytes path; this one gates the ESC-bytes path through
# ydarg.c specifically (wilderness-arrow-keys gates the wilderness
# loop). Same pinned epoch + seed for that same byte-identity reason.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=42
RYL_NO_DELAY=1
RYL_FORCE_POS=14,30
RYL_FORCE_PARTY_LV=28
RYL_FORCE_PARTY_WP=dancing_sword
RYL_FORCE_PARTY_HP_FULL=1
RYL_FORCE_YDARG_GRANTS=1
RYL_FORCE_YDARG_EASY_ROOMS=1
