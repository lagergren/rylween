# §22.5 #2 combat-mage-frost: pin one mage Frost Finger cast end-to-end.
# Seed 2 places a wi=67 mage in slot 1 (the first to act each round) so
# the cast is the very first combat action; subsequent rounds the mage
# attacks normally to finish the wild_dog. RYL_FORCE_ENCOUNTER pins the
# foe so the spell render is captured against a known target.
RYL_FAKE_EPOCH=1700000000
RYL_FAKE_SEED=2
RYL_NO_DELAY=1
RYL_FORCE_ENCOUNTER=wild_dog
RYL_FORCE_ENCOUNTER_NOC=1
