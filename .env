# Settings for `docker compose` / `podman compose`, committed and excluded from
# the image build. Every setting is listed at the top of compose.yaml; variables
# exported in the shell take precedence, so export passwords such as
# RYLWEEN_AUTH_PASSWORD there rather than adding them here.
#
# `./deploy-rylween.sh --compose` publishes on this machine's LAN address, which
# it detects. Plain `docker compose up` publishes on 127.0.0.1 unless
# RYLWEEN_PUBLISH_HOST is set.
RYLWEEN_HOST_PORT=8081
