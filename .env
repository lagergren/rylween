# Machine-specific settings for `docker compose` / `podman compose` on this Mac.
# Committed, and excluded from the image build. Every setting is listed at the
# top of compose.yaml; variables exported in the shell take precedence, so
# export passwords such as RYLWEEN_AUTH_PASSWORD there rather than adding them here.

# This Mac's LAN address (en0), so others on the local network can connect.
# Update it if the router hands out a different address: ipconfig getifaddr en0
RYLWEEN_PUBLISH_HOST=192.168.88.244
RYLWEEN_HOST_PORT=8081
