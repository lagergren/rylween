// Magic items shard — ids 100–111. Each entry that has been migrated
// to §23.B carries an `effect:` body — an array of script DSL ops
// play_spell_body executes when the player triggers the item from
// battle.c's "I" branch. The shape mirrors spells/mage.json5's `do:`
// body — same op vocabulary (engine_call / emit / mutate /
// for_each_alive_monster / etc.) and the same script_combat_ctx is
// active during the body so `battle_flag` / `monster_hp` lvalues work.
//
// Inventory consume is body-owned: every effect: starts (or, for
// gem_of_resurrection, conditionally branches to) `pa_set_inventory
// inv_slot 0`. The dispatcher in battle.c binds `inv_slot` from
// inv_slot_from_letter(d); bodies decide when to consume so a
// conditional item like gem_of_resurrection can preserve the slot
// when the action fails.
{
  // §23.B Group B: frost_wand. Single-target damage on the lowest-
  // index alive monster. Damage = ryl_random(5, 11) + caster.lv. RNG
  // identity preserved — random first (matches the legacy gcc
  // evaluation order; pm_lv has no side effects so order doesn't
  // change RNG). Missing-\\r\\n bug from the legacy `tx("...KILLED!")`
  // (no newline) is fixed inline by routing through battle.killed,
  // matching every other kill site in the file.
  frost_wand: {
    id: 100, name: 'Frost Wand', cost: 1000,
    effect: [
      { engine_call: 'pa_set_inventory', args: [{ var: 'inv_slot' }, 0] },
      { engine_call: 'clw' },
      { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                       var: 'caster' }},
      { let: 'target', value: { engine_int: 'pick_first_alive_monster' }},
      { if: { cond: { gt: [{ var: 'target' }, 0] }, then: [
          { let: 'dmg', value: { add: [
              { random: [5, 11] },
              { member: { var: 'caster_idx' }, field: 'lv' },
          ]}},
          { emit: 'battle.item.frost_wand.chills' },
          { emit: 'battle.item.frost_wand.damage_pts' },
          { pause: 1000 },
          { mutate: { target: { monster_hp: { var: 'target' } },
                      op: 'sub', value: { var: 'dmg' } }},
          { if: { cond: { lte: [{ monster_hp: { var: 'target' } }, 0] },
            then: [
              { mutate: { target: { monster_hp: { var: 'target' } },
                          op: 'set', value: 0 }},
              { emit: 'battle.killed' },
              { pause: 600 },
              { mutate: { target: { monster_dead: { var: 'target' } },
                          op: 'set', value: 1 }},
          ]}},
      ]}},
    ],
  },
  // §23.B Group C: fire_wand AOE damage. RNG identity: dmg draws
  // ryl_random(3, 8) UNCONDITIONALLY per slot 1..noc — even on dead
  // slots, matching the legacy `for (i=1; i<=noc; i++) { spelldamage
  // = pm_lv * ryl_random(3, 8); if (!deadc[i]) ... }`. for_monster
  // (not for_each_alive_monster) preserves that bookkeeping. mul order
  // is lv * random — same as the legacy `pm_lv(...) * ryl_random(...)`.
  fire_wand: {
    id: 101, name: 'Fire Wand', cost: 3000,
    effect: [
      { engine_call: 'pa_set_inventory', args: [{ var: 'inv_slot' }, 0] },
      { engine_call: 'clw' },
      { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                       var: 'caster' }},
      { for_monster: { var: 'i', then: [
          { let: 'dmg', value: { mul: [
              { member: { var: 'caster_idx' }, field: 'lv' },
              { random: [3, 8] },
          ]}},
          { if: { cond: { eq: [{ monster_dead: { var: 'i' } }, 0] },
            then: [
              { engine_call: 'clw' },
              { emit: 'battle.item.fire_wand.burns' },
              { emit: 'battle.item.fire_wand.points' },
              { pause: 1000 },
              { mutate: { target: { monster_hp: { var: 'i' } },
                          op: 'sub', value: { var: 'dmg' } }},
              { if: { cond: { lte: [{ monster_hp: { var: 'i' } }, 0] },
                then: [
                  { mutate: { target: { monster_hp: { var: 'i' } },
                              op: 'set', value: 0 }},
                  { emit: 'battle.killed' },
                  { pause: 600 },
                  { mutate: { target: { monster_dead: { var: 'i' } },
                              op: 'set', value: 1 }},
              ]}},
          ]}},
      ]}},
    ],
  },
  // §23.B Group A: gem_of_confusion. RNG-free narration + ws/=2.
  // Trailing wait_input + clw mirrors the legacy ryl_pause; clw
  // tail before the combat loop redraws.
  gem_of_confusion: {
    id: 102, name: 'Gem of Confusion', cost: 1560,
    effect: [
      { engine_call: 'pa_set_inventory', args: [{ var: 'inv_slot' }, 0] },
      { engine_call: 'clw' },
      { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                       var: 'caster' }},
      { emit: 'battle.item.throws_the' },
      { emit: 'battle.item.sparks_bump' },
      { wait_input: true },
      { engine_call: 'clw' },
      { mutate: { target: { battle_flag: 'ws' }, op: 'div', value: 2 }},
    ],
  },
  // §23.B Group A: gem_of_blindness. Same shape as 102 — narration
  // + ws clamp. Legacy set ws = 5 (regardless of prior value).
  gem_of_blindness: {
    id: 103, name: 'Gem of Blindness', cost: 4900,
    effect: [
      { engine_call: 'pa_set_inventory', args: [{ var: 'inv_slot' }, 0] },
      { engine_call: 'clw' },
      { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                       var: 'caster' }},
      { emit: 'battle.item.throws_the' },
      { emit: 'battle.item.light_blind' },
      { wait_input: true },
      { engine_call: 'clw' },
      { mutate: { target: { battle_flag: 'ws' }, op: 'set', value: 5 }},
    ],
  },
  // §23.B Group B: drums_of_death. Single-target instakill on the
  // lowest-index alive monster. RNG-free. Legacy delays were 2000ms
  // before "...KILLED!" then 600ms before clw — preserved here.
  drums_of_death: {
    id: 104, name: 'Drums of Death', cost: 4500,
    effect: [
      { engine_call: 'pa_set_inventory', args: [{ var: 'inv_slot' }, 0] },
      { engine_call: 'clw' },
      { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                       var: 'caster' }},
      { let: 'target', value: { engine_int: 'pick_first_alive_monster' }},
      { if: { cond: { gt: [{ var: 'target' }, 0] }, then: [
          { emit: 'battle.item.drums_of_death.summons_death' },
          { pause: 2000 },
          { emit: 'battle.killed' },
          { pause: 600 },
          { mutate: { target: { monster_dead: { var: 'target' } },
                      op: 'set', value: 1 }},
          { mutate: { target: { monster_hp: { var: 'target' } },
                      op: 'set', value: 0 }},
          { engine_call: 'clw' },
      ]}},
    ],
  },
  // §23.B Group D: staff_of_healing. Prompts for a target digit
  // (1..party_member_max) and full-heals the chosen member. The
  // pm_full_heal helper itself no-ops on dead members — the legacy
  // narration "X is fully healed." prints regardless, preserved here
  // (peculiar UX but byte-for-byte the original behavior).
  staff_of_healing: {
    id: 105, name: 'Staff of Healing', cost: 670,
    effect: [
      { engine_call: 'pa_set_inventory', args: [{ var: 'inv_slot' }, 0] },
      { engine_call: 'clw' },
      { menu_branch: {
          prompt: 'battle.prompt.on_whom',
          options: [
            { digit_range: { lo: 1,
                             hi: { engine_int: 'pa_party_member_max' } },
              index_var: 'target',
              then: [
                { engine_call: 'pm_full_heal',
                  args: [{ var: 'target' }] },
                { engine_call: 'clw' },
                { engine_bind: { fn: 'pa_name',
                                 args: [{ var: 'target' }],
                                 var: 'target_name' }},
                { emit: 'battle.item.staff_of_healing.fully_healed' },
                { pause: 1000 },
                { engine_call: 'clw' },
              ],
            },
          ],
      }},
    ],
  },
  // §23.B Group E: blessing_scroll. Party-wide stat boost — every
  // member 1..party_member_max gets +3 to ws / h / ch / wi (max-HP
  // bumps but current hp untouched). Iterates ALL members regardless
  // of dead bit (legacy for-loop has no `if (!dead)` gate); for_member
  // matches that. RNG-free.
  blessing_scroll: {
    id: 106, name: 'Blessing Scroll', cost: 2000,
    effect: [
      { engine_call: 'pa_set_inventory', args: [{ var: 'inv_slot' }, 0] },
      { engine_call: 'clw' },
      { emit: 'battle.spell.morale_quest' },
      { wait_input: true },
      { engine_call: 'clw' },
      { for_member: { var: 'm', then: [
          { mutate: { target: { member_field: { idx: { var: 'm' },
                                                field: 'ws' } },
                      op: 'add', value: 3 }},
          { mutate: { target: { member_field: { idx: { var: 'm' },
                                                field: 'h' } },
                      op: 'add', value: 3 }},
          { mutate: { target: { member_field: { idx: { var: 'm' },
                                                field: 'ch' } },
                      op: 'add', value: 3 }},
          { mutate: { target: { member_field: { idx: { var: 'm' },
                                                field: 'wi' } },
                      op: 'add', value: 3 }},
      ]}},
    ],
  },
  // §23.B Group E: staff_of_curing. Party-wide full heal — pm_full_heal
  // on every member 1..party_member_max. The C helper itself no-ops
  // on dead members so for_member (full range) and for_each_alive_player
  // are observably equivalent here; for_member matches the legacy
  // for-loop bound exactly.
  staff_of_curing: {
    id: 107, name: 'Staff of Curing', cost: 4343,
    effect: [
      { engine_call: 'pa_set_inventory', args: [{ var: 'inv_slot' }, 0] },
      { engine_call: 'clw' },
      { emit: 'battle.spell.party_healed' },
      { wait_input: true },
      { engine_call: 'clw' },
      { for_member: { var: 'm', then: [
          { engine_call: 'pm_full_heal', args: [{ var: 'm' }] },
      ]}},
    ],
  },
  // §23.B Group D: gem_of_resurrection. Conditional consume — the
  // inventory slot is cleared only inside the success branch (target
  // was dead). On the not-dead branch, the body sets battle_flag
  // 'action_retry' to 1; battle.c's dispatcher checks it after the
  // body returns and `goto combat`s to re-prompt the action menu,
  // preserving the legacy "no turn spent on a typo" semantics.
  gem_of_resurrection: {
    id: 108, name: 'Gem of Resurrection', cost: 9000,
    effect: [
      { engine_call: 'clw' },
      { menu_branch: {
          prompt: 'battle.prompt.on_whom',
          options: [
            { digit_range: { lo: 1,
                             hi: { engine_int: 'pa_party_member_max' } },
              index_var: 'target',
              then: [
                { if: { cond: { eq: [{ member: { var: 'target' },
                                                field: 'dead' }, 1] },
                    then: [
                      { engine_call: 'clw' },
                      { engine_bind: { fn: 'pa_name',
                                       args: [{ var: 'target' }],
                                       var: 'target_name' }},
                      { engine_bind: { fn: 'pronoun',
                                       args: [{ var: 'target' },
                                              'possessive'],
                                       var: 'target_possessive' }},
                      { emit: 'battle.item.gem_of_resurrection.opens_eyes' },
                      { pause: 1000 },
                      { engine_call: 'pa_add_pl', args: [1] },
                      { engine_call: 'pm_set_dead',
                        args: [{ var: 'target' }, 0] },
                      { mutate: { target: { member_field: {
                                              idx: { var: 'target' },
                                              field: 'hp' } },
                                  op: 'set', value: 1 }},
                      { engine_call: 'pa_set_inventory',
                        args: [{ var: 'inv_slot' }, 0] },
                    ],
                    else: [
                      { engine_call: 'clw' },
                      { engine_bind: { fn: 'pa_name',
                                       args: [{ var: 'target' }],
                                       var: 'target_name' }},
                      { emit: 'battle.item.gem_of_resurrection.not_dead' },
                      { pause: 1000 },
                      { mutate: { target: { battle_flag: 'action_retry' },
                                  op: 'set', value: 1 }},
                    ],
                }},
              ],
            },
          ],
      }},
    ],
  },
  // §23.B Group C: kaels_axe AOE. Sets every alive monster's HP to
  // ryl_random(1, 3) — leaves them near-dead, doesn't kill outright.
  // RNG draws ONLY for alive slots (legacy gates `if (!deadc[i])`
  // around the random call); for_each_alive_monster has the same
  // semantics. No kill-check; monsters with hp=1..3 survive but are
  // mortally wounded for the next attack round.
  kaels_axe: {
    id: 109, name: "Kael's Axe", cost: 14000,
    effect: [
      { engine_call: 'pa_set_inventory', args: [{ var: 'inv_slot' }, 0] },
      { engine_call: 'clw' },
      { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                       var: 'caster' }},
      { emit: 'battle.item.kaels_axe.thrown' },
      { pause: 1500 },
      { emit: 'battle.item.ghost_axe.wounds' },
      { pause: 4000 },
      { engine_call: 'clw' },
      { emit: 'battle.item.battle_cry' },
      { pause: 3000 },
      { for_each_alive_monster: { then: [
          { mutate: { target: { monster_hp: { var: 'monster_idx' } },
                      op: 'set', value: { random: [1, 3] } }},
      ]}},
    ],
  },
  // §23.B Group C: holy_handgrenade AOE. Sets every alive monster's
  // HP to (hp/4) + 1 — RNG-free. The /4 then ++ ordering matters
  // (integer truncation followed by +1), expressed as two mutates.
  holy_handgrenade: {
    id: 110, name: 'Holy Handgrenade', cost: 5600,
    effect: [
      { engine_call: 'pa_set_inventory', args: [{ var: 'inv_slot' }, 0] },
      { engine_call: 'clw' },
      { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                       var: 'caster' }},
      { emit: 'battle.item.holy_handgrenade.lobbed' },
      { pause: 3000 },
      { emit: 'battle.item.holy_handgrenade.ka_blam' },
      { pause: 1500 },
      { engine_call: 'clw' },
      { for_each_alive_monster: { then: [
          { mutate: { target: { monster_hp: { var: 'monster_idx' } },
                      op: 'div', value: 4 }},
          { mutate: { target: { monster_hp: { var: 'monster_idx' } },
                      op: 'add', value: 1 }},
      ]}},
    ],
  },
  // §23.B Group A: flute_of_madness. Pure narration — no state
  // mutation, no RNG. Legacy emitted six tx() calls, the last with
  // a doubled `\r\n\r\n` tail; `flute_of_madness.played` carries
  // the trailing '' to reproduce the blank line.
  flute_of_madness: {
    id: 111, name: 'Flute of Madness', cost: 9000,
    effect: [
      { engine_call: 'pa_set_inventory', args: [{ var: 'inv_slot' }, 0] },
      { engine_call: 'clw' },
      { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                       var: 'caster' }},
      { emit: 'battle.item.flute_of_madness.played' },
      { wait_input: true },
      { engine_call: 'clw' },
    ],
  },
}
