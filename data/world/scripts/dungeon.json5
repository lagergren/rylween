// §20 L2: dungeon level-event scripts. dungeon.c's main while-loop
// dispatches by lvl[cl] — the integer encounter id stored in lvl[].
// For each migrated case, the C arm is replaced by a single
// play_script("dungeon.<symbol>") call; the symbol matches the
// world.json5 enums.dungeon_encounter table. Unmigrated cases stay
// in the C switch.
//
// Texts paired here live under data/world/texts/dungeon.json5; the
// resolve_text_id "<script_id>.<name>" → "<parent>.<name>" two-step
// (project_text_resolution.md) means scripts can reference text
// names directly.
//
// Byte-identity convention: the C side calls clw() at the top of
// every main-loop iteration before dispatch. Cases that had an extra
// clw() in the body need an explicit { engine_call: 'clw' } here so
// the output stream stays exactly equivalent.
{
  // case 6: "You find nothing special on this level."
  // C side still does `lvl[cl] = 0` after play_script returns; the
  // script owns only the visible side effects. No clw in the original
  // body (the loop's leading clw is enough), so none here either.
  nothing_a: [
    { emit: 'nothing_a' },
    { wait_input: true },
  ],

  // case 7: "This level is empty."
  nothing_b: [
    { emit: 'nothing_b' },
    { wait_input: true },
  ],

  // case 26: Spectrum-Message wall plaque (Reebar's Tomb, level 12).
  // Original body opens with an explicit clw(); preserve it so the
  // byte stream is unchanged.
  spectrum_message: [
    { engine_call: 'clw' },
    { emit: 'spectrum_message' },
    { wait_input: true },
  ],

  // case 21: Fire Shield pedestal (Hermit's troll-tooth quest).
  // Original closes with a second clw() before awarding. The
  // reward op recognises 'fireshield' as a special and routes to
  // party_award_special instead of inv_add (no output for specials).
  fire_shield: [
    { engine_call: 'clw' },
    { emit: 'fire_shield' },
    { wait_input: true },
    { engine_call: 'clw' },
    { reward: { items: ['fireshield'] } },
    { set_flag: 'hermit.troll_tooth', value: 'fire_shield_acquired' },
  ],

  // case 25: Bracelets of Thun chamber (Temple of Thun, bottom).
  // Same shape as fire_shield: text → pause → clw → award special →
  // record flag.
  bracelets: [
    { engine_call: 'clw' },
    { emit: 'bracelets' },
    { wait_input: true },
    { engine_call: 'clw' },
    { reward: { items: ['bracelets'] } },
    { set_flag: 'bracelets.thun', value: 'bracelets_taken' },
  ],

  // case 28: Nolrim's tomb dagger (Reebar dungeon, level 20). Plain
  // text + flag set; no reward (the dagger isn't an inventory item,
  // only the flag tracks it).
  nolrim_tomb: [
    { engine_call: 'clw' },
    { emit: 'nolrim_tomb' },
    { wait_input: true },
    { set_flag: 'mastercrown', value: 'dagger_taken' },
  ],
}
