// §17-F town-service scripts. C wrappers in src/towne.c handle the
// static entry scene (blitgfx / entry text / initial delay) and
// dispatch into the interactive loop here via play_script, passing
// per-flow runtime bindings (NPC idx, NPC job, etc.).
//
// Text placeholders ({job}, {name}, ...) are populated two ways:
//   1. Caller ryl_bind — from C. Passed through as-is; atoi-parseable
//      ints can also be read via {var:'name'} in expressions.
//   2. engine_bind op — resolves a string from the res layer
//      (res_enum, res_town_name, object, pronoun) and stashes it
//      in rt_env so {placeholder} expansion picks it up. Only
//      valid as text; expr_var fails on RT_STR.
{
  // hut() — §17-F smoke test. Caller pre-resolves which NPC occupies
  // the party's map square (`vem`, 1..39) and that NPC's job id
  // (`npc_job`). We pull the NPC name + job name via res_enum each
  // iteration, emit the greeter screen, offer a (T)alk / (L)eave menu.
  hut: [
    { loop: [
      { engine_call: 'clw' },
      { engine_bind: { fn: 'res_enum', args: ['jobname', { var: 'npc_job' }], var: 'job' } },
      { engine_bind: { fn: 'res_enum', args: ['name',    { var: 'vem' }],     var: 'name' } },
      { emit: 'greeter' },
      { menu_branch: {
          prompt: 'menu',
          options: [
            { key: 'T', then: [
              { engine_call: 'speak', args: [0, 0] },
            ] },
            { key: 'L', then: [
              { engine_call: 'clw' },
              { engine_call: 'clr_map_window' },
              { engine_call: 'update_map' },
              { break: true },
            ] },
          ],
      } },
    ] },
  ],

  // church() — service menu inside a town. C wrapper is a pure
  // play_script call; this script owns clr_map_window + blitgfx
  // (churchpic=4), the main H/R/E/L loop, and the sub-menu "Who?
  // (1-4)" for each action. Break paths: L leaves cleanly (clw +
  // clr_map_window); H-on-corpse exits abruptly (clw + corpse +
  // 1200ms, no clr_map_window — matches the original's `return;`).
  //
  // key_range: ['1', '4'] is a literal char range; the DSL does not
  // yet let us write "1..res_party_member_max()" symbolically (see
  // script.c menu_opt_matches comment). PARTY_MEMBER_MAX is pinned
  // at 4 by the save format, so the hardcode is safe today — if
  // the cap ever changes, lift this with the match-shape work
  // described there.
  church: [
    { engine_call: 'clr_map_window' },
    { engine_call: 'blitgfx', args: [4] },
    { loop: [
      { engine_call: 'clw' },
      { engine_call: 'statusline' },
      { emit: 'intro' },
      { menu_branch: {
          prompt: 'menu',
          options: [
            { key: 'L', then: [
              { engine_call: 'clw' },
              { engine_call: 'clr_map_window' },
              { break: true },
            ] },
            // --- (E)nergize: restore spellcaster's ma to wi for a fee.
            { key: 'E', then: [
              { engine_call: 'clw' },
              { emit: 'who' },
              { menu_branch: {
                  key_var: 'who_ch',
                  options: [
                    { key_range: ['1', '4'], then: [
                      { let: 'who', value: { sub: [{ var: 'who_ch' }, 48] } },
                      { if: {
                          cond: { not: { engine_int: 'pa_is_spellcaster', args: [{ var: 'who' }] } },
                          then: [
                            { engine_call: 'clw' },
                            { emit: 'not_spellcaster' },
                            { pause: 1000 },
                          ],
                          else: [
                            { if: {
                                cond: { eq: [
                                  { member: { var: 'who' }, field: 'ma' },
                                  { member: { var: 'who' }, field: 'wi' },
                                ] },
                                then: [
                                  { engine_call: 'clw' },
                                  { emit: 'no_need_sp' },
                                  { pause: 2000 },
                                ],
                                else: [
                                  { engine_call: 'clw' },
                                  // cost = lv * (wi - ma) * 2. The original's
                                  // "if (!cost) cost = lv*2" fallback is
                                  // unreachable when wi > ma and lv >= 1
                                  // (always the case past createparty).
                                  { let: 'cost', value: {
                                      mul: [
                                        { member: { var: 'who' }, field: 'lv' },
                                        { mul: [
                                          { sub: [
                                            { member: { var: 'who' }, field: 'wi' },
                                            { member: { var: 'who' }, field: 'ma' },
                                          ] },
                                          2,
                                        ] },
                                      ],
                                  } },
                                  { emit: 'cost2' },
                                  { menu_branch: {
                                      prompt: 'pn_menu',
                                      options: [
                                        { key: 'P', then: [
                                          { engine_call: 'clw' },
                                          { if: {
                                              cond: { lt: [{ gold: 0 }, { var: 'cost' }] },
                                              then: [
                                                { emit: 'no_gold' },
                                                { pause: 1000 },
                                              ],
                                              else: [
                                                { mutate: { target: { gold: 0 }, op: 'sub', value: { var: 'cost' } } },
                                                { mutate: { target: { member_field: { idx: { var: 'who' }, field: 'ma' } },
                                                            op: 'set',
                                                            value: { member: { var: 'who' }, field: 'wi' } } },
                                                { engine_call: 'clw' },
                                                { emit: 'restored' },
                                                { pause: 1000 },
                                              ],
                                          } },
                                        ] },
                                      ],
                                  } },
                                ],
                            } },
                          ],
                      } },
                    ] },
                  ],
              } },
            ] },
            // --- (R)aise dead: cost = 650 * lv[who]. On pay, hp=1,
            //     dead=0, pl++. Alive target just emits alive + 1200ms.
            { key: 'R', then: [
              { engine_call: 'clw' },
              { emit: 'who' },
              { menu_branch: {
                  key_var: 'who_ch',
                  options: [
                    { key_range: ['1', '4'], then: [
                      { let: 'who', value: { sub: [{ var: 'who_ch' }, 48] } },
                      { if: {
                          cond: { engine_int: 'pa_is_alive', args: [{ var: 'who' }] },
                          then: [
                            { engine_call: 'clw' },
                            { engine_bind: { fn: 'pronoun', args: [{ var: 'who' }, 1], var: 'pro_sub' } },
                            { emit: 'alive' },
                            { pause: 1200 },
                          ],
                          else: [
                            { engine_call: 'clw' },
                            { let: 'cost', value: { mul: [650, { member: { var: 'who' }, field: 'lv' }] } },
                            { emit: 'cost2' },
                            { menu_branch: {
                                prompt: 'pn_menu',
                                options: [
                                  { key: 'P', then: [
                                    { engine_call: 'clw' },
                                    { if: {
                                        cond: { lt: [{ gold: 0 }, { var: 'cost' }] },
                                        then: [
                                          { emit: 'no_gold' },
                                          { pause: 1000 },
                                        ],
                                        else: [
                                          { mutate: { target: { gold: 0 }, op: 'sub', value: { var: 'cost' } } },
                                          { mutate: { target: { member_field: { idx: { var: 'who' }, field: 'hp' } }, op: 'set', value: 1 } },
                                          { mutate: { target: { member_field: { idx: { var: 'who' }, field: 'dead' } }, op: 'set', value: 0 } },
                                          { mutate: { target: { pl: 0 }, op: 'add', value: 1 } },
                                          { engine_call: 'clw' },
                                          { engine_bind: { fn: 'pronoun', args: [{ var: 'who' }, 2], var: 'pro_obj' } },
                                          { emit: 'raised' },
                                          { pause: 1000 },
                                        ],
                                    } },
                                  ] },
                                ],
                            } },
                          ],
                      } },
                    ] },
                  ],
              } },
            ] },
            // --- (H)eal: cost = (h - hp) * 7. On dead target: show
            //     corpse + 1200ms and BREAK out of church (original
            //     used `return;`). Uses cost/no_gold2 text variants.
            { key: 'H', then: [
              { engine_call: 'clw' },
              { emit: 'who' },
              { menu_branch: {
                  key_var: 'who_ch',
                  options: [
                    { key_range: ['1', '4'], then: [
                      { let: 'who', value: { sub: [{ var: 'who_ch' }, 48] } },
                      { if: {
                          cond: { engine_int: 'pa_is_dead', args: [{ var: 'who' }] },
                          then: [
                            { engine_call: 'clw' },
                            { emit: 'corpse' },
                            { pause: 1200 },
                            { break: true },
                          ],
                      } },
                      { if: {
                          cond: { eq: [
                            { member: { var: 'who' }, field: 'hp' },
                            { member: { var: 'who' }, field: 'h' },
                          ] },
                          then: [
                            { engine_call: 'clw' },
                            { engine_bind: { fn: 'pronoun', args: [{ var: 'who' }, 1], var: 'pro_sub' } },
                            { emit: 'no_healing' },
                            { pause: 1000 },
                          ],
                          else: [
                            { let: 'cost', value: { mul: [
                                { sub: [
                                  { member: { var: 'who' }, field: 'h' },
                                  { member: { var: 'who' }, field: 'hp' },
                                ] },
                                7,
                            ] } },
                            { engine_call: 'clw' },
                            { emit: 'cost' },
                            { menu_branch: {
                                prompt: 'pn_menu',
                                options: [
                                  { key: 'P', then: [
                                    // NB: no clw here — the original's heal
                                    // pay branch omits the clw that energize/
                                    // raise use, so no_gold2 stacks on top of
                                    // the pn_menu text.
                                    { if: {
                                        cond: { lt: [{ gold: 0 }, { var: 'cost' }] },
                                        then: [
                                          { emit: 'no_gold2' },
                                          { pause: 1000 },
                                        ],
                                        else: [
                                          { engine_call: 'clw' },
                                          { mutate: { target: { gold: 0 }, op: 'sub', value: { var: 'cost' } } },
                                          { engine_bind: { fn: 'pronoun', args: [{ var: 'who' }, 2], var: 'pro_obj' } },
                                          { emit: 'healed' },
                                          { pause: 1000 },
                                          { mutate: { target: { member_field: { idx: { var: 'who' }, field: 'hp' } },
                                                      op: 'set',
                                                      value: { member: { var: 'who' }, field: 'h' } } },
                                        ],
                                    } },
                                  ] },
                                ],
                            } },
                          ],
                      } },
                    ] },
                  ],
              } },
            ] },
          ],
      } },
    ] },
  ],

  // smith() — weapon / armour shop. C wrapper advances state.tid and
  // resolves opening hours from world.json5's buildings.smith
  // (opens_at / closes_at), passing them in as `open_lo` / `open_hi`
  // bindings so the closed-screen check lives here and not in C.
  //
  // When open: clr_map_window + blitgfx(3) then the shop loop.
  //   * ryl_chance(9) into beer_offer: A -> three accept_N screens +
  //     rumour + ryl_pause; anything else -> decline + ryl_pause.
  //   * Otherwise: B/S/L menu.
  //       L — bye + clr_map_window + break.
  //       B — A/W/N buy menu.
  //           A — armour (ids 20..25, keys 1..6). oc = ch - 29 maps
  //               '1'=49 -> 20, '6'=54 -> 25.
  //           W — weapon pagination loop. N/P flip the page; any
  //               other key exits. key_var holds the last keypress,
  //               a switch maps it onto weapon ids 1 / 2 / 3 / 4 / 9
  //               / 11 / 7 / 14 / 10 / 8 / 15 / 16; default is oc=0
  //               (no purchase). The original's "inv_add(0) fills a
  //               slot with zero and prints Deal!" bug is fixed by
  //               that oc=0 gate — a pre-existing divergence between
  //               the armour and weapon paths that replay fixtures
  //               don't exercise today.
  //       S — sell any item in slots 1..16 (keys A..P). Filters
  //           `oc == 0 || oc > 30` (non-weapon/armour items) and
  //           falls into the bargain loop: Y sells at pr, B rolls
  //           0..99 with the 76/90 thresholds, N walks. Any other
  //           key re-prompts with the same pr.
  //
  // References `common.yes` / `common.no` as absolute text ids
  // (resolve_text_id treats dotted names as absolute). Uses emit,
  // not screen, so the three tx0 lines emit separately and each
  // carries its own cursor-right prefix — matches the four tx0
  // calls the C code makes per bargain iteration.
  smith: [
    { if: {
        cond: { or: [
          { lt: [{ tid: 0 }, { var: 'open_lo' }] },
          { gt: [{ tid: 0 }, { var: 'open_hi' }] },
        ] },
        then: [
          { engine_call: 'clw' },
          { emit: 'closed' },
          { pause: 1000 },
        ],
        else: [
          { engine_call: 'clr_map_window' },
          { engine_call: 'blitgfx', args: [3] },
          { loop: [
            { engine_call: 'clw' },
            { engine_call: 'statusline' },
            { emit: 'intro' },
            { chance: {
                pct: 9,
                then: [
                  { emit: 'beer_offer' },
                  { menu_branch: {
                      prompt: 'beer_menu',
                      options: [
                        { key: 'A', then: [
                            { engine_call: 'clw' },
                            { emit: 'accept_1' },
                            { pause: 2000 },
                            { emit: 'accept_2' },
                            { pause: 2000 },
                            { emit: 'accept_3' },
                            { pause: 2000 },
                            { engine_call: 'clw' },
                            { engine_call: 'rumour' },
                            { wait_input: true },
                        ] },
                      ],
                      // ryl_menu's (A)ccept/(D)ecline sentinel
                      // defaults to D — anything not 'A' takes the
                      // decline path. Folded into the default arm.
                      default: [
                        { engine_call: 'clw' },
                        { emit: 'decline' },
                        { wait_input: true },
                      ],
                  } },
                ],
                else: [
                  { menu_branch: {
                      prompt: 'shop_menu',
                      options: [
                        { key: 'L', then: [
                            { engine_call: 'clw' },
                            { emit: 'bye' },
                            { pause: 1000 },
                            { engine_call: 'clr_map_window' },
                            { break: true },
                        ] },
                        { key: 'B', then: [
                            { engine_call: 'clw' },
                            { menu_branch: {
                                prompt: 'buy_menu',
                                options: [
                                  // --- Armour buy
                                  { key: 'A', then: [
                                      { let: 'p20', value: { obcost: 20 } },
                                      { let: 'p21', value: { obcost: 21 } },
                                      { let: 'p22', value: { obcost: 22 } },
                                      { let: 'p23', value: { obcost: 23 } },
                                      { let: 'p24', value: { obcost: 24 } },
                                      { let: 'p25', value: { obcost: 25 } },
                                      { engine_call: 'clw' },
                                      { emit: 'we_have' },
                                      { emit: 'armour_menu' },
                                      { menu_branch: {
                                          key_var: 'armour_ch',
                                          options: [
                                            { key_range: ['1', '6'], then: [
                                              // oc = ch - 29 maps '1' (ASCII 49) -> 20 ... '6' (54) -> 25.
                                              { let: 'oc', value: { sub: [{ var: 'armour_ch' }, 29] } },
                                              { let: 'pr', value: { obcost: { var: 'oc' } } },
                                              { if: {
                                                  cond: { lt: [{ gold: 0 }, { var: 'pr' }] },
                                                  then: [
                                                    { engine_call: 'clw' },
                                                    { emit: 'too_expensive' },
                                                    { pause: 1000 },
                                                  ],
                                                  else: [
                                                    { engine_call: 'clw' },
                                                    { let: 'slot', value: { engine_int: 'inv_find_empty', args: [] } },
                                                    { if: {
                                                        cond: { eq: [{ var: 'slot' }, 0] },
                                                        then: [
                                                          { emit: 'cant_carry' },
                                                          { pause: 1000 },
                                                        ],
                                                        else: [
                                                          { mutate: { target: { inventory: { var: 'slot' } },
                                                                      op: 'set',
                                                                      value: { var: 'oc' } } },
                                                          { mutate: { target: { gold: 0 },
                                                                      op: 'sub',
                                                                      value: { var: 'pr' } } },
                                                          { emit: 'deal' },
                                                          { pause: 1000 },
                                                        ],
                                                    } },
                                                  ],
                                              } },
                                            ] },
                                          ],
                                      } },
                                  ] },
                                  // --- Weapon buy with N/P pagination
                                  { key: 'W', then: [
                                      { let: 'p1',  value: { obcost: 1 } },
                                      { let: 'p2',  value: { obcost: 2 } },
                                      { let: 'p3',  value: { obcost: 3 } },
                                      { let: 'p4',  value: { obcost: 4 } },
                                      { let: 'p9',  value: { obcost: 9 } },
                                      { let: 'p11', value: { obcost: 11 } },
                                      { let: 'p7',  value: { obcost: 7 } },
                                      { let: 'p14', value: { obcost: 14 } },
                                      { let: 'p10', value: { obcost: 10 } },
                                      { let: 'p8',  value: { obcost: 8 } },
                                      { let: 'p15', value: { obcost: 15 } },
                                      { let: 'p16', value: { obcost: 16 } },
                                      { let: 'menu', value: 1 },
                                      { loop: [
                                        { engine_call: 'clw' },
                                        { emit: 'we_have' },
                                        { if: { cond: { eq: [{ var: 'menu' }, 1] },
                                                then: [{ emit: 'weapon_page1' }] } },
                                        { if: { cond: { eq: [{ var: 'menu' }, 2] },
                                                then: [{ emit: 'weapon_page2' }] } },
                                        { menu_branch: {
                                            key_var: 'weapon_ch',
                                            options: [
                                              { key: 'N', then: [
                                                  { if: { cond: { eq: [{ var: 'menu' }, 1] },
                                                          then: [{ let: 'menu', value: 2 }] } },
                                              ] },
                                              { key: 'P', then: [
                                                  { if: { cond: { eq: [{ var: 'menu' }, 2] },
                                                          then: [{ let: 'menu', value: 1 }] } },
                                              ] },
                                            ],
                                            // key_var fires on default
                                            // too (see do_menu_branch),
                                            // so `weapon_ch` is always
                                            // the last key pressed.
                                            default: [{ break: true }],
                                        } },
                                      ] },
                                      // ASCII-coded switch: '1'=49
                                      // '9'=57, 'A'=65 'C'=67.
                                      { switch: {
                                          expr: { var: 'weapon_ch' },
                                          cases: [
                                            { match: 49, then: [{ let: 'oc', value: 1 }] },
                                            { match: 50, then: [{ let: 'oc', value: 2 }] },
                                            { match: 51, then: [{ let: 'oc', value: 3 }] },
                                            { match: 52, then: [{ let: 'oc', value: 4 }] },
                                            { match: 53, then: [{ let: 'oc', value: 9 }] },
                                            { match: 54, then: [{ let: 'oc', value: 11 }] },
                                            { match: 55, then: [{ let: 'oc', value: 7 }] },
                                            { match: 56, then: [{ let: 'oc', value: 14 }] },
                                            { match: 57, then: [{ let: 'oc', value: 10 }] },
                                            { match: 65, then: [{ let: 'oc', value: 8 }] },
                                            { match: 66, then: [{ let: 'oc', value: 15 }] },
                                            { match: 67, then: [{ let: 'oc', value: 16 }] },
                                            { default: true, then: [{ let: 'oc', value: 0 }] },
                                          ],
                                      } },
                                      { if: {
                                          cond: { gt: [{ var: 'oc' }, 0] },
                                          then: [
                                            { let: 'pr', value: { obcost: { var: 'oc' } } },
                                            { if: {
                                                cond: { lt: [{ gold: 0 }, { var: 'pr' }] },
                                                then: [
                                                  { engine_call: 'clw' },
                                                  { emit: 'too_expensive' },
                                                  { pause: 1000 },
                                                ],
                                                else: [
                                                  { engine_call: 'clw' },
                                                  { let: 'slot', value: { engine_int: 'inv_find_empty', args: [] } },
                                                  { if: {
                                                      cond: { eq: [{ var: 'slot' }, 0] },
                                                      then: [
                                                        { emit: 'cant_carry' },
                                                        { pause: 1000 },
                                                      ],
                                                      else: [
                                                        { mutate: { target: { inventory: { var: 'slot' } },
                                                                    op: 'set',
                                                                    value: { var: 'oc' } } },
                                                        { mutate: { target: { gold: 0 },
                                                                    op: 'sub',
                                                                    value: { var: 'pr' } } },
                                                        { emit: 'deal' },
                                                        { pause: 1000 },
                                                      ],
                                                  } },
                                                ],
                                            } },
                                          ],
                                      } },
                                  ] },
                                  // N or any other key: fall through
                                  // (back to outer shop loop), no
                                  // purchase.
                                ],
                            } },
                        ] },
                        { key: 'S', then: [
                            { engine_call: 'clw' },
                            { emit: 'sell_prompt' },
                            { engine_call: 'invlist' },
                            { menu_branch: {
                                key_var: 'sell_ch',
                                options: [
                                  { key_range: ['A', 'P'], then: [
                                    { let: 'slot', value: { sub: [{ var: 'sell_ch' }, 64] } },
                                    { let: 'oc', value: { inventory: { var: 'slot' } } },
                                    { let: 'pr', value: { div: [{ obcost: { var: 'oc' } }, 2] } },
                                    { if: {
                                        cond: { or: [
                                          { eq: [{ var: 'oc' }, 0] },
                                          { gt: [{ var: 'oc' }, 30] },
                                        ] },
                                        then: [
                                          { engine_call: 'clw' },
                                          { emit: 'not_w_or_a' },
                                          { pause: 1000 },
                                        ],
                                        else: [
                                          { loop: [
                                            { engine_call: 'clw' },
                                            { emit: 'offer' },
                                            { emit: 'common.yes' },
                                            { emit: 'common.no' },
                                            { emit: 'bargain_opt' },
                                            { menu_branch: {
                                                options: [
                                                  { key: 'Y', then: [
                                                      { mutate: { target: { inventory: { var: 'slot' } },
                                                                  op: 'set',
                                                                  value: 0 } },
                                                      { mutate: { target: { gold: 0 },
                                                                  op: 'add',
                                                                  value: { var: 'pr' } } },
                                                      { break: true },
                                                  ] },
                                                  { key: 'B', then: [
                                                      { let: 'i', value: { random: [0, 99] } },
                                                      { if: {
                                                          cond: { gt: [{ var: 'i' }, 90] },
                                                          then: [
                                                            { let: 'pr', value: {
                                                                add: [
                                                                  { var: 'pr' },
                                                                  { div: [{ var: 'pr' }, 4] },
                                                                ],
                                                            } },
                                                          ],
                                                      } },
                                                      { if: {
                                                          cond: { gt: [{ var: 'i' }, 75] },
                                                          then: [
                                                            { let: 'pr', value: {
                                                                add: [
                                                                  { var: 'pr' },
                                                                  { div: [{ var: 'pr' }, 6] },
                                                                ],
                                                            } },
                                                          ],
                                                      } },
                                                      { if: {
                                                          cond: { lt: [{ var: 'i' }, 76] },
                                                          then: [
                                                            { engine_call: 'clw' },
                                                            { emit: 'no_thanks' },
                                                            { pause: 1000 },
                                                            { break: true },
                                                          ],
                                                      } },
                                                  ] },
                                                  { key: 'N', then: [{ break: true }] },
                                                  // Any other key:
                                                  // re-prompt with
                                                  // the same pr
                                                  // (matches the
                                                  // original's
                                                  // while(1) fall-
                                                  // through).
                                                ],
                                            } },
                                          ] },
                                        ],
                                    } },
                                  ] },
                                ],
                            } },
                        ] },
                      ],
                  } },
                ],
            } },
          ] },
        ],
    } },
  ],
}
