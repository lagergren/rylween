// §17-F town-service scripts. C wrappers in src/towne.c handle the
// static entry scene (blitgfx / entry text / initial delay) and
// dispatch into the interactive loop here via play_script, passing
// per-flow runtime bindings (NPC idx, NPC job, etc.).
//
// Text placeholders ({job}, {name}, ...) are populated two ways:
//   1. Caller ryl_bind — from C. Passed through as-is; atoi-parseable
//      ints can also be read via {var:'name'} in expressions.
//   2. engine_bind op — resolves a string from the res layer
//      (res_enum, res_town_name, object, pronoun) and stashes it
//      in rt_env so {placeholder} expansion picks it up. Only
//      valid as text; expr_var fails on RT_STR.
{
  // hut() — §17-F smoke test. Caller pre-resolves which NPC occupies
  // the party's map square (`vem`, 1..39) and that NPC's job id
  // (`npc_job`). We pull the NPC name + job name via res_enum each
  // iteration, emit the greeter screen, offer a (T)alk / (L)eave menu.
  hut: [
    { loop: [
      { engine_call: 'clw' },
      { engine_bind: { fn: 'res_enum', args: ['jobname', { var: 'npc_job' }], var: 'job' } },
      { engine_bind: { fn: 'res_enum', args: ['name',    { var: 'vem' }],     var: 'name' } },
      { emit: 'greeter' },
      { menu_branch: {
          prompt: 'menu',
          options: [
            { key: 'T', then: [
              { engine_call: 'speak', args: [0, 0] },
            ] },
            { key: 'L', then: [
              { engine_call: 'clw' },
              { engine_call: 'clr_map_window' },
              { engine_call: 'update_map' },
              { break: true },
            ] },
          ],
      } },
    ] },
  ],

  // church() — service menu inside a town. C wrapper is a pure
  // play_script call; this script owns clr_map_window + blitgfx
  // (churchpic=4), the main H/R/E/L loop, and the sub-menu "Who?
  // (1-4)" for each action. Break paths: L leaves cleanly (clw +
  // clr_map_window); H-on-corpse exits abruptly (clw + corpse +
  // 1200ms, no clr_map_window — matches the original's `return;`).
  //
  // key_range: ['1', '4'] is a literal char range; the DSL does not
  // yet let us write "1..res_party_member_max()" symbolically (see
  // script.c menu_opt_matches comment). PARTY_MEMBER_MAX is pinned
  // at 4 by the save format, so the hardcode is safe today — if
  // the cap ever changes, lift this with the match-shape work
  // described there.
  church: [
    { engine_call: 'clr_map_window' },
    { engine_call: 'blitgfx', args: [4] },
    { loop: [
      { engine_call: 'clw' },
      { engine_call: 'statusline' },
      { emit: 'intro' },
      { menu_branch: {
          prompt: 'menu',
          options: [
            { key: 'L', then: [
              { engine_call: 'clw' },
              { engine_call: 'clr_map_window' },
              { break: true },
            ] },
            // --- (E)nergize: restore spellcaster's ma to wi for a fee.
            { key: 'E', then: [
              { engine_call: 'clw' },
              { emit: 'who' },
              { menu_branch: {
                  key_var: 'who_ch',
                  options: [
                    { key_range: ['1', '4'], then: [
                      { let: 'who', value: { sub: [{ var: 'who_ch' }, 48] } },
                      { if: {
                          cond: { not: { engine_int: 'pa_is_spellcaster', args: [{ var: 'who' }] } },
                          then: [
                            { engine_call: 'clw' },
                            { emit: 'not_spellcaster' },
                            { pause: 1000 },
                          ],
                          else: [
                            { if: {
                                cond: { eq: [
                                  { member: { var: 'who' }, field: 'ma' },
                                  { member: { var: 'who' }, field: 'wi' },
                                ] },
                                then: [
                                  { engine_call: 'clw' },
                                  { emit: 'no_need_sp' },
                                  { pause: 2000 },
                                ],
                                else: [
                                  { engine_call: 'clw' },
                                  // cost = lv * (wi - ma) * 2. The original's
                                  // "if (!cost) cost = lv*2" fallback is
                                  // unreachable when wi > ma and lv >= 1
                                  // (always the case past createparty).
                                  { let: 'cost', value: {
                                      mul: [
                                        { member: { var: 'who' }, field: 'lv' },
                                        { mul: [
                                          { sub: [
                                            { member: { var: 'who' }, field: 'wi' },
                                            { member: { var: 'who' }, field: 'ma' },
                                          ] },
                                          2,
                                        ] },
                                      ],
                                  } },
                                  { emit: 'cost2' },
                                  { menu_branch: {
                                      prompt: 'pn_menu',
                                      options: [
                                        { key: 'P', then: [
                                          { engine_call: 'clw' },
                                          { if: {
                                              cond: { lt: [{ gold: 0 }, { var: 'cost' }] },
                                              then: [
                                                { emit: 'no_gold' },
                                                { pause: 1000 },
                                              ],
                                              else: [
                                                { mutate: { target: { gold: 0 }, op: 'sub', value: { var: 'cost' } } },
                                                { mutate: { target: { member_field: { idx: { var: 'who' }, field: 'ma' } },
                                                            op: 'set',
                                                            value: { member: { var: 'who' }, field: 'wi' } } },
                                                { engine_call: 'clw' },
                                                { emit: 'restored' },
                                                { pause: 1000 },
                                              ],
                                          } },
                                        ] },
                                      ],
                                  } },
                                ],
                            } },
                          ],
                      } },
                    ] },
                  ],
              } },
            ] },
            // --- (R)aise dead: cost = 650 * lv[who]. On pay, hp=1,
            //     dead=0, pl++. Alive target just emits alive + 1200ms.
            { key: 'R', then: [
              { engine_call: 'clw' },
              { emit: 'who' },
              { menu_branch: {
                  key_var: 'who_ch',
                  options: [
                    { key_range: ['1', '4'], then: [
                      { let: 'who', value: { sub: [{ var: 'who_ch' }, 48] } },
                      { if: {
                          cond: { engine_int: 'pa_is_alive', args: [{ var: 'who' }] },
                          then: [
                            { engine_call: 'clw' },
                            { engine_bind: { fn: 'pronoun', args: [{ var: 'who' }, 1], var: 'pro_sub' } },
                            { emit: 'alive' },
                            { pause: 1200 },
                          ],
                          else: [
                            { engine_call: 'clw' },
                            { let: 'cost', value: { mul: [650, { member: { var: 'who' }, field: 'lv' }] } },
                            { emit: 'cost2' },
                            { menu_branch: {
                                prompt: 'pn_menu',
                                options: [
                                  { key: 'P', then: [
                                    { engine_call: 'clw' },
                                    { if: {
                                        cond: { lt: [{ gold: 0 }, { var: 'cost' }] },
                                        then: [
                                          { emit: 'no_gold' },
                                          { pause: 1000 },
                                        ],
                                        else: [
                                          { mutate: { target: { gold: 0 }, op: 'sub', value: { var: 'cost' } } },
                                          { mutate: { target: { member_field: { idx: { var: 'who' }, field: 'hp' } }, op: 'set', value: 1 } },
                                          { mutate: { target: { member_field: { idx: { var: 'who' }, field: 'dead' } }, op: 'set', value: 0 } },
                                          { mutate: { target: { pl: 0 }, op: 'add', value: 1 } },
                                          { engine_call: 'clw' },
                                          { engine_bind: { fn: 'pronoun', args: [{ var: 'who' }, 2], var: 'pro_obj' } },
                                          { emit: 'raised' },
                                          { pause: 1000 },
                                        ],
                                    } },
                                  ] },
                                ],
                            } },
                          ],
                      } },
                    ] },
                  ],
              } },
            ] },
            // --- (H)eal: cost = (h - hp) * 7. On dead target: show
            //     corpse + 1200ms and BREAK out of church (original
            //     used `return;`). Uses cost/no_gold2 text variants.
            { key: 'H', then: [
              { engine_call: 'clw' },
              { emit: 'who' },
              { menu_branch: {
                  key_var: 'who_ch',
                  options: [
                    { key_range: ['1', '4'], then: [
                      { let: 'who', value: { sub: [{ var: 'who_ch' }, 48] } },
                      { if: {
                          cond: { engine_int: 'pa_is_dead', args: [{ var: 'who' }] },
                          then: [
                            { engine_call: 'clw' },
                            { emit: 'corpse' },
                            { pause: 1200 },
                            { break: true },
                          ],
                      } },
                      { if: {
                          cond: { eq: [
                            { member: { var: 'who' }, field: 'hp' },
                            { member: { var: 'who' }, field: 'h' },
                          ] },
                          then: [
                            { engine_call: 'clw' },
                            { engine_bind: { fn: 'pronoun', args: [{ var: 'who' }, 1], var: 'pro_sub' } },
                            { emit: 'no_healing' },
                            { pause: 1000 },
                          ],
                          else: [
                            { let: 'cost', value: { mul: [
                                { sub: [
                                  { member: { var: 'who' }, field: 'h' },
                                  { member: { var: 'who' }, field: 'hp' },
                                ] },
                                7,
                            ] } },
                            { engine_call: 'clw' },
                            { emit: 'cost' },
                            { menu_branch: {
                                prompt: 'pn_menu',
                                options: [
                                  { key: 'P', then: [
                                    // NB: no clw here — the original's heal
                                    // pay branch omits the clw that energize/
                                    // raise use, so no_gold2 stacks on top of
                                    // the pn_menu text.
                                    { if: {
                                        cond: { lt: [{ gold: 0 }, { var: 'cost' }] },
                                        then: [
                                          { emit: 'no_gold2' },
                                          { pause: 1000 },
                                        ],
                                        else: [
                                          { engine_call: 'clw' },
                                          { mutate: { target: { gold: 0 }, op: 'sub', value: { var: 'cost' } } },
                                          { engine_bind: { fn: 'pronoun', args: [{ var: 'who' }, 2], var: 'pro_obj' } },
                                          { emit: 'healed' },
                                          { pause: 1000 },
                                          { mutate: { target: { member_field: { idx: { var: 'who' }, field: 'hp' } },
                                                      op: 'set',
                                                      value: { member: { var: 'who' }, field: 'h' } } },
                                        ],
                                    } },
                                  ] },
                                ],
                            } },
                          ],
                      } },
                    ] },
                  ],
              } },
            ] },
          ],
      } },
    ] },
  ],

  // smith() — weapon / armour shop. C wrapper advances state.tid and
  // resolves opening hours from world.json5's buildings.smith
  // (opens_at / closes_at), passing them in as `open_lo` / `open_hi`
  // bindings so the closed-screen check lives here and not in C.
  //
  // When open: clr_map_window + blitgfx(3) then the shop loop.
  //   * ryl_chance(9) into beer_offer: A -> three accept_N screens +
  //     rumour + ryl_pause; anything else -> decline + ryl_pause.
  //   * Otherwise: B/S/L menu.
  //       L — bye + clr_map_window + break.
  //       B — A/W/N buy menu.
  //           A — armour (ids 20..25, keys 1..6). oc = ch - 29 maps
  //               '1'=49 -> 20, '6'=54 -> 25.
  //           W — weapon pagination loop. N/P flip the page; any
  //               other key exits. key_var holds the last keypress,
  //               a switch maps it onto weapon ids 1 / 2 / 3 / 4 / 9
  //               / 11 / 7 / 14 / 10 / 8 / 15 / 16; default is oc=0
  //               (no purchase). The original's "inv_add(0) fills a
  //               slot with zero and prints Deal!" bug is fixed by
  //               that oc=0 gate — a pre-existing divergence between
  //               the armour and weapon paths that replay fixtures
  //               don't exercise today.
  //       S — sell any item in slots 1..16 (keys A..P). Filters
  //           `oc == 0 || oc > 30` (non-weapon/armour items) and
  //           falls into the bargain loop: Y sells at pr, B rolls
  //           0..99 with the 76/90 thresholds, N walks. Any other
  //           key re-prompts with the same pr.
  //
  // References `common.yes` / `common.no` as absolute text ids
  // (resolve_text_id treats dotted names as absolute). Uses emit,
  // not screen, so the three tx0 lines emit separately and each
  // carries its own cursor-right prefix — matches the four tx0
  // calls the C code makes per bargain iteration.
  smith: [
    { if: {
        cond: { or: [
          { lt: [{ tid: 0 }, { var: 'open_lo' }] },
          { gt: [{ tid: 0 }, { var: 'open_hi' }] },
        ] },
        then: [
          { engine_call: 'clw' },
          { emit: 'closed' },
          { pause: 1000 },
        ],
        else: [
          { engine_call: 'clr_map_window' },
          { engine_call: 'blitgfx', args: [3] },
          { loop: [
            { engine_call: 'clw' },
            { engine_call: 'statusline' },
            { emit: 'intro' },
            { chance: {
                pct: 9,
                then: [
                  { emit: 'beer_offer' },
                  { menu_branch: {
                      prompt: 'beer_menu',
                      options: [
                        { key: 'A', then: [
                            { engine_call: 'clw' },
                            { emit: 'accept_1' },
                            { pause: 2000 },
                            { emit: 'accept_2' },
                            { pause: 2000 },
                            { emit: 'accept_3' },
                            { pause: 2000 },
                            { engine_call: 'clw' },
                            { engine_call: 'rumour' },
                            { wait_input: true },
                        ] },
                      ],
                      // ryl_menu's (A)ccept/(D)ecline sentinel
                      // defaults to D — anything not 'A' takes the
                      // decline path. Folded into the default arm.
                      default: [
                        { engine_call: 'clw' },
                        { emit: 'decline' },
                        { wait_input: true },
                      ],
                  } },
                ],
                else: [
                  { menu_branch: {
                      prompt: 'shop_menu',
                      options: [
                        { key: 'L', then: [
                            { engine_call: 'clw' },
                            { emit: 'bye' },
                            { pause: 1000 },
                            { engine_call: 'clr_map_window' },
                            { break: true },
                        ] },
                        { key: 'B', then: [
                            { engine_call: 'clw' },
                            { menu_branch: {
                                prompt: 'buy_menu',
                                options: [
                                  // --- Armour buy
                                  { key: 'A', then: [
                                      { let: 'p20', value: { obcost: 20 } },
                                      { let: 'p21', value: { obcost: 21 } },
                                      { let: 'p22', value: { obcost: 22 } },
                                      { let: 'p23', value: { obcost: 23 } },
                                      { let: 'p24', value: { obcost: 24 } },
                                      { let: 'p25', value: { obcost: 25 } },
                                      { engine_call: 'clw' },
                                      { emit: 'we_have' },
                                      { emit: 'armour_menu' },
                                      { menu_branch: {
                                          key_var: 'armour_ch',
                                          options: [
                                            { key_range: ['1', '6'], then: [
                                              // oc = ch - 29 maps '1' (ASCII 49) -> 20 ... '6' (54) -> 25.
                                              { let: 'oc', value: { sub: [{ var: 'armour_ch' }, 29] } },
                                              { let: 'pr', value: { obcost: { var: 'oc' } } },
                                              { if: {
                                                  cond: { lt: [{ gold: 0 }, { var: 'pr' }] },
                                                  then: [
                                                    { engine_call: 'clw' },
                                                    { emit: 'too_expensive' },
                                                    { pause: 1000 },
                                                  ],
                                                  else: [
                                                    { engine_call: 'clw' },
                                                    { let: 'slot', value: { engine_int: 'inv_find_empty', args: [] } },
                                                    { if: {
                                                        cond: { eq: [{ var: 'slot' }, 0] },
                                                        then: [
                                                          { emit: 'cant_carry' },
                                                          { pause: 1000 },
                                                        ],
                                                        else: [
                                                          { mutate: { target: { inventory: { var: 'slot' } },
                                                                      op: 'set',
                                                                      value: { var: 'oc' } } },
                                                          { mutate: { target: { gold: 0 },
                                                                      op: 'sub',
                                                                      value: { var: 'pr' } } },
                                                          { emit: 'deal' },
                                                          { pause: 1000 },
                                                        ],
                                                    } },
                                                  ],
                                              } },
                                            ] },
                                          ],
                                      } },
                                  ] },
                                  // --- Weapon buy with N/P pagination
                                  { key: 'W', then: [
                                      { let: 'p1',  value: { obcost: 1 } },
                                      { let: 'p2',  value: { obcost: 2 } },
                                      { let: 'p3',  value: { obcost: 3 } },
                                      { let: 'p4',  value: { obcost: 4 } },
                                      { let: 'p9',  value: { obcost: 9 } },
                                      { let: 'p11', value: { obcost: 11 } },
                                      { let: 'p7',  value: { obcost: 7 } },
                                      { let: 'p14', value: { obcost: 14 } },
                                      { let: 'p10', value: { obcost: 10 } },
                                      { let: 'p8',  value: { obcost: 8 } },
                                      { let: 'p15', value: { obcost: 15 } },
                                      { let: 'p16', value: { obcost: 16 } },
                                      { let: 'menu', value: 1 },
                                      { loop: [
                                        { engine_call: 'clw' },
                                        { emit: 'we_have' },
                                        { if: { cond: { eq: [{ var: 'menu' }, 1] },
                                                then: [{ emit: 'weapon_page1' }] } },
                                        { if: { cond: { eq: [{ var: 'menu' }, 2] },
                                                then: [{ emit: 'weapon_page2' }] } },
                                        { menu_branch: {
                                            key_var: 'weapon_ch',
                                            options: [
                                              { key: 'N', then: [
                                                  { if: { cond: { eq: [{ var: 'menu' }, 1] },
                                                          then: [{ let: 'menu', value: 2 }] } },
                                              ] },
                                              { key: 'P', then: [
                                                  { if: { cond: { eq: [{ var: 'menu' }, 2] },
                                                          then: [{ let: 'menu', value: 1 }] } },
                                              ] },
                                            ],
                                            // key_var fires on default
                                            // too (see do_menu_branch),
                                            // so `weapon_ch` is always
                                            // the last key pressed.
                                            default: [{ break: true }],
                                        } },
                                      ] },
                                      // ASCII-coded switch: '1'=49
                                      // '9'=57, 'A'=65 'C'=67.
                                      { switch: {
                                          expr: { var: 'weapon_ch' },
                                          cases: [
                                            { match: 49, then: [{ let: 'oc', value: 1 }] },
                                            { match: 50, then: [{ let: 'oc', value: 2 }] },
                                            { match: 51, then: [{ let: 'oc', value: 3 }] },
                                            { match: 52, then: [{ let: 'oc', value: 4 }] },
                                            { match: 53, then: [{ let: 'oc', value: 9 }] },
                                            { match: 54, then: [{ let: 'oc', value: 11 }] },
                                            { match: 55, then: [{ let: 'oc', value: 7 }] },
                                            { match: 56, then: [{ let: 'oc', value: 14 }] },
                                            { match: 57, then: [{ let: 'oc', value: 10 }] },
                                            { match: 65, then: [{ let: 'oc', value: 8 }] },
                                            { match: 66, then: [{ let: 'oc', value: 15 }] },
                                            { match: 67, then: [{ let: 'oc', value: 16 }] },
                                            { default: true, then: [{ let: 'oc', value: 0 }] },
                                          ],
                                      } },
                                      { if: {
                                          cond: { gt: [{ var: 'oc' }, 0] },
                                          then: [
                                            { let: 'pr', value: { obcost: { var: 'oc' } } },
                                            { if: {
                                                cond: { lt: [{ gold: 0 }, { var: 'pr' }] },
                                                then: [
                                                  { engine_call: 'clw' },
                                                  { emit: 'too_expensive' },
                                                  { pause: 1000 },
                                                ],
                                                else: [
                                                  { engine_call: 'clw' },
                                                  { let: 'slot', value: { engine_int: 'inv_find_empty', args: [] } },
                                                  { if: {
                                                      cond: { eq: [{ var: 'slot' }, 0] },
                                                      then: [
                                                        { emit: 'cant_carry' },
                                                        { pause: 1000 },
                                                      ],
                                                      else: [
                                                        { mutate: { target: { inventory: { var: 'slot' } },
                                                                    op: 'set',
                                                                    value: { var: 'oc' } } },
                                                        { mutate: { target: { gold: 0 },
                                                                    op: 'sub',
                                                                    value: { var: 'pr' } } },
                                                        { emit: 'deal' },
                                                        { pause: 1000 },
                                                      ],
                                                  } },
                                                ],
                                            } },
                                          ],
                                      } },
                                  ] },
                                  // N or any other key: fall through
                                  // (back to outer shop loop), no
                                  // purchase.
                                ],
                            } },
                        ] },
                        { key: 'S', then: [
                            { engine_call: 'clw' },
                            { emit: 'sell_prompt' },
                            { engine_call: 'invlist' },
                            { menu_branch: {
                                key_var: 'sell_ch',
                                options: [
                                  { key_range: ['A', 'P'], then: [
                                    { let: 'slot', value: { sub: [{ var: 'sell_ch' }, 64] } },
                                    { let: 'oc', value: { inventory: { var: 'slot' } } },
                                    { let: 'pr', value: { div: [{ obcost: { var: 'oc' } }, 2] } },
                                    { if: {
                                        cond: { or: [
                                          { eq: [{ var: 'oc' }, 0] },
                                          { gt: [{ var: 'oc' }, 30] },
                                        ] },
                                        then: [
                                          { engine_call: 'clw' },
                                          { emit: 'not_w_or_a' },
                                          { pause: 1000 },
                                        ],
                                        else: [
                                          { loop: [
                                            { engine_call: 'clw' },
                                            { emit: 'offer' },
                                            { emit: 'common.yes' },
                                            { emit: 'common.no' },
                                            { emit: 'bargain_opt' },
                                            { menu_branch: {
                                                options: [
                                                  { key: 'Y', then: [
                                                      { mutate: { target: { inventory: { var: 'slot' } },
                                                                  op: 'set',
                                                                  value: 0 } },
                                                      { mutate: { target: { gold: 0 },
                                                                  op: 'add',
                                                                  value: { var: 'pr' } } },
                                                      { break: true },
                                                  ] },
                                                  { key: 'B', then: [
                                                      { let: 'i', value: { random: [0, 99] } },
                                                      { if: {
                                                          cond: { gt: [{ var: 'i' }, 90] },
                                                          then: [
                                                            { let: 'pr', value: {
                                                                add: [
                                                                  { var: 'pr' },
                                                                  { div: [{ var: 'pr' }, 4] },
                                                                ],
                                                            } },
                                                          ],
                                                      } },
                                                      { if: {
                                                          cond: { gt: [{ var: 'i' }, 75] },
                                                          then: [
                                                            { let: 'pr', value: {
                                                                add: [
                                                                  { var: 'pr' },
                                                                  { div: [{ var: 'pr' }, 6] },
                                                                ],
                                                            } },
                                                          ],
                                                      } },
                                                      { if: {
                                                          cond: { lt: [{ var: 'i' }, 76] },
                                                          then: [
                                                            { engine_call: 'clw' },
                                                            { emit: 'no_thanks' },
                                                            { pause: 1000 },
                                                            { break: true },
                                                          ],
                                                      } },
                                                  ] },
                                                  { key: 'N', then: [{ break: true }] },
                                                  // Any other key:
                                                  // re-prompt with
                                                  // the same pr
                                                  // (matches the
                                                  // original's
                                                  // while(1) fall-
                                                  // through).
                                                ],
                                            } },
                                          ] },
                                        ],
                                    } },
                                  ] },
                                ],
                            } },
                        ] },
                      ],
                  } },
                ],
            } },
          ] },
        ],
    } },
  ],

  // tavern() — drinking hall, rumour hub, and the scruffy-dealer
  // chance encounter. C wrapper advances state.tid and looks up
  // buildings.tavern (opens_at:6, closes_at:1 — wrap), handing the
  // script `open_lo`/`open_hi` to drive the closed screen.
  //
  // Closed check uses the WRAP form `tid < open_lo && tid > open_hi`
  // (closed only in the pre-dawn window 2..5). Smith-style buildings
  // use the non-wrap form; both shapes share the same bindings.
  //
  // Scruffy offer — one-shot, gated by ryl_chance(5 + x) where x is
  // the sum of charisma/10 across priest (cl==5) members. Item id
  // draws on `random(0, 16) + 1` mapped through a 17-case switch to
  // ids 15 / 17 / 26 / 38 / 41 / 100..111. The original used
  // `random(0, 15) + 1`, leaving case 17 (id 111, Jazzyfoot)
  // unreachable — fixed in migration so every listed special can
  // actually appear. Buy path uses inv_find_empty + inventory
  // mutate; the original called inv_add which is functionally
  // identical for non-special item storage.
  //
  // Main menu loop: L leaves, S hands to speak(1, twn), T runs the
  // tell-story flow (1..4 select member, dead -> dead_story, else
  // T/B story type -> st score thresholds, liar path breaks the
  // tavern outright like the original `return`). R consumes a
  // rumour token (caps at 5 before the bar goes quiet); O drinks
  // A..D at 2/3/4/1 gold, per-member heal of pr/2+1 clamped to h.
  //
  // `who` is engine_bound (RT_STR, pa_name) so `{who}` in stands_up
  // reads as the member's display name. The int form of the member
  // index is kept under `mi` — once engine_bind flips `who` to
  // RT_STR it is no longer readable as an int (expr_var refuses).
  tavern: [
    { if: {
        cond: { and: [
          { lt: [{ tid: 0 }, { var: 'open_lo' }] },
          { gt: [{ tid: 0 }, { var: 'open_hi' }] },
        ] },
        then: [
          { engine_call: 'clw' },
          { emit: 'closed' },
          { pause: 1000 },
        ],
        else: [
          { engine_call: 'clr_map_window' },
          { engine_call: 'blitgfx', args: [2] },

          // Scruffy-boost: sum of ch[m]/10 across priest members
          // (cl==5). Priest in a party raises the chance that the
          // scruffy dealer approaches.
          { let: 'x', value: 0 },
          { for_member: { var: 'm', then: [
            { if: {
                cond: { eq: [{ member: { var: 'm' }, field: 'cl' }, 5] },
                then: [
                  { let: 'x', value: { add: [
                    { var: 'x' },
                    { div: [{ member: { var: 'm' }, field: 'ch' }, 10] },
                  ] } },
                ],
            } },
          ] } },

          // One-shot offer gate. Fails -> straight to main loop.
          { chance: {
              pct: { add: [5, { var: 'x' }] },
              then: [
                { engine_call: 'clw' },
                { emit: 'scruffy_1' },
                { pause: 3000 },
                { emit: 'scruffy_2' },
                { pause: 3000 },
                { engine_call: 'clw' },
                { let: 'i', value: { add: [{ random: [0, 16] }, 1] } },
                { switch: {
                    expr: { var: 'i' },
                    cases: [
                      { match: 1,  then: [{ let: 'i', value: 15  }] },
                      { match: 2,  then: [{ let: 'i', value: 17  }] },
                      { match: 3,  then: [{ let: 'i', value: 26  }] },
                      { match: 4,  then: [{ let: 'i', value: 38  }] },
                      { match: 5,  then: [{ let: 'i', value: 41  }] },
                      { match: 6,  then: [{ let: 'i', value: 100 }] },
                      { match: 7,  then: [{ let: 'i', value: 101 }] },
                      { match: 8,  then: [{ let: 'i', value: 102 }] },
                      { match: 9,  then: [{ let: 'i', value: 103 }] },
                      { match: 10, then: [{ let: 'i', value: 104 }] },
                      { match: 11, then: [{ let: 'i', value: 105 }] },
                      { match: 12, then: [{ let: 'i', value: 106 }] },
                      { match: 13, then: [{ let: 'i', value: 107 }] },
                      { match: 14, then: [{ let: 'i', value: 108 }] },
                      { match: 15, then: [{ let: 'i', value: 109 }] },
                      { match: 16, then: [{ let: 'i', value: 110 }] },
                      { match: 17, then: [{ let: 'i', value: 111 }] },
                    ],
                } },
                { engine_bind: { fn: 'object', args: [{ var: 'i' }], var: 'item' } },
                { let: 'pr', value: { obcost: { var: 'i' } } },
                { emit: 'scruffy_offer' },
                { emit: 'buy_nothanks' },
                // Original `while (1) { ... if (c=='N'||c=='B') break; }`
                // spins on the key read until a mapped key lands. The
                // DSL menu_branch takes a single keypress, so wrap it
                // in a loop and break from each handler to match.
                { loop: [
                  { menu_branch: {
                      options: [
                        { key: 'B', then: [
                          { engine_call: 'clw' },
                          { if: {
                              cond: { lt: [{ gold: 0 }, { var: 'pr' }] },
                              then: [
                                { emit: 'scruffy_broke' },
                                { pause: 800 },
                              ],
                              else: [
                                { let: 'slot', value: { engine_int: 'inv_find_empty', args: [] } },
                                { if: {
                                    cond: { eq: [{ var: 'slot' }, 0] },
                                    then: [
                                      { emit: 'scruffy_full' },
                                      { pause: 1000 },
                                    ],
                                    else: [
                                      { mutate: { target: { inventory: { var: 'slot' } },
                                                  op: 'set', value: { var: 'i' } } },
                                      { emit: 'scruffy_deal' },
                                      { mutate: { target: { gold: 0 },
                                                  op: 'sub', value: { var: 'pr' } } },
                                      { pause: 800 },
                                    ],
                                } },
                              ],
                          } },
                          { break: true },
                        ] },
                        { key: 'N', then: [
                          { engine_call: 'clw' },
                          { emit: 'scruffy_no' },
                          { pause: 1000 },
                          { break: true },
                        ] },
                      ],
                  } },
                ] },
              ],
          } },

          // Main menu loop.
          { let: 'rumours', value: 0 },
          { loop: [
            { engine_call: 'clw' },
            { engine_bind: { fn: 'res_enum',
                             args: ['name', { add: [28, { twn: 0 }] }],
                             var: 'name' } },
            { emit: 'greeter' },
            { menu_branch: {
                prompt: 'main_menu',
                options: [
                  { key: 'L', then: [
                    { engine_call: 'clw' },
                    { engine_call: 'clr_map_window' },
                    { break: true },
                  ] },
                  { key: 'S', then: [
                    { engine_call: 'speak', args: [1, { twn: 0 }] },
                  ] },
                  // --- (T)ell story: pick a member (1..4). Dead
                  //     members produce the dead_story vignette.
                  //     Alive members get the T/B story-type pick,
                  //     an `st` score threshold ladder with ch
                  //     nudges per outcome, and the liar path that
                  //     breaks the tavern outright on a failed
                  //     boast charisma roll.
                  { key: 'T', then: [
                    { engine_call: 'clw' },
                    { emit: 'story_who' },
                    { menu_branch: {
                        key_var: 'who_ch',
                        options: [
                          { key_range: ['1', '4'], then: [
                            { let: 'mi', value: { sub: [{ var: 'who_ch' }, 48] } },
                            { if: {
                                cond: { engine_int: 'pa_is_dead', args: [{ var: 'mi' }] },
                                then: [
                                  { engine_call: 'clw' },
                                  { emit: 'dead_story' },
                                  { pause: 2000 },
                                ],
                                else: [
                                  { engine_call: 'clw' },
                                  { engine_bind: { fn: 'pa_name', args: [{ var: 'mi' }], var: 'who' } },
                                  { emit: 'stands_up' },
                                  { pause: 2000 },
                                  { emit: 'yeah' },
                                  { pause: 2000 },
                                  // ryl_menu's story_menu has no
                                  // fallback letter (default result
                                  // 0 in C); unmapped keys leave
                                  // is_boast == 0 (T behaviour).
                                  { let: 'is_boast', value: 0 },
                                  { menu_branch: {
                                      prompt: 'story_menu',
                                      options: [
                                        { key: 'T', then: [{ let: 'is_boast', value: 0 }] },
                                        { key: 'B', then: [{ let: 'is_boast', value: 1 }] },
                                      ],
                                  } },
                                  { let: 'st', value: 0 },
                                  { if: { cond: { eq: [{ var: 'is_boast' }, 1] },
                                          then: [{ let: 'st', value: { add: [{ var: 'st' }, 100] } }] } },
                                  { if: { cond: { eq: [
                                            { member: { var: 'mi' }, field: 'cl' },
                                            5,
                                          ] },
                                          then: [{ let: 'st', value: { add: [{ var: 'st' }, 100] } }] } },
                                  { if: { cond: { gt: [
                                            { member: { var: 'mi' }, field: 'ch' },
                                            90,
                                          ] },
                                          then: [{ let: 'st', value: { add: [{ var: 'st' }, 50] } }] } },
                                  { if: { cond: { gt: [
                                            { member: { var: 'mi' }, field: 'ch' },
                                            70,
                                          ] },
                                          then: [{ let: 'st', value: { add: [{ var: 'st' }, 50] } }] } },
                                  { let: 'st', value: { add: [{ var: 'st' }, { random: [1, 150] }] } },

                                  // Boast + failed charisma roll:
                                  // thrown out, ch -= 10 (floor 0),
                                  // BREAK the main loop so the
                                  // script returns to towne.enter.
                                  // Original used `return`.
                                  { if: {
                                      cond: { eq: [{ var: 'is_boast' }, 1] },
                                      then: [
                                        { if: {
                                            cond: { gt: [
                                              { random: [0, 99] },
                                              { member: { var: 'mi' }, field: 'ch' },
                                            ] },
                                            then: [
                                              { engine_call: 'clw' },
                                              { emit: 'liar_kicked' },
                                              { pause: 2000 },
                                              { emit: 'thrown_out' },
                                              { mutate: { target: { member_field: { idx: { var: 'mi' }, field: 'ch' } },
                                                          op: 'sub', value: 10,
                                                          clamp: { min: 0 } } },
                                              { engine_call: 'clr_map_window' },
                                              { break: true },
                                            ],
                                        } },
                                      ],
                                  } },

                                  { engine_call: 'clw' },
                                  { if: { cond: { gt: [{ var: 'st' }, 400] },
                                          then: [
                                            { emit: 'st_superb' },
                                            { wait_input: true },
                                            { mutate: { target: { member_field: { idx: { var: 'mi' }, field: 'ch' } },
                                                        op: 'add', value: 3 } },
                                          ] } },
                                  { if: { cond: { and: [
                                            { gt: [{ var: 'st' }, 300] },
                                            { lt: [{ var: 'st' }, 401] },
                                          ] },
                                          then: [
                                            { emit: 'st_vgood' },
                                            { wait_input: true },
                                            { mutate: { target: { member_field: { idx: { var: 'mi' }, field: 'ch' } },
                                                        op: 'add', value: 1 } },
                                          ] } },
                                  { if: { cond: { and: [
                                            { gt: [{ var: 'st' }, 150] },
                                            { lt: [{ var: 'st' }, 301] },
                                          ] },
                                          then: [
                                            { emit: 'st_nice' },
                                            { wait_input: true },
                                          ] } },
                                  { if: { cond: { and: [
                                            { gt: [{ var: 'st' }, 100] },
                                            { lt: [{ var: 'st' }, 151] },
                                          ] },
                                          then: [
                                            { emit: 'st_bored' },
                                            { wait_input: true },
                                            { if: { cond: { gt: [
                                                      { member: { var: 'mi' }, field: 'ch' },
                                                      0,
                                                    ] },
                                                    then: [{ mutate: { target: { member_field: { idx: { var: 'mi' }, field: 'ch' } },
                                                                       op: 'sub', value: 1 } }] } },
                                          ] } },
                                  { if: { cond: { lt: [{ var: 'st' }, 101] },
                                          then: [
                                            { emit: 'st_asleep' },
                                            { wait_input: true },
                                            { if: { cond: { gte: [
                                                      { member: { var: 'mi' }, field: 'ch' },
                                                      3,
                                                    ] },
                                                    then: [{ mutate: { target: { member_field: { idx: { var: 'mi' }, field: 'ch' } },
                                                                       op: 'sub', value: 3 } }] } },
                                          ] } },
                                ],
                            } },
                          ] },
                        ],
                    } },
                  ] },
                  // --- (R)umours: up to 5 per visit, then the bar
                  //     goes quiet. Switch on random(0,4) picks an
                  //     intro (old man / bard / halfling / keeper /
                  //     bargirl), then engine_call rumour runs the
                  //     body. rum_* texts carry a trailing blank
                  //     line that replaces the original tx("\r\n")
                  //     separator.
                  { key: 'R', then: [
                    { engine_call: 'clw' },
                    { if: { cond: { lt: [{ var: 'rumours' }, 5] },
                            then: [{ let: 'rumours', value: { add: [{ var: 'rumours' }, 1] } }] } },
                    { if: {
                        cond: { gt: [{ var: 'rumours' }, 4] },
                        then: [
                          { emit: 'quiet' },
                          { wait_input: true },
                        ],
                        else: [
                          { switch: {
                              expr: { random: [0, 4] },
                              cases: [
                                { match: 0, then: [{ emit: 'rum_old' }] },
                                { match: 1, then: [{ emit: 'rum_bard' }] },
                                { match: 2, then: [{ emit: 'rum_halfling' }] },
                                { match: 3, then: [{ emit: 'rum_keeper' }] },
                                { match: 4, then: [{ emit: 'rum_bargirl' }] },
                              ],
                          } },
                          { engine_call: 'rumour' },
                          { wait_input: true },
                        ],
                    } },
                  ] },
                  // --- (O)rder drink: A..D at 2/3/4/1 gold. A..C
                  //     emit aah, D emits laughed_at (Fanta mocker).
                  //     Payment deducts pr, then every member (dead
                  //     included — matches the original loop) gets
                  //     pr/2+1 hp clamped to h.
                  { key: 'O', then: [
                    { engine_call: 'clw' },
                    { emit: 'order_header' },
                    { emit: 'order_menu' },
                    { menu_branch: {
                        key_var: 'drink_ch',
                        options: [
                          { key_range: ['A', 'D'], then: [
                            { let: 'pr', value: 0 },
                            { switch: {
                                expr: { var: 'drink_ch' },
                                cases: [
                                  { match: 65, then: [{ let: 'pr', value: 2 }] },
                                  { match: 66, then: [{ let: 'pr', value: 3 }] },
                                  { match: 67, then: [{ let: 'pr', value: 4 }] },
                                  { match: 68, then: [{ let: 'pr', value: 1 }] },
                                ],
                            } },
                            { if: {
                                cond: { lt: [{ gold: 0 }, { var: 'pr' }] },
                                then: [
                                  { engine_call: 'clw' },
                                  { emit: 'no_drink' },
                                  { pause: 1000 },
                                ],
                                else: [
                                  { engine_call: 'clw' },
                                  { if: { cond: { ne: [{ var: 'drink_ch' }, 68] },
                                          then: [
                                            { emit: 'aah' },
                                            { pause: 1000 },
                                          ],
                                          else: [
                                            { emit: 'laughed_at' },
                                            { pause: 2000 },
                                          ] } },
                                  { mutate: { target: { gold: 0 }, op: 'sub', value: { var: 'pr' } } },
                                  { for_member: { var: 'm', then: [
                                    { mutate: {
                                        target: { member_field: { idx: { var: 'm' }, field: 'hp' } },
                                        op: 'add',
                                        value: { add: [{ div: [{ var: 'pr' }, 2] }, 1] },
                                        clamp: { max: { member: { var: 'm' }, field: 'h' } },
                                    } },
                                  ] } },
                                ],
                            } },
                          ] },
                        ],
                    } },
                  ] },
                ],
            } },
          ] },
        ],
    } },
  ],
}
