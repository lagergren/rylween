// L7 step 2: hunt-flow lift. C wrapper in src/subs.c reads the
// balance.hunt subtree (success pct, time cost, food range) from
// world.json5 and hands them to play_script as int bindings; the
// script owns the who-loop, ranger gate, time gate, and the trap
// success / failure narration.
//
// All ranger / dead checks go through engine_int helpers
// (pa_is_class / pa_is_dead) so single-ownership of party state
// stays unbroken.
//
// Imported as scripts.hunt (top-level array), so play_script("hunt")
// in subs.c walks straight to this body.
[
  // --- Pick a member: loop until a live member's digit lands.
    //     Non-digits silently re-loop (matches the original `key()`
    //     spin); dead picks emit "Dead." and re-loop after 600ms.
    { let: 'member_idx', value: 0 },
    { loop: [
      { engine_call: 'clw' },
      { emit: 'who' },
      { menu_branch: {
          key_var: 'who_key',
          options: [
            { digit_range: { lo: 1, hi: { engine_int: 'pa_party_member_max' } }, then: [
              { let: 'member_idx', value: { sub: [{ var: 'who_key' }, 48] } },
              { if: {
                  cond: { engine_int: 'pa_is_dead', args: [{ var: 'member_idx' }] },
                  then: [
                    { engine_call: 'clw' },
                    { emit: 'dead' },
                    { pause: 600 },
                  ],
                  else: [
                    { break: true },
                  ],
              } },
            ] },
          ],
      } },
    ] },

    // --- Class gate: must be a Ranger. Original: `pronoun(who, 1)`
    //     i.e. subject form; "is not a ranger." follows.
    { if: {
        cond: { not: { engine_int: 'pa_is_class',
                       args: [{ var: 'member_idx' }, { enum: ['pc_class', 'Ranger'] }] } },
        then: [
          { engine_call: 'clw' },
          { engine_bind: { fn: 'pronoun', args: [{ var: 'member_idx' }, 'subject'], var: 'pro_sub' } },
          { emit: 'not_ranger' },
          { pause: 700 },
          { engine_call: 'clw' },
        ],
        else: [
          { engine_call: 'clw' },

          // --- Time gate: must have at least `time_cost` moves left.
          { if: {
              cond: { lt: [{ time_left: 0 }, { var: 'time_cost' }] },
              then: [
                { emit: 'too_few_moves' },
                { pause: 1000 },
              ],
              else: [
                { mutate: { target: { time_left: 0 }, op: 'sub', value: { var: 'time_cost' } } },
                { engine_bind: { fn: 'pa_name', args: [{ var: 'member_idx' }], var: 'who_name' } },
                { emit: 'tries' },
                { pause: 1400 },
                { if: {
                    cond: { chance: { var: 'success_pct' } },
                    then: [
                      { let: 'fdplus', value: {
                          add: [{ random: [{ var: 'food_min' }, { var: 'food_max' }] },
                                { engine_int: 'pa_first_level' }] } },
                      { emit: 'succeeds' },
                      { mutate: { target: { food: 0 }, op: 'add', value: { var: 'fdplus' } } },
                      { wait_input: true },
                      { engine_call: 'clw' },
                    ],
                    else: [
                      { emit: 'fails' },
                      { wait_input: true },
                      { engine_call: 'clw' },
                    ],
                } },
              ],
          } },
        ],
    } },
]
