// NPC dialogue scripts (§16.4). Each entry is an array of one-op
// objects the script interpreter in src/script.c walks in order.
// Screen names resolve against the matching path in data/world/texts/
// speak.json5 — e.g. `{ screen: 'rumour' }` inside `erethor.first_visit`
// becomes `speak.erethor.rumour`.
//
// Ops:
//   { screen:   '<name>' }    tx_fmt(<parent>.<name>, bindings)
//                             + ryl_pause() + clw()
//   { journal:  '<text>' }    prepended with "<cpl> ", trailing "\n",
//                             {placeholders} expand via bindings
//   { set_flag: <slot>,       state.p[cpl].flag[slot] = value
//     value:    <int> }
//   { reward: {               gold += N; for each items[] entry, drop
//     gold: <int>,              into first-empty inventory slot (1..16).
//     items: [<int|str>...],    On no-free-slot, emit cant_carry_screen
//     cant_carry_screen:        (delay 800ms, drop_option, optional
//       '<name>',               picked_up_screen on success, delay
//     picked_up_screen:         800ms, ryl_pause). All fields optional
//       '<name>' } }            except the `reward` key itself. Item
//                               entries are literal ids OR symbolic
//                               shard keys resolved via res_item_id.
//
// Ordering matters: keep set_flag ops in the same position relative to
// screens as the original speak.c sequencing. Bindings are passed in
// from the C caller (res_enum lookups, snprintf location strings, etc.).
//
// §16.5 reward-bearing scripts (merchant.grateful, fighter.grateful,
// brother.give_sword, husband.rescued, minstrel.gives_cloak) are ALL
// fixture-unreachable — per the §16.3 slice C commit the three
// fixtures (title-menu-exit, title-create-party-{exit,combat}) never
// complete any mission. No byte-parity risk.
{
  // case 1, flag[1]==0 — robbed merchant pitches the bandits mission.
  // Caller pre-clws (matches original: leading clw() before tx0).
  merchant: {
    first_visit: [
      { screen: 'offer' },
      { screen: 'bandits' },
      { set_flag: 1, value: 1 },
    ],
    // case 1, flag[1]==2 — merchant hands over the ruby. Reward is
    // 2000 gold + item 39 (red_gem); if the inventory's full the
    // player picks one slot to drop via drop_option, then gets the
    // 'You pick up the gem.' line from picked_up.
    grateful: [
      { screen: 'grateful' },
      { reward: { gold: 2000, items: ['red_gem'],
                  cant_carry_screen: 'cant_carry',
                  picked_up_screen: 'picked_up' } },
      { set_flag: 1, value: 3 },
    ],
  },

  // case 3, flag[3]==3 — old fighter hands over the Dancing Blade
  // after the priest returned his book. Original set flag BEFORE the
  // reward flow (and before the inventory drop_option prompt), so the
  // set_flag op precedes the reward here to mirror that ordering.
  fighter: {
    grateful: [
      { screen: 'blade' },
      { set_flag: 3, value: 4 },
      { reward: { items: ['dancing_sword'],
                  cant_carry_screen: 'cant_carry',
                  picked_up_screen: 'take_blade' } },
    ],
  },

  // case 4, flag[3]==2 — wizard hands over the priest's book.
  // Caller pre-clws. Original sequenced flag-set between tx0 and
  // ryl_pause; no observable difference from setting it after the
  // screen (key-read doesn't touch flag[3]).
  wizard: {
    robbed_flow: [
      { screen: 'robbed' },
      { set_flag: 3, value: 3 },
    ],
  },

  // case 8, flag[8]==0 — Erethor's Lute rumour + Cloak lead + map note.
  // Caller does NOT pre-clw (matches original: no leading clw before
  // the first tx0). Journal line is a literal coord, not a binding.
  erethor: {
    first_visit: [
      { screen: 'rumour' },
      { screen: 'demon' },
      { screen: 'poor_man' },
      { screen: 'trade' },
      { screen: 'dangerous' },
      { journal: "Erethor's temple is situated at 6x20." },
      { set_flag: 8, value: 1 },
    ],
  },

  // case 18, flag[6]==2 — thief2 squeezed for smith's name.
  // Caller pre-clws and passes {smith_name} binding for the inline
  // tx_fmt record. Original set the flag BEFORE the first tx0; mirror
  // that by placing set_flag first.
  thief2: {
    squeezed: [
      { set_flag: 6, value: 3 },
      { screen: 'push' },
      { screen: 'smith' },
      { screen: 'let_go' },
    ],
  },

  // case 19, flag[19]==0 — husband's depressed pitch, Tammy abduction.
  // Caller pre-clws. Original sequenced journalf between tx0(cave) and
  // ryl_pause; moving journal after the screen is observably identical.
  husband: {
    first_visit: [
      { screen: 'depressed' },
      { screen: 'fortune' },
      { screen: 'cave' },
      { journal: "The orc cavern is at 42x23." },
      { set_flag: 19, value: 1 },
    ],
    // case 19, flag[19]==2 — Tammy safe; husband pays out. 3000 gold
    // plus five items: admt_mail, holy_handgrenade, amber_potion,
    // fire_wand, crystal_bowl (port-plan §16.5's worked example; the
    // ints are 26, 110, 38, 101, 45). Original emitted one final
    // cant_carry line if any item failed to fit; the reward op now
    // prompts drop_option per-item, which is the port-plan shape.
    // Unreachable from fixtures, so the behaviour change is fine.
    rescued: [
      { screen: 'reunion' },
      { screen: 'gives' },
      { set_flag: 19, value: 3 },
      { reward: { gold: 3000,
                  items: ['admt_mail', 'holy_handgrenade', 'amber_potion',
                          'fire_wand', 'crystal_bowl'],
                  cant_carry_screen: 'cant_carry' } },
    ],
  },

  // case 14, flag[2]==1 — ranger's brother receives the letter, hands
  // over the Magic Sword. Caller passes no bindings; flag[2] advances
  // after the reward flow (original placed flag set after ryl_pause).
  brother: {
    give_sword: [
      { screen: 'give_sword' },
      { screen: 'produces' },
      { reward: { items: ['magic_sword'],
                  cant_carry_screen: 'cant_carry',
                  picked_up_screen: 'take_sword' } },
      { set_flag: 2, value: 2 },
    ],
  },

  // case 20, flag[8]==3 — minstrel reads the note, hands over Cloak
  // of Gods, bids farewell pointing at the next town. Bindings flow
  // through both screens: {minstrel_name} on `reads`, {next_town} on
  // `travel`. Reward sits between them — matches the original tx_fmt
  // -> inventory -> tx_fmt sequencing.
  minstrel: {
    gives_cloak: [
      { screen: 'reads' },
      { reward: { items: ['cloak_of_gods'],
                  cant_carry_screen: 'cant_carry',
                  picked_up_screen: 'take_cloak' } },
      { screen: 'travel' },
      { set_flag: 8, value: 4 },
    ],
  },

  // case 24, flag[6]==3 — smith confesses the hobgoblin ambush.
  // Caller pre-clws.
  smith: {
    after_thief2: [
      { screen: 'ask' },
      { screen: 'sorry' },
      { screen: 'pursued' },
      { screen: 'clubbed' },
      { set_flag: 6, value: 4 },
    ],
  },

  // case 33, flag[33]==0 — hermit's opener (no troll-tooth yet).
  // Caller pre-clws.
  hermit: {
    welcome_visit: [
      { screen: 'welcome' },
      { set_flag: 33, value: 1 },
    ],
  },
}
