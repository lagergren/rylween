// L7 step 3: camp/rest-flow lift. C wrapper in src/subs.c reads the
// balance.rest subtree (ambush%, healing, food cost, hours advanced,
// temperature thresholds + damage) from world.json5 and hands them
// to play_script as int bindings; the script owns the early-out
// gates, the (Y)es/(N)o guard prompt, the temperature check, the
// time-advance + food-cost + heal pass, and the post-rest ambush /
// well-rested split.
//
// All party-state mutation goes through pa_*/pm_*/inv_* helpers via
// the engine_int / engine_call / mutate registry — no raw `state.*`
// access. Bindings:
//   ambush_pct, health_gain, food_per_member, rest_hours,
//   hours_rested_reset, temp_max, temp_low_lo, temp_low_hi,
//   temp_very_low_lo, temp_low_dmg, temp_very_low_dmg
//
// Imported as scripts.rest (top-level array), so play_script("rest")
// in subs.c walks straight to this body.
[
  // --- Early outs -------------------------------------------------
    { if: {
        cond: { gt: [{ hours_rested: 0 }, 0] },
        then: [
          { engine_call: 'clw' },
          { emit: 'not_tired' },
          { pause: 600 },
          { engine_call: 'clw' },
        ],
        else: [
          { if: {
              cond: { eq: [{ engine_int: 'pa_alive_count' }, 0] },
              then: [
                // Original returns silently when the whole party is
                // wiped out — driver loop redraws on next tick.
              ],
              else: [
                { engine_call: 'clr_map_window' },

                // Tent in inventory? Pic 'tent' (id 17) on yes,
                // 'notent' (id 18) on no — see enums.pic.
                { if: {
                    cond: { ne: [{ engine_int: 'inv_find_item', args: ['tent'] }, 0] },
                    then: [{ engine_call: 'blitgfx', args: [{ pic: 'tent' }] }],
                    else: [{ engine_call: 'blitgfx', args: [{ pic: 'notent' }] }],
                } },
                { engine_call: 'clw' },

                // --- Guard prompt. Sentinel `-1` means no guard;
                // post-§25.B slot 0 is a real member, so the
                // legacy `guard == 0` "no guard" can no longer
                // double as a slot value.
                { let: 'guard', value: -1 },
                { emit: 'camp_intro' },
                { emit: 'common.yes' },
                { emit: 'common.no' },
                { menu_branch: {
                    options: [
                      { key: 'Y', then: [
                        { loop: [
                          { engine_call: 'clw' },
                          { emit: 'who' },
                          { menu_branch: {
                              options: [
                                { digit_range: { lo: 1, hi: { engine_int: 'pa_party_member_max' } }, index_var: 'member_idx', then: [
                                  { if: {
                                      cond: { engine_int: 'pa_is_dead', args: [{ var: 'member_idx' }] },
                                      then: [
                                        { engine_call: 'clw' },
                                        { emit: 'dead' },
                                        { pause: 1000 },
                                      ],
                                      else: [
                                        { let: 'guard', value: { var: 'member_idx' } },
                                        { break: true },
                                      ],
                                  } },
                                ] },
                              ],
                              // Non-digit keys land here ("Not valid!"
                              // 1000ms then re-loop). Original did the
                              // same on any non-digit including '0'.
                              default: [
                                { engine_call: 'clw' },
                                { emit: 'not_valid' },
                                { pause: 1000 },
                              ],
                          } },
                        ] },
                        { engine_call: 'clw' },
                        { engine_bind: { fn: 'pa_name',  args: [{ var: 'guard' }], var: 'guard_name' } },
                        { engine_bind: { fn: 'pronoun', args: [{ var: 'guard' }, 'subject'], var: 'pro_sub' } },
                        { emit: 'stands_guard' },
                        { wait_input: true },
                      ] },
                    ],
                    // (N)o or any other key just continues. Default
                    // here is a no-op — fall through to Zzz.
                    default: [],
                } },

                { engine_call: 'clw' },
                { emit: 'zzz' },
                { pause: 1500 },

                // --- Temperature roll (1..temp_max). Disjoint bands:
                //     [temp_low_lo, temp_low_hi)  -> "Low Temperature."
                //     [temp_very_low_lo, ...)     -> "Very low temperature."
                //     Defaults: 6..10 / 10.. (so temp_low_hi == temp_very_low_lo).
                { let: 'temperature', value: { random: [1, { var: 'temp_max' }] } },
                { if: {
                    cond: { and: [
                      { gte: [{ var: 'temperature' }, { var: 'temp_low_lo' }] },
                      { lt: [{ var: 'temperature' }, { var: 'temp_low_hi' }] },
                    ] },
                    then: [
                      { engine_call: 'clw' },
                      { emit: 'temp_low' },
                      { pause: 600 },
                      // Blanket OR tent shields the party from
                      // low-temperature damage.
                      { if: {
                          cond: { eq: [{ engine_int: 'inv_find_in_range', args: ['blanket', 'tent'] }, 0] },
                          then: [
                            { emit: 'no_gear_5' },
                            { pause: 1500 },
                            { for_member: { var: 'member', then: [
                              { engine_call: 'pm_add_hit_points',  args: [{ var: 'member' }, { sub: [0, { var: 'temp_low_dmg' }] }] },
                              { engine_call: 'pm_hit_points_floor', args: [{ var: 'member' }, 1] },
                            ] } },
                          ],
                      } },
                    ],
                } },
                { if: {
                    cond: { gte: [{ var: 'temperature' }, { var: 'temp_very_low_lo' }] },
                    then: [
                      // Note: original prints this without a leading
                      // clw — it stacks under any prior text.
                      { emit: 'temp_very_low' },
                      { pause: 600 },
                      // Tent only shields against very-low.
                      { if: {
                          cond: { eq: [{ engine_int: 'inv_find_item', args: ['tent'] }, 0] },
                          then: [
                            { emit: 'no_gear_10' },
                            { pause: 1500 },
                            { for_member: { var: 'member', then: [
                              { engine_call: 'pm_add_hit_points',  args: [{ var: 'member' }, { sub: [0, { var: 'temp_very_low_dmg' }] }] },
                              { engine_call: 'pm_hit_points_floor', args: [{ var: 'member' }, 1] },
                            ] } },
                          ],
                      } },
                    ],
                } },

                // --- Advance the in-game clock by `rest_hours`.
                { let: 'hour', value: 0 },
                { loop: [
                  { if: {
                      cond: { gte: [{ var: 'hour' }, { var: 'rest_hours' }] },
                      then: [{ break: true }],
                  } },
                  { engine_call: 'advance_hour' },
                  { let: 'hour', value: { add: [{ var: 'hour' }, 1] } },
                ] },

                // --- Reset hours_rested + pay the food cost. Original:
                //   if (food < cost) food = 0; else food -= cost;
                //   if (food < 0) food = 0;
                //   collapses to: food = max(0, food - cost).
                { mutate: { target: { hours_rested: 0 }, op: 'set',
                            value: { var: 'hours_rested_reset' } } },
                { mutate: { target: { food: 0 }, op: 'sub',
                            value: { mul: [{ var: 'food_per_member' }, { pl: 0 }] },
                            clamp: { min: 0 } } },

                // --- Heal each non-guard, non-dead member; clamp to h.
                { for_member: { var: 'member', then: [
                  { if: {
                      cond: { and: [
                        { ne: [{ var: 'member' }, { var: 'guard' }] },
                        { not: { engine_int: 'pa_is_dead', args: [{ var: 'member' }] } },
                      ] },
                      then: [
                        { mutate: {
                            target: { member_field: { idx: { var: 'member' }, field: 'hit_points' } },
                            op: 'add', value: { var: 'health_gain' },
                            clamp: { max: { member: { var: 'member' }, field: 'health'} },
                        } },
                      ],
                  } },
                ] } },

                // --- Ambush vs well-rested split.
                { if: {
                    cond: { chance: { var: 'ambush_pct' } },
                    then: [
                      { engine_call: 'clw' },
                      { emit: 'ambush' },
                      { pause: 1000 },
                      // Surprise kill only when there's no guard AND
                      // the party has more than one member (so a solo
                      // hero never dies in their sleep). Random victim
                      // is 0..3 (party-member slots, post-§25.B).
                      { if: {
                          cond: { and: [
                            { eq: [{ var: 'guard' }, -1] },
                            { gt: [{ pl: 0 }, 1] },
                          ] },
                          then: [
                            { let: 'victim', value: { random: [0, 3] } },
                            { engine_bind: { fn: 'pa_name', args: [{ var: 'victim' }], var: 'victim_name' } },
                            { emit: 'surprise_kill' },
                            { mutate: { target: { member_field: { idx: { var: 'victim' }, field: 'hit_points' } },
                                        op: 'set', value: 0 } },
                            { mutate: { target: { member_field: { idx: { var: 'victim' }, field: 'dead' } },
                                        op: 'set', value: 1 } },
                            { mutate: { target: { pl: 0 }, op: 'sub', value: 1 } },
                            { wait_input: true },
                          ],
                      } },
                      { encounter: { tier: 'weak' } },
                    ],
                    else: [
                      { engine_call: 'clw' },
                      { emit: 'well_rested' },
                      { wait_input: true },
                      { engine_call: 'clr_map_window' },
                      { engine_call: 'clw' },
                    ],
                } },

                { engine_call: 'update_map' },
              ],
          } },
        ],
    } },
]
