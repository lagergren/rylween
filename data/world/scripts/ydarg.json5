// Castle Ydarg gate scripts — fired from missions.c::mission_try_at_enter
// when the party stands on the castle tile (data/world.json5 ydarg.entry)
// and presses E. The MG_SPECIAL_EQ guard kind splits on the silverkey
// special so the three arms (ruin / no_key / entry) live as separate
// trigger entries instead of the historical chain of early-returns at
// the top of ydarg().
//
// Text records under data/world/texts/ydarg.json5 — the resolver finds
// `ydarg.<name>` first, then falls back to the leaf-name lookup.
//
// `ruin` and `no_key` end with clr_map_window + update_map (matching
// the legacy returns); `entry` is still the §17 / §23.J C body (the
// per-room walkthrough + confrontation hasn't been lifted yet).
{
  // silverkey == 2 — castle has been beaten, party returns to ruins.
  // No approach narration; the legacy block fires `ruin` immediately
  // and exits.
  ruin: [
    { engine_call: 'clr_map_window' },
    { engine_call: 'blitgfx', args: [14] },
    { engine_call: 'clw' },
    { screen: 'ruin' },
    { engine_call: 'clr_map_window' },
    { engine_call: 'update_map' },
    { engine_call: 'clw' },
  ],

  // silverkey == 0 — party hasn't found the key yet. Run the full
  // approach + Jaara narration (shared with the entry arm) then the
  // no_key rejection screen and return to wilderness.
  no_key: [
    { engine_call: 'clr_map_window' },
    { engine_call: 'blitgfx', args: [14] },
    { engine_call: 'clw' },
    { screen: 'approach' },
    { screen: 'jaara_form' },
    { screen: 'jaara_speech' },
    { emit: 'no_key' },
    { wait_input: true },
    { engine_call: 'clr_map_window' },
    { engine_call: 'update_map' },
  ],

  // silverkey == 1 (legitimate entry) intro: clr_map_window +
  // blitgfx + the four narration screens (approach / jaara_form /
  // jaara_speech / key_accepted / enter) followed by the door-slams
  // screen which delays 2000ms before falling through to the per-
  // floor walk-through. ydarg() invokes this as `play_script("ydarg.intro")`
  // before the room-init + while-loop dispatcher.
  intro: [
    { engine_call: 'clr_map_window' },
    { engine_call: 'blitgfx', args: [14] },
    { engine_call: 'clw' },
    { screen: 'approach' },
    { screen: 'jaara_form' },
    { screen: 'jaara_speech' },
    { screen: 'key_accepted' },
    { screen: 'enter' },
    { emit: 'door_slams' },
    { pause: 2000 },
    { engine_call: 'clw' },
  ],

  // §23.H: per-room (case 1) monster encounter. ydarg() owns the
  // room[xl][yl] = 0 write before invoking the script (the room grid
  // is C-side state, not yet hoisted). The body is exactly the legacy
  // case-1 chain: announce the encounter, ryl_delay 1500, run a deep-
  // tier encounter (non-mandatory — fleeing is allowed), redraw the
  // castle backdrop.
  room_monster: [
    { emit: 'ydarg.room.monster' },
    { pause: 1500 },
    { encounter: { tier: 'deep' } },
    { engine_call: 'clr_map_window' },
    { engine_call: 'blitgfx', args: [14] },
    { engine_call: 'clw' },
  ],

  // §23.J case-2 (pitfall) lift. Dispatcher shape:
  //   1. Clear the room slot ("I've been here").
  //   2. Pick a random victim 0..3 (legacy hardcoded — independent
  //      of party_member_max), bind their name, emit "{victim}
  //      springs a / trap!!!", delay 1500ms, clw.
  //   3. Walk every party slot (alive or dead — legacy quirk
  //      preserved); on the first thief, emit "tries to disarm",
  //      pause, ryl_chance(thief.wisdom): on success emit
  //      AND SUCCEEDS! and set disarmed=1, on failure emit
  //      BUT FAILS! Either way break out of the search.
  //   4. If disarmed==0 (no thief OR thief failed), invoke the
  //      ydarg_pitfall_undisarmed_apply backer which picks a random
  //      trap_type from ydarg.pitfall.trap_types, emits its body,
  //      ryl_pauses, and shaves pm_hit_points / damage_div off
  //      every alive member.
  case_pitfall: [
    { engine_call: 'ydarg_clear_room_at_cur' },
    { engine_bind: { fn: 'pa_name', args: [{ random: [0, 3] }], var: 'victim' } },
    { emit: 'ydarg.room.trap.springs' },
    { pause: 1500 },
    { engine_call: 'clw' },
    { let: 'disarmed', value: 0 },
    { for_member: { var: 'm', then: [
      { if: { cond: { engine_int: 'pa_is_class', args: [{ var: 'm' }, 'thief'] }, then: [
        { engine_bind: { fn: 'pa_name', args: [{ var: 'm' }], var: 'thief' } },
        { emit: 'ydarg.room.trap.tries_disarm' },
        { pause: 1500 },
        { if: { cond: { chance: { member: { var: 'm' }, field: 'wisdom' } },
          then: [
            { emit: 'ydarg.room.trap.disarm_succeed' },
            { pause: 1000 },
            { let: 'disarmed', value: 1 },
          ],
          else: [
            { emit: 'ydarg.room.trap.disarm_fail' },
            { pause: 1000 },
          ],
        } },
        { break: true },
      ] } },
    ] } },
    { if: { cond: { eq: [{ var: 'disarmed' }, 0] }, then: [
      { engine_call: 'ydarg_pitfall_undisarmed_apply' },
    ] } },
  ],

  // §23.K: roof-deck confrontation. Lifts the legacy C confrontation()
  // function. Four narration acts bracket two encounter blocks (the
  // 4-monster sequence then Baron Ydarg himself), with the silverkey
  // bump + save persisted between act-3 and act-4 so a kill-after-save
  // crash still records the win. Final op is ydarg_finalize which
  // appends to heroes.txt and cleanexits — the script has no path back
  // to the caller.
  //
  // {p1_name} is the first party member's display name, bound up
  // front via engine_bind so the narration acts can reference it.
  confrontation: [
    { engine_bind: { fn: 'pa_name', args: [0], var: 'p1_name' } },
    { narrate: 'ydarg.narration.conf_act1' },
    { engine_call: 'clw' },
    { engine_call: 'ydarg_run_seq' },
    { narrate: 'ydarg.narration.conf_act2' },
    { encounter: { foe: 'baron_ydarg', mandatory: true } },
    { narrate: 'ydarg.narration.conf_act3' },
    { engine_call: 'ydarg_record_completion' },
    { narrate: 'ydarg.narration.conf_act4' },
    { engine_call: 'clw' },
    { engine_call: 'ydarg_finalize' },
  ],
}
