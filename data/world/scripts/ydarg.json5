// Castle Ydarg gate scripts — fired from missions.c::mission_try_at_enter
// when the party stands on the castle tile (data/world.json5 ydarg.entry)
// and presses E. The MG_SPECIAL_EQ guard kind splits on the silverkey
// special so the three arms (ruin / no_key / entry) live as separate
// trigger entries instead of the historical chain of early-returns at
// the top of ydarg().
//
// Text records under data/world/texts/ydarg.json5 — the resolver finds
// `ydarg.<name>` first, then falls back to the leaf-name lookup.
//
// `ruin` and `no_key` end with clr_map_window + update_map (matching
// the legacy returns); `entry` is still the §17 / §23.J C body (the
// per-room walkthrough + confrontation hasn't been lifted yet).
{
  // silverkey == 2 — castle has been beaten, party returns to ruins.
  // No approach narration; the legacy block fires `ruin` immediately
  // and exits.
  ruin: [
    { engine_call: 'clr_map_window' },
    { engine_call: 'blitgfx', args: [14] },
    { engine_call: 'clw' },
    { screen: 'ruin' },
    { engine_call: 'clr_map_window' },
    { engine_call: 'update_map' },
    { engine_call: 'clw' },
  ],

  // silverkey == 0 — party hasn't found the key yet. Run the full
  // approach + Jaara narration (shared with the entry arm) then the
  // no_key rejection screen and return to wilderness.
  no_key: [
    { engine_call: 'clr_map_window' },
    { engine_call: 'blitgfx', args: [14] },
    { engine_call: 'clw' },
    { screen: 'approach' },
    { screen: 'jaara_form' },
    { screen: 'jaara_speech' },
    { emit: 'no_key' },
    { wait_input: true },
    { engine_call: 'clr_map_window' },
    { engine_call: 'update_map' },
  ],

  // silverkey == 1 (legitimate entry) intro: clr_map_window +
  // blitgfx + the four narration screens (approach / jaara_form /
  // jaara_speech / key_accepted / enter) followed by the door-slams
  // screen which delays 2000ms before falling through to the per-
  // floor walk-through. ydarg() invokes this as `play_script("ydarg.intro")`
  // before the room-init + while-loop dispatcher.
  intro: [
    { engine_call: 'clr_map_window' },
    { engine_call: 'blitgfx', args: [14] },
    { engine_call: 'clw' },
    { screen: 'approach' },
    { screen: 'jaara_form' },
    { screen: 'jaara_speech' },
    { screen: 'key_accepted' },
    { screen: 'enter' },
    { emit: 'door_slams' },
    { pause: 2000 },
    { engine_call: 'clw' },
  ],

  // §23.H: per-room (case 1) monster encounter. ydarg() owns the
  // room[xl][yl] = 0 write before invoking the script (the room grid
  // is C-side state, not yet hoisted). The body is exactly the legacy
  // case-1 chain: announce the encounter, ryl_delay 1500, run a deep-
  // tier encounter (non-mandatory — fleeing is allowed), redraw the
  // castle backdrop.
  room_monster: [
    { emit: 'ydarg.room.monster' },
    { pause: 1500 },
    { encounter: { tier: 'deep' } },
    { engine_call: 'clr_map_window' },
    { engine_call: 'blitgfx', args: [14] },
    { engine_call: 'clw' },
  ],

  // §23.J cmd-dispatch lift — character commands run after the
  // direction-key move attempt in the per-floor while(1) driver.
  // Each command is a single engine_call to its existing C entry
  // point (help / armouroff / weaponoff / drop / weaponr / armourr
  // / quaff / spell). The (V)iew-party command is its own backer
  // (ydarg_view_command) because its inner key-wait loop has no
  // clean DSL idiom — digit-in-range OR Q OR A predicates plus a
  // conditional show / show-all branch over the matched key.
  //
  // The script receives the uppercased key as binding `c` (ASCII
  // code via ryl_bind value→atoi). Unmatched keys fall through
  // the switch silently — that's the legacy semantics where every
  // non-direction non-command keypress is a no-op pass.
  cmd_dispatch: [
    { switch: { expr: { var: 'c' }, cases: [
      { match: '?', then: [{ engine_call: 'help' }] },
      { match: 'T', then: [{ engine_call: 'armouroff' }] },
      { match: 'P', then: [{ engine_call: 'weaponoff' }] },
      { match: 'L', then: [{ engine_call: 'drop' }] },
      { match: 'W', then: [{ engine_call: 'weaponr' }] },
      { match: 'R', then: [{ engine_call: 'armourr' }] },
      { match: 'Q', then: [{ engine_call: 'quaff' }] },
      { match: 'Z', then: [{ engine_call: 'spell', args: [0] }] },
      { match: 'V', then: [{ engine_call: 'ydarg_view_command' }] },
    ] } },
  ],

  // §23.J nav-render lift — runs after the room-case dispatcher
  // each iteration. clw + statusline + the three coords/level/floor
  // lines + the compass (north or no_north top, east_west /
  // east-only / west-only mid, south bottom). Bindings xl/yl/lvl
  // come from engine_int reads of the module-level state. The
  // legacy `tx("You are at %dx%d.\r\n\r\n", xl, yl, lvl)` had a
  // stray third arg silently dropped by printf — the lift produces
  // identical bytes via the two-line text `coords` array (no lvl
  // placeholder) so the original silent-drop behavior is preserved.
  // Compass-line texts are one or two lines apiece so each emit
  // produces the same per-line CSI right-jump count as the legacy
  // tx0(res_text(...)) calls did.
  nav_render: [
    { engine_call: 'clw' },
    { engine_call: 'statusline' },
    { let: 'xl', value: { engine_int: 'ydarg_get_xl' } },
    { let: 'yl', value: { engine_int: 'ydarg_get_yl' } },
    { let: 'lvl', value: { engine_int: 'ydarg_get_lvl' } },
    { let: 'map_size', value: { engine_int: 'ydarg_get_map_size' } },
    { emit: 'ydarg.nav.coords' },
    { emit: 'ydarg.nav.level' },
    { emit_indexed: { fmt: 'ydarg.nav.floor_{}', value: { var: 'lvl' } } },
    { let: 'n', value: { gt: [{ var: 'yl' }, 1] } },
    { let: 'w', value: { gt: [{ var: 'xl' }, 1] } },
    { let: 'e', value: { lt: [{ var: 'xl' }, { var: 'map_size' }] } },
    { let: 's', value: { lt: [{ var: 'yl' }, { var: 'map_size' }] } },
    { if: { cond: { var: 'n' }, then: [{ emit: 'ydarg.nav.north' }], else: [{ emit: 'ydarg.nav.no_north' }] } },
    { if: { cond: { and: [{ var: 'e' }, { var: 'w' }] }, then: [{ emit: 'ydarg.nav.east_west' }] } },
    { if: { cond: { and: [{ var: 'e' }, { eq: [{ var: 'w' }, 0] }] }, then: [{ emit: 'ydarg.nav.east' }] } },
    { if: { cond: { and: [{ eq: [{ var: 'e' }, 0] }, { var: 'w' }] }, then: [{ emit: 'ydarg.nav.west' }] } },
    { if: { cond: { var: 's' }, then: [{ emit: 'ydarg.nav.south' }] } },
  ],

  // §23.J case-50 (stairs) lift. The legacy body is one outer
  // mage-loop wrapping three keypress arms (T/G/L) + an inner
  // give-digit menu. Lifted shape:
  //   1. clw + intro narration + 1500ms delay + clw + mage_offer
  //      + wait_input.
  //   2. Outer loop: clw + emit menu, then a silent inner loop
  //      that menu_branches over T/G/L (no prompt) until the user
  //      hits one. choice is the ASCII of the matched key.
  //      - L: clw + leave + 1000ms + decrement yl + break outer.
  //      - T: invoke ydarg_teleport_exit (vortex/outside/redraw +
  //        sets exit_requested) + break outer; the C while(1)
  //        sees exit_requested and returns out of ydarg().
  //      - G: clw + give_menu + silent inner loop over digits 1..5
  //        (key_var binds the digit's ASCII), then call
  //        ydarg_stairs_try_give(d-48). On success: clw + grateful
  //        + pause + clw + (xl,yl)=(1,1) + lvl++; if lvl==5 invoke
  //        ydarg.confrontation script. Then break the outer loop.
  //        On reject the helper has already emitted the rejection
  //        message + delayed; the outer loop iterates and re-prints
  //        the menu.
  //
  // exit_requested is the side-channel for the (T)eleport return —
  // a DSL break only exits the script's own loop, not the C
  // while(1), so the helper sets a flag and the C driver tests it
  // post-script. Apart from that single edge, the script keeps the
  // identical ordering (and thus the identical CSI / delay / RNG
  // bytes) as the legacy case-50 body.
  case_stairs: [
    { engine_call: 'clw' },
    { emit: 'ydarg.room.stairs.intro' },
    { pause: 1500 },
    { engine_call: 'clw' },
    { emit: 'ydarg.room.stairs.mage_offer' },
    { wait_input: true },
    { loop: [
      { engine_call: 'clw' },
      { emit: 'ydarg.room.stairs.menu' },
      { let: 'choice', value: 0 },
      { loop: [
        { menu_branch: {
          key_var: 'choice',
          options: [
            { keys: ['T', 'G', 'L'], then: [{ break: true }] },
          ],
        } },
      ] },
      { if: { cond: { eq: [{ var: 'choice' }, 'L'] }, then: [
        { engine_call: 'clw' },
        { emit: 'ydarg.room.stairs.leave' },
        { pause: 1000 },
        { engine_call: 'ydarg_set_yl', args: [{ sub: [{ engine_int: 'ydarg_get_yl' }, 1] }] },
        { break: true },
      ] } },
      { if: { cond: { eq: [{ var: 'choice' }, 'T'] }, then: [
        { engine_call: 'ydarg_teleport_exit' },
        { break: true },
      ] } },
      // choice == 'G' (the menu_branch only matches T/G/L; if neither
      // L nor T fired we know it's G).
      { engine_call: 'clw' },
      { emit: 'ydarg.room.stairs.give_menu' },
      { let: 'd', value: 0 },
      { loop: [
        { menu_branch: {
          key_var: 'd',
          options: [
            { key_range: ['1', '5'], then: [{ break: true }] },
          ],
        } },
      ] },
      { if: { cond: { engine_int: 'ydarg_stairs_try_give', args: [{ sub: [{ var: 'd' }, 48] }] }, then: [
        { engine_call: 'clw' },
        { emit: 'ydarg.room.stairs.mage_grateful' },
        { wait_input: true },
        { engine_call: 'clw' },
        { engine_call: 'ydarg_set_xl', args: [1] },
        { engine_call: 'ydarg_set_yl', args: [1] },
        { engine_call: 'ydarg_set_lvl', args: [{ add: [{ engine_int: 'ydarg_get_lvl' }, 1] }] },
        { if: { cond: { eq: [{ engine_int: 'ydarg_get_lvl' }, 5] }, then: [
          { play_script: 'ydarg.confrontation' },
        ] } },
        { break: true },
      ] } },
    ] },
  ],

  // §23.J case-3 (treasure) lift. Dispatcher shape:
  //   1. Clear the room slot.
  //   2. Roll the item id off ydarg.drop_tables.room via the
  //      ydarg_treasure_roll backer (the two-step gate / kind /
  //      lo/hi RNG draw stays in C because the gate_max draw is
  //      RNG-identity sensitive and the per-branch ordering is
  //      verbatim-preserving).
  //   3. Bind {object} via engine_bind 'object', emit the find
  //      narration. Use menu_branch (tx_fmt + key, no clw / pause)
  //      to dispatch the (T)ake / (L)eave choice — anything other
  //      than T falls through silently. On (T)ake: invoke the
  //      inv_add op, emitting taken on success or clw + full +
  //      delay 800 on a full inventory.
  case_treasure: [
    { engine_call: 'ydarg_clear_room_at_cur' },
    { let: 'item_id', value: { engine_int: 'ydarg_treasure_roll' } },
    { engine_bind: { fn: 'object', args: [{ var: 'item_id' }], var: 'object' } },
    { emit: 'ydarg.room.treasure.find' },
    { menu_branch: {
      prompt: 'ydarg.room.treasure.menu',
      options: [
        { key: 'T', then: [
          { inv_add: {
            item: { var: 'item_id' },
            added: [
              { emit: 'ydarg.room.treasure.taken' },
              { pause: 800 },
            ],
            full: [
              { engine_call: 'clw' },
              { emit: 'ydarg.room.treasure.full' },
              { pause: 800 },
            ],
          } },
        ] },
      ],
    } },
  ],

  // §23.J case-2 (pitfall) lift. Dispatcher shape:
  //   1. Clear the room slot ("I've been here").
  //   2. Pick a random victim 0..3 (legacy hardcoded — independent
  //      of party_member_max), bind their name, emit "{victim}
  //      springs a / trap!!!", delay 1500ms, clw.
  //   3. Walk every party slot (alive or dead — legacy quirk
  //      preserved); on the first thief, emit "tries to disarm",
  //      pause, ryl_chance(thief.wisdom): on success emit
  //      AND SUCCEEDS! and set disarmed=1, on failure emit
  //      BUT FAILS! Either way break out of the search.
  //   4. If disarmed==0 (no thief OR thief failed), invoke the
  //      ydarg_pitfall_undisarmed_apply backer which picks a random
  //      trap_type from ydarg.pitfall.trap_types, emits its body,
  //      ryl_pauses, and shaves pm_hit_points / damage_div off
  //      every alive member.
  case_pitfall: [
    { engine_call: 'ydarg_clear_room_at_cur' },
    { engine_bind: { fn: 'pa_name', args: [{ random: [0, 3] }], var: 'victim' } },
    { emit: 'ydarg.room.trap.springs' },
    { pause: 1500 },
    { engine_call: 'clw' },
    { let: 'disarmed', value: 0 },
    { for_member: { var: 'm', then: [
      { if: { cond: { engine_int: 'pa_is_class', args: [{ var: 'm' }, 'thief'] }, then: [
        { engine_bind: { fn: 'pa_name', args: [{ var: 'm' }], var: 'thief' } },
        { emit: 'ydarg.room.trap.tries_disarm' },
        { pause: 1500 },
        { if: { cond: { chance: { member: { var: 'm' }, field: 'wisdom' } },
          then: [
            { emit: 'ydarg.room.trap.disarm_succeed' },
            { pause: 1000 },
            { let: 'disarmed', value: 1 },
          ],
          else: [
            { emit: 'ydarg.room.trap.disarm_fail' },
            { pause: 1000 },
          ],
        } },
        { break: true },
      ] } },
    ] } },
    { if: { cond: { eq: [{ var: 'disarmed' }, 0] }, then: [
      { engine_call: 'ydarg_pitfall_undisarmed_apply' },
    ] } },
  ],

  // §23.K: roof-deck confrontation. Lifts the legacy C confrontation()
  // function. Four narration acts bracket two encounter blocks (the
  // 4-monster sequence then Baron Ydarg himself), with the silverkey
  // bump + save persisted between act-3 and act-4 so a kill-after-save
  // crash still records the win. Final op is ydarg_finalize which
  // appends to heroes.txt and cleanexits — the script has no path back
  // to the caller.
  //
  // {p1_name} is the first party member's display name, bound up
  // front via engine_bind so the narration acts can reference it.
  confrontation: [
    { engine_bind: { fn: 'pa_name', args: [0], var: 'p1_name' } },
    { narrate: 'ydarg.narration.conf_act1' },
    { engine_call: 'clw' },
    { engine_call: 'ydarg_run_seq' },
    { narrate: 'ydarg.narration.conf_act2' },
    { encounter: { foe: 'baron_ydarg', mandatory: true } },
    { narrate: 'ydarg.narration.conf_act3' },
    { engine_call: 'ydarg_record_completion' },
    { narrate: 'ydarg.narration.conf_act4' },
    { engine_call: 'clw' },
    { engine_call: 'ydarg_finalize' },
  ],
}
