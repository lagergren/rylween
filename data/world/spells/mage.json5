// Mage spells. mage.frost runs on the script DSL (`do:` body); the
// other five carry `legacy_effect` pointing at the SE_* case still
// resident in battle.c — those fall off as their behaviour migrates
// (§22 Lane A).
{
  // §22 Lane A: re-port of the legacy frost spell to the script DSL.
  // Order of operations preserves RNG identity — the multiply reads
  // caster.lv first (no RNG), then draws ryl_random(2, 8) once, so
  // the damage roll matches the original `pm_lv * ryl_random(2, 8)`.
  // caster_idx is supplied as a caller binding by battle.c; ask_target
  // binds the picked monster slot into target_idx; engine_bind pa_name
  // lifts the caster's display name into {caster} for the text shards.
  frost: {
    slot: 1, base_cost: 8, name: 'Frost Finger',
    do: [
      { ask_target: 'monster_alive', var: 'target_idx' },
      { let: 'dmg', value: { mul: [
        { member: { var: 'caster_idx' }, field: 'lv' },
        { random: [2, 8] },
      ]}},
      { engine_call: 'clw' },
      { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                       var: 'caster' }},
      { emit: 'battle.spell.frost.chills' },
      { emit: 'battle.spell.frost.damage' },
      { emit: 'battle.spell.frost.damage_pts' },
      { pause: 1600 },
      { mutate: { target: { monster_hp: { var: 'target_idx' } },
                  op: 'sub', value: { var: 'dmg' } }},
      { if: { cond: { lt: [{ monster_hp: { var: 'target_idx' } }, 1] },
              then: [
        { mutate: { target: { monster_hp: { var: 'target_idx' } },
                    op: 'set', value: 0 }},
        { mutate: { target: { monster_dead: { var: 'target_idx' } },
                    op: 'set', value: 1 }},
        { emit: 'battle.killed' },
        { pause: 600 },
      ]}},
    ],
  },
  // §22 Lane A: fire — AOE over every monster slot 1..noc. RNG draws
  // unconditionally per iteration (alive or dead) — preserved verbatim
  // so cloud-of-fire's RNG advances exactly the legacy noc steps.
  // The damage formula is pm_lv(caster) * ryl_random(1, 4); kills
  // emit "...KILLED!" and flip deadc[i].
  fire: {
    slot: 2, base_cost: 25, name: 'Fire Cloud',
    do: [
      { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                       var: 'caster' }},
      { for_monster: { var: 'i', then: [
        { let: 'dmg', value: { mul: [
          { member: { var: 'caster_idx' }, field: 'lv' },
          { random: [1, 4] },
        ]}},
        { if: { cond: { eq: [{ monster_dead: { var: 'i' } }, 0] },
          then: [
            { engine_call: 'clw' },
            { emit: 'battle.spell.fire.burns' },
            { emit: 'battle.spell.fire.points' },
            { pause: 1000 },
            { mutate: { target: { monster_hp: { var: 'i' } },
                        op: 'sub', value: { var: 'dmg' } }},
            { if: { cond: { lte: [{ monster_hp: { var: 'i' } }, 0] },
              then: [
                { mutate: { target: { monster_hp: { var: 'i' } },
                            op: 'set', value: 0 }},
                { emit: 'battle.killed' },
                { pause: 600 },
                { mutate: { target: { monster_dead: { var: 'i' } },
                            op: 'set', value: 1 }},
              ]
            }},
          ]
        }},
      ]}},
    ],
  },
  // §22 Lane A: confusion. Halves monster ws (work-skill) and sets
  // the encounter-local confused flag — both via the battle_flag
  // mutate lvalue. RNG identity: no random draws.
  confusion: {
    slot: 3, base_cost: 17, name: 'Confusion',
    do: [
      { engine_call: 'clw' },
      { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                       var: 'caster' }},
      { emit: 'battle.spell.utters_word' },
      { emit: 'battle.spell.mirror' },
      { pause: 2000 },
      { mutate: { target: { battle_flag: 'ws' }, op: 'div', value: 2 }},
      { mutate: { target: { battle_flag: 'confused' }, op: 'set', value: 1 }},
    ],
  },
  // §22 Lane A: death. Single-target picker via ask_target
  // monster_alive; resist roll is ryl_random(0, 199) < monster_hp,
  // so high-HP targets resist (clamp to 1) and low-HP targets die
  // (deadc=1, mh=0). RNG identity preserved — random draws once
  // as the lt's left operand, monster_hp read on the right (no
  // RNG). Order of writes in the kill arm matches the legacy
  // (deadc=1 first, then mh=0).
  death: {
    slot: 4, base_cost: 78, name: 'Death Strike',
    do: [
      { ask_target: 'monster_alive', var: 'target_idx' },
      { if: { cond: { lt: [
          { random: [0, 199] },
          { monster_hp: { var: 'target_idx' } },
        ]},
        then: [
          { engine_call: 'clw' },
          { emit: 'battle.spell.annihilate.resist' },
          { pause: 2000 },
          { mutate: { target: { monster_hp: { var: 'target_idx' } },
                      op: 'set', value: 1 }},
        ],
        else: [
          { engine_call: 'clw' },
          { emit: 'battle.spell.annihilate.kill' },
          { pause: 2000 },
          { mutate: { target: { monster_dead: { var: 'target_idx' } },
                      op: 'set', value: 1 }},
          { mutate: { target: { monster_hp: { var: 'target_idx' } },
                      op: 'set', value: 0 }},
        ],
      }},
    ],
  },
  // §22 Lane A: hold. Sets the encounter-local held flag; the
  // monster-turn loop in battle.c gates monster actions on !held.
  hold: {
    slot: 5, base_cost: 43, name: 'Hold Enemies',
    do: [
      { engine_call: 'clw' },
      { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                       var: 'caster' }},
      { emit: 'battle.spell.utters_word' },
      { emit: 'battle.spell.hold_enemy' },
      { pause: 2000 },
      { mutate: { target: { battle_flag: 'held' }, op: 'set', value: 1 }},
    ],
  },
  // §22 Lane A: antimagic. Sets the encounter-local antimagic flag;
  // monsters with non-zero sp can't cast while it's set. Note the
  // 2800-ms delay vs confusion/hold's 2000-ms — preserved verbatim.
  antimagic: {
    slot: 6, base_cost: 28, name: 'Anti Magic',
    do: [
      { engine_call: 'clw' },
      { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                       var: 'caster' }},
      { emit: 'battle.spell.utters_word' },
      { emit: 'battle.spell.silence' },
      { pause: 2800 },
      { mutate: { target: { battle_flag: 'antimagic' }, op: 'set', value: 1 }},
    ],
  },
}
