// Priest spells — slot is menu order, legacy_effect picks the SE_* case
// subs.c falls through to when the spell has no `do:` DSL body. As each
// spell's behaviour migrates to a `do:` program, its `legacy_effect` goes
// away and dispatch flips to play_spell_body via the §22 Lane A shim.
{
  // §22 Lane A: heal migrated from SE_HEAL. caster_idx + place arrive as
  // ryl_bind ints from subs.c; ask_target party_member binds the picked
  // target into target_idx. RNG identity preserved — ryl_random(10, 19)
  // is the first factor of the add (drawn once before the lv*2 read),
  // matching the legacy `ryl_random(10, 19) + (pm_lv(caster) * 2)`.
  // Two early-exits — not-enough-mana and target-dead — sit as nested
  // if/else cascades; the script DSL has no `return` op today.
  heal: {
    slot: 1, base_cost: 8, name: 'Healing',
    do: [
      { engine_call: 'clw' },
      { if: { cond: { gte: [
          { member: { var: 'caster_idx' }, field: 'ma' },
          { add: [8, { member: { var: 'caster_idx' }, field: 'lv' }] },
        ]},
        then: [
          { mutate: { target: { member_field: { idx: { var: 'caster_idx' },
                                                field: 'ma' } },
                      op: 'sub',
                      value: { add: [8, { member: { var: 'caster_idx' },
                                                    field: 'lv' }] } }},
          { ask_target: 'party_member', var: 'target_idx' },
          { let: 'x', value: { add: [
            { random: [10, 19] },
            { mul: [{ member: { var: 'caster_idx' }, field: 'lv' }, 2] },
          ]}},
          { if: { cond: { eq: [
              { member: { var: 'target_idx' }, field: 'dead' }, 1
            ]},
            then: [
              { engine_call: 'clw' },
              { emit: 'spell.priest.heal.target_dead' },
              { pause: 600 },
              { engine_call: 'clw' },
            ],
            else: [
              { mutate: { target: { member_field: { idx: { var: 'target_idx' },
                                                    field: 'hp' } },
                          op: 'add',
                          value: { var: 'x' },
                          clamp: { max: { member: { var: 'target_idx' },
                                                    field: 'h' } } }},
              { engine_call: 'clw' },
              { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                               var: 'caster' }},
              { engine_bind: { fn: 'pa_name', args: [{ var: 'target_idx' }],
                               var: 'target' }},
              { emit: 'spell.priest.heal.heals' },
              { emit: 'spell.priest.heal.target' },
              { emit: 'spell.priest.heal.points' },
              { pause: 1500 },
              { engine_call: 'clw' },
            ],
          }},
        ],
        else: [
          { emit: 'spell.not_enough_pts' },
          { pause: 1000 },
          { engine_call: 'clw' },
        ],
      }},
    ],
  },
  // §22 Lane A: restoration. Same shape as heal but skips the random
  // roll and the dead-check — the legacy code unconditionally pegs
  // target.hp to target.h regardless of whether the target is dead.
  restoration: {
    slot: 2, base_cost: 20, name: 'Restoration',
    do: [
      { engine_call: 'clw' },
      { if: { cond: { gte: [
          { member: { var: 'caster_idx' }, field: 'ma' },
          { add: [20, { member: { var: 'caster_idx' }, field: 'lv' }] },
        ]},
        then: [
          { mutate: { target: { member_field: { idx: { var: 'caster_idx' },
                                                field: 'ma' } },
                      op: 'sub',
                      value: { add: [20, { member: { var: 'caster_idx' },
                                                     field: 'lv' }] } }},
          { ask_target: 'party_member', var: 'target_idx' },
          { mutate: { target: { member_field: { idx: { var: 'target_idx' },
                                                field: 'hp' } },
                      op: 'set',
                      value: { member: { var: 'target_idx' }, field: 'h' } }},
          { engine_call: 'clw' },
          { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                           var: 'caster' }},
          { engine_bind: { fn: 'pa_name', args: [{ var: 'target_idx' }],
                           var: 'target' }},
          { emit: 'spell.priest.restoration.heals' },
          { emit: 'spell.priest.restoration.target' },
          { emit: 'spell.priest.restoration.fully' },
          { pause: 1500 },
          { engine_call: 'clw' },
        ],
        else: [
          { emit: 'spell.not_enough_pts' },
          { pause: 1000 },
          { engine_call: 'clw' },
        ],
      }},
    ],
  },
  // §22 Lane A: rebirth. Two early-exit paths nest inside the mana
  // gate: target-already-alive (no mana cost!) and the revival arm
  // (deduct after the dead-check, set dead=0 + hp=1, narrate).
  // Mana stays uncharged when the target is alive — preserved
  // verbatim from the legacy SE_REBIRTH which sets pm_add_ma only
  // inside the dead branch.
  rebirth: {
    slot: 3, base_cost: 90, name: 'Rebirth',
    do: [
      { engine_call: 'clw' },
      { if: { cond: { gte: [
          { member: { var: 'caster_idx' }, field: 'ma' },
          { add: [90, { member: { var: 'caster_idx' }, field: 'lv' }] },
        ]},
        then: [
          { ask_target: 'party_member', var: 'target_idx' },
          { engine_bind: { fn: 'pa_name', args: [{ var: 'target_idx' }],
                           var: 'target' }},
          { if: { cond: { eq: [
              { member: { var: 'target_idx' }, field: 'dead' }, 1 ]},
            then: [
              { mutate: { target: { member_field: { idx: { var: 'caster_idx' },
                                                    field: 'ma' } },
                          op: 'sub',
                          value: { add: [90, { member: { var: 'caster_idx' },
                                                         field: 'lv' }] } }},
              { mutate: { target: { member_field: { idx: { var: 'target_idx' },
                                                    field: 'dead' } },
                          op: 'set', value: 0 }},
              { mutate: { target: { member_field: { idx: { var: 'target_idx' },
                                                    field: 'hp' } },
                          op: 'set', value: 1 }},
              { engine_call: 'clw' },
              { engine_bind: { fn: 'pronoun',
                               args: [{ var: 'target_idx' }, 'subject'],
                               var: 'tgt_subj' }},
              { engine_bind: { fn: 'pronoun',
                               args: [{ var: 'target_idx' }, 'possessive'],
                               var: 'tgt_poss' }},
              { emit: 'spell.priest.rebirth.eyelids' },
              { emit: 'spell.priest.rebirth.flicker' },
              { emit: 'spell.priest.rebirth.opens_eyes' },
              { pause: 1700 },
              { engine_call: 'clw' },
            ],
            else: [
              { emit: 'spell.priest.rebirth.alive' },
              { emit: 'spell.priest.rebirth.healthy' },
              { pause: 1500 },
            ],
          }},
        ],
        else: [
          { emit: 'spell.not_enough_pts' },
          { pause: 1000 },
          { engine_call: 'clw' },
        ],
      }},
    ],
  },
  // §22 Lane A: banish. Three exit shapes — not-enough-mana,
  // not-in-dungeon (place != 1), and the successful banishing arm
  // that ends with state.banished = 1 (mutate state_banished). The
  // wait_input op replaces ryl_pause(); the place check stays
  // gated on the int binding from subs.c.
  banish: {
    slot: 4, base_cost: 85, name: 'Banish Evil',
    do: [
      { engine_call: 'clw' },
      { if: { cond: { gte: [
          { member: { var: 'caster_idx' }, field: 'ma' },
          { add: [85, { member: { var: 'caster_idx' }, field: 'lv' }] },
        ]},
        then: [
          { if: { cond: { eq: [{ var: 'place' }, 1] },
            then: [
              { mutate: { target: { member_field: { idx: { var: 'caster_idx' },
                                                    field: 'ma' } },
                          op: 'sub',
                          value: { add: [85, { member: { var: 'caster_idx' },
                                                         field: 'lv' }] } }},
              { engine_call: 'clw' },
              { engine_bind: { fn: 'pa_name', args: [{ var: 'caster_idx' }],
                               var: 'caster' }},
              { engine_bind: { fn: 'pronoun',
                               args: [{ var: 'caster_idx' }, 'subject'],
                               var: 'csr_subj' }},
              { engine_bind: { fn: 'pronoun',
                               args: [{ var: 'caster_idx' }, 'possessive'],
                               var: 'csr_poss' }},
              { emit: 'spell.priest.banish.raises_hands' },
              { emit: 'spell.priest.banish.divine_power' },
              { emit: 'spell.priest.banish.between_palms' },
              { emit: 'spell.priest.banish.suddenly_clasps' },
              { emit: 'spell.priest.banish.over_head' },
              { emit: 'spell.priest.banish.thunder' },
              { wait_input: true },
              { engine_call: 'clw' },
              { mutate: { target: { state_banished: 1 },
                          op: 'set', value: 1 }},
            ],
            else: [
              { emit: 'spell.priest.banish.no_target1' },
              { emit: 'spell.priest.banish.no_target2' },
              { emit: 'spell.priest.banish.no_target3' },
              { emit: 'spell.priest.banish.no_target4' },
              { wait_input: true },
              { engine_call: 'clw' },
            ],
          }},
        ],
        else: [
          { emit: 'spell.not_enough_pts' },
          { pause: 1000 },
          { engine_call: 'clw' },
        ],
      }},
    ],
  },
  revelation:  { slot: 5, base_cost: 40, name: 'Revelation',  legacy_effect: 'revelation' },
  teleport:    { slot: 6, base_cost: 35, name: 'Teleport',    legacy_effect: 'teleport' },
  earthquake:  { slot: 7, base_cost: 55, name: 'Earthquake',  legacy_effect: 'earthquake' },
}
