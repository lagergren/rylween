// §20 L2: dungeon level-event texts. Authored alongside scripts at
// data/world/scripts/dungeon.json5; resolve_text_id resolves
// `dungeon.<name>` from each script via the script-id → parent
// fallback. Array entries get CRLF appended per fold_texts.
{
  // case 6 — empty level (variant a).
  nothing_a: [
    'You find nothing',
    'special on this level.',
    '',
  ],

  // case 7 — empty level (variant b).
  nothing_b: [
    'This level is empty.',
    '',
  ],

  // case 26 — Spectrum-Message plaque on the wall (Reebar's Tomb).
  spectrum_message: [
    'A message on the wall',
    'reads:',
    '',
    "'M U R T C E P S'",
    "THiNgs aren't aLways iN",
    'theIR naTuRAl oRDeR...',
    '',
  ],

  // case 21 — Fire Shield pedestal narration.
  fire_shield: [
    'After you have bested',
    'the foul thing, the',
    'dungeon is strangely',
    'quiet. Upon entering',
    'this level, you find the',
    'marvelous FIRE SHIELD on',
    'a pedestal! You take it.',
    '',
  ],

  // case 25 — Bracelets of Thun chamber narration.
  bracelets: [
    'This whole chamber',
    'shines of a bright',
    'white light! On a',
    'table before you,',
    'lie the fabled',
    'Bracelets of Thun!',
    'The glow fades as',
    'you put them in your',
    'backpack.',
    '',
  ],

  // case 28 — Nolrim's tomb (the dagger you seek).
  nolrim_tomb: [
    "Nolrim's body rests on",
    'a stone slab in this room.',
    'On his chest lies the',
    'dagger you seek. You put',
    'it in your backpack.',
    '',
  ],

  // case 2 — random gold pile narration.
  gold: [
    'You find {amount}',
    'gold pieces.',
    '',
  ],

  // case 9 — torch find narration.
  torches: [
    'You find {n} torches.',
    '',
  ],

  // case 20 — Fire Shield Guardian opening.
  fire_shield_guardian: [
    'As you enter this level',
    'you hear a horrible',
    'evil laughter.',
    'Suddenly!',
    'Out of the shadows,',
    'something HIDEOUS',
    'emerges.',
    '',
  ],

  // case 29 — Master Crown two-screen flow.
  master_crown: {
    intro: [
      'FINALLY! In the hands of',
      'a long dead warrior, who',
      'is placed like a statue',
      'by the east wall of this',
      'chamber, is the Master',
      'Crown. The most powerful',
      'object in the realm.',
      'It shines with an inner',
      'light.',
      '',
    ],
    warrior_alive: [
      '...but as you take it,',
      'THE WARRIOR COMES',
      'TO LIFE!!!',
      '',
    ],
  },

  // case 31 — Hobgoblin patrol (attack + drop note).
  hobgoblin_patrol: {
    attack: [
      'You bump into a hobgoblin',
      'patrol. With shiny and',
      'well used scimitars, they',
      'attack you!',
      '',
    ],
    password: [
      'You find a scribbled',
      'note on the leader:',
      "Password: 'RISH EKKIN'",
      '',
    ],
  },

  // case 32 — Royal Guard 1 (skeletons).
  royal_guard1: [
    'As you enter this room',
    'an army of hobgoblin',
    'skeletons attack you!',
    '',
  ],

  // case 33 — Royal Guard 2 (undead hobgoblins).
  royal_guard2: [
    'As you enter this room',
    'an army of undead',
    'hobgoblins, smelling',
    'of rotting flesh and',
    'brandising gleaming',
    'tridents attack you.',
    '',
  ],

  // case 35 — Orc nest three-stage flow.
  orc_nest: {
    guarding: [
      'Some orcs watch a trapdoor',
      'in the floor here. As',
      'you enter, they attack!',
      '',
    ],
    more: [
      'The last of the guardians',
      'lie dead. Suddenly, more',
      'orcs rush out of their',
      'sleeping quarters,',
      'disturbed by the noise.',
      '',
    ],
    slain: [
      'You have slain the orcs.',
      '',
    ],
  },

  // case 37 — Erethor priests (recurring ambush).
  erethor_priests: [
    'You are spotted by',
    'some priests. They',
    'attack you with blind',
    'fury.',
    '',
  ],

  // ----- Thun riddles -----
  // Shared pieces used by all three: the "Answer: " prompt is a
  // verbatim string (no trailing CRLF — getstr reads on the same
  // line); pass / fail screens are identical text across riddles.
  thun_riddle: {
    prompt: 'Answer: ',
    pass: [
      '- Well done. Pass.',
      '',
    ],
    fail: [
      '- FOOLS! Meet thy doom!',
      'at a gesture from him,',
      'something evil appears.',
      '',
    ],
  },

  // Riddle 1 — red mage, fire/ice/water.
  thun_riddle1: {
    intro: [
      'You stand before a',
      'mage dressed entirenly',
      'in red.',
      '',
      '- Answer this, fools, or',
      '  die where you stand!',
      '',
    ],
    riddle: [
      "'Between fire and ice,",
      'who ends the fight?',
      'Who stands between those',
      'two? Not red, not white',
      'but blue!',
      '',
    ],
  },

  // Riddle 2 — green mage, siblings/night/darkness.
  thun_riddle2: {
    intro: [
      'You stand before a',
      'mage dressed entirenly',
      'in green.',
      '',
      '- Answer this, fools, or',
      '  die where you stand!',
      '',
    ],
    riddle: [
      "'Siblings we are,",
      "I'm black and she's",
      'white. Each dreary',
      'evening, I swallow her',
      "light.'",
      '',
    ],
  },

  // Riddle 3 — blue mage, well.
  thun_riddle3: {
    intro: [
      'You stand before a',
      'mage dressed entirenly',
      'in blue.',
      '',
      '- Answer this, fools, or',
      '  die where you stand!',
      '',
    ],
    riddle: [
      "'Tall as a house,",
      'round as a cup, and',
      "all the king's horses",
      "can't draw me up! What",
      "am I?'",
      '',
    ],
  },

  // case 1 — Find an object. {name} is the engine-bound object()
