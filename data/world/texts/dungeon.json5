    password_prompt: 'Password: ',
    step_inside: [
      '- Step inside and identify',
      'yourself. You do so. The',
      'hobgoblin chief eyes you',
      'suspiciously for a few',
      'seconds. Not hestitating',
      'a moment you attack.',
      '',
