      'attack you!',
      '',
    ],
    password: [
      'You find a scribbled',
      'note on the leader:',
      "Password: 'RISH EKKIN'",
      '',
    ],
  },

  // case 32 — Royal Guard 1 (skeletons).
  royal_guard1: [
    'As you enter this room',
    'an army of hobgoblin',
    'skeletons attack you!',
    '',
  ],

  // case 33 — Royal Guard 2 (undead hobgoblins).
  royal_guard2: [
    'As you enter this room',
    'an army of undead',
    'hobgoblins, smelling',
