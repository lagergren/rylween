// NPC chat (speak.c) — static text moved out of src/speak.c. Every
// remaining tx() in speak.c is either a %s/%d/%c format (NPC name, town
// name, coord, gold price, job count) or a bare "\r\n" layout spacer
// between chunks. Paragraph blocks split on ryl_pause() boundaries are
// separate keys since clw() wipes the screen between them.
//
// Layout conventions match driv.json5 / ydarg.json5:
//   - array-of-strings => each line joined with CRLF + trailing CRLF
//   - plain string     => verbatim (used when no trailing CRLF)
//   - {placeholder}    => resolved at call time by tx_fmt() (§16.3);
//                         replaces the _pre/_post split used earlier.
//
// speak.c is not on any replay-fixture path (fixtures don't speak() an
// NPC), so byte-stream parity wasn't required — grouped keys drop
// redundant CSI-right jumps that the terminal would no-op anyway.
{
  // --- speak() top-level --------------------------------------------

  // Empty-building guard: no NPC at the current (bld,twn).
  no_npc: ['Noone is here!'],

  // Recognition nod, split around the "%s nods as\r\n" line that stays
  // inline in speak.c so res_enum("name", talk) can fill the NPC name.
  recognize_he:  ['he recognizes you.'],
  recognize_she: ['she recognizes you.'],

  // Main chat header + four-option menu. {npc_name} folds in the
  // current interlocutor via tx_fmt (§16.3).
  chatting: ['Chatting with',
             '{npc_name}:',
             ''],
  menu: ['(C)hitchat',
         '(Q)uestion',
         '(R)umors',
         '(B)ye'],

  // "R" branch, second + visit: rumours already told.
  no_rumour: ["- Sorry. There's",
              'nothing new I can',
              'tell you.',
              ''],

  // --- chitchat prompts + replies -----------------------------------

  // "C" branch prompts (ryl_random picks one of 3). Jobs 13 (whore)
  // vs. the rest use the f/m variants of well/health.
  chit: {
    well_f:    ['- You look well today,', '  miss...'],
    well_m:    ['- You look well today,', '  Sir...'],
    weather:   ["- Nice weather we're", '  having...'],
    health_f:  ['- Is all well with', '  you, miss?'],
    health_m:  ['- Is all well with', '  you, Sir?'],

    // reply_chitchat() — 3 subjects (well/weather/health) x 16 jobs.
    // One key per (subject, job). Empty jobs in the original switch
    // (there are none — all 16 cases are populated for each subject)
    // would map to a missing key; res_text returns "" in that case.
    reply: {
      well: {
        jmerchant:  ['- Thanks, and the same', 'to you!'],
        jranger:  ['- I do? Really? Are', "you gay or smth'n?"],
        jfighter:  ['- Thank you. My health', 'is slowly returning', 'after a hard battle.'],
        jwizard:  ['- Aha?'],
        jpriest:  ['- You too, my son.'],
        jthief:  ['- What? No! Sccch!', 'They can hear you.'],
        jpeasant:  ['- Thank you! You too.'],
        jbard:  ['- That inspires me.', "I'll compose a song", 'about you!'],
        jdrifter:  ['- YEAH? Take that!'],
        jhalf_orc: ['- ME NOT LOOK WELL!', 'ME BIG AND UGLY!'],
        jhalf_elf: ['- Oh...'],
        jsmith: ['- I thank thee, my lad!'],
        jbargirl: ['- You too, honey!'],
        jinnkeeper: ['- The same to you.'],
        jtavernkeeper: ["- You've had to much", 'to drink, boy?'],
        jhermit: ['- It is written in the', 'scrolls of Skelos...'],
      },
      weather: {
        jmerchant:  ['- I think it will rain.'],
        jranger:  ['- Not a fine weather for', 'tracking, mind you!'],
        jfighter:  ['- Yeah! But my armour', 'gets quite rusty.'],
        jwizard:  ['- Really?'],
        jpriest:  ['- The gods have been', 'kind to us, my son!'],
        jthief:  ['- Perfect weather', 'for stealing!'],
        jpeasant:  ['- Yeah, the crops grow', 'better than ever.'],
        jbard:  ['- This rain really', 'inspires me. (He', 'starts singing).'],
        jdrifter:  ['- Hehehehe...'],
        jhalf_orc: ["- YEAH! NICE'N SLIMY!"],
        jhalf_elf: ['- I find it depressing.'],
        jsmith: ['- Well, kinda good.'],
        jbargirl: ["- Let's not talk about", 'the weather, honey?'],
        jinnkeeper: ["- Well. Can't complain."],
        jtavernkeeper: ['- Want a drink, sonny?'],
        jhermit: ['- Yes, a day like this', 'is destined to come!'],
      },
      health: {
        jmerchant:  ["- All's well, thanks."],
        jranger:  ["- I'm fine."],
        jfighter:  ['- Yep.'],
        jwizard:  ['- Health... yes.'],
        jpriest:  ['- All is well, my son.'],
        jthief:  ['- Yeh, quite nice.'],
        jpeasant:  ['- Are you a fag?'],
        jbard:  ['- Yes. I will sing', 'a song of health', 'for you!'],
        jdrifter:  ['(He chuckles under', 'his breath).'],
        jhalf_orc: ['- ME JUST FINE!'],
        jhalf_elf: ['- Very well, thanks.'],
        jsmith: ['- Fine, laddie!'],
        jbargirl: ['- Sure, honey!'],
        jinnkeeper: ['- Well...'],
        jtavernkeeper: ['- Just fine. Do you', 'want something to', 'drink?'],
        jhermit: ['- Oh. Meneth Sabaoth.'],
      },
    },
  },

  // --- "Q" branch: (L)odging / (M)agic / (P)eople / (N)othing -------

  question: ['(L)odging', '(M)agic', '(P)eople', '(N)othing'],

  // "(P)eople" — 16 per-job canned replies. j8 embeds a fighter's
  // name via {fighter_name} in the middle of the text.
  people: {
    jmerchant:       ["- Well, I don't know", 'that many people.'],
    jranger:       ["- No I'm a lone ranger."],
    jfighter:       ['- Well, I met this', 'merchant who seeks', 'revenge on a band of', 'bandits.'],
    jwizard:       ['- OH! Well... not really.'],
    jpriest:       ["- I've heard of a hermit", 'who lives in the swamps', 'by Ollk. Perhaps he can', 'help you.'],
    jthief:       ['- No. Sorry. Dunno.'],
    jpeasant:       ["- I think it's time", 'someone found the', 'Foot of Jazzy and', 'defeated Ydarg!'],
    jbard:       ['- Rumour has it that a', 'fighter called', '{fighter_name}', 'has a mission for you.'],
    jdrifter:       ["- Don't know anyone."],
    jhalf_orc:      ['- ME ALONE AND STRONG!'],
    jhalf_elf:      ['- There are many huts', 'in the wilderness.'],
    jsmith:      ["- Sorry, can't help ya."],
    jbargirl:      ['- Well...'],
    jinnkeeper:      ['- Want to meet interesting', 'travellers? Try the', 'inn or the tavern.'],
    jtavernkeeper:      ["- Don't know about", 'anyone particular.'],
    jhermit:      ['- Many faces shine', 'through the mist.'],
  },

  // "(M)agic" — 16 per-job canned replies. All pure-literal.
  magic: {
    jmerchant:  ['- It is said that the', 'Master Crown is the', 'most powerful object', 'in the realm.'],
    jranger:  ['- You will need five', 'magical items to', 'defeat baron Ydarg.'],
    jfighter:  ["- What? I don't believe", 'in magic...'],
    jwizard:  ['- Magic... Yes, Magic.'],
    jpriest:  ['- Yes my son, but we', 'are all puny beings', 'compared to the gods.'],
    jthief:  ['- I know nothing of it.'],
    jpeasant:  ["- I don't know much about", 'magic. Gems often have', 'magical properties,', 'though.'],
    jbard:  ['- Magic is the subject', 'of many of my songs.', 'Ballad of the Fire', 'Shield, for instance.'],
    jdrifter:  ['- GO AWAY!'],
    jhalf_orc: ['- ME HAVE TRUSTY SWORD!', "ME NOT CARE 'BOUT", 'MAGIK!'],
    jhalf_elf: ['- Yes, my people were', 'created from the magic', 'of mother earth.'],
    jsmith: ['- Rumour has it, that', 'some ogres have the foot', 'of Jazzy, a powerful', 'item.'],
    jbargirl: ['- I know nothing about', 'that.'],
    jinnkeeper: ['- Magic? Well, they say', 'that baron Ydarg can', 'be defeated only by', 'aid of the Silver Key'],
    jtavernkeeper: ["- Sorry. Can't help you."],
    jhermit: ['- The Crown, the Shield,', 'the Bracelets and the Foot', 'is all you need.'],
  },

  // "(L)odging" — 16 per-job canned replies. j13 is the whore branch
  // with {price} embedded in the offer + broke + spent.
  lodge: {
    jmerchant:  ['- Well. The city inn is', 'a good try.'],
    jranger:  ['- I sleep under the open', 'skies. Just beware of', 'bandits if you do this!'],
    jfighter:  ['- Well. I usually stay at', "the inn when I'm in town."],
    jwizard:  ['- Oh??? Eternal sleep!'],
    jpriest:  ['- I hire a room at', 'the inn to meditate!'],
    jthief:  ['- I sleep in the shadows.'],
    jpeasant:  ['- I sleep in my own', 'room at my farm.'],
    jbard:  ['- Imagine the beauty', 'and danger to camp in', 'the wilderness these days.'],
    jdrifter:  ["- Look, why don't you", 'just _GO AWAY_???'],
    jhalf_orc: ['- ME NEVER GET TIRED!'],
    jhalf_elf: ['- I rent a room at the inn!'],
    jsmith: ['- Well, sleeping at the', 'inn is often nicer than', 'in the wilderness.'],

    // jbargirl: whore. Price is 50 * lv[1] — {price} in the middle of the offer.
    jbargirl: {
      offer:      ['- Would you like to,', '  spend an hour', '  upstairs for {price}', '  gold coins?', ''],
      broke:      ['- No money, eh?', "  don't bother", '  to come back!'],
      spent:      ['You spend a very', 'exhausting hour', 'upstairs.', '(PERVERT!) ;-)', ''],
    },
    jinnkeeper: ['- Well. My inn is the', 'best in the realm!'],
    jtavernkeeper: ['- I dunno, try my', "brother's inn."],
    jhermit: ['- Yes. You are indeed', 'the one...'],
  },

  // Shared "(B)uy it / (N)o thanks" prompt (cases 6 + 13 of flaggkoll).
  buy_nothanks: ['(B)uy it', '(N)o thanks'],

  // --- flaggkoll(): per-NPC mission dialogue ------------------------

  // case 1 — robbed merchant.
  merchant: {
    offer:      ['In fact, I have a mission', 'for you. It will bring', 'you much gold!', ''],
    bandits:    ['I was robbed by bandits', 'just to the east of here.', 'If you find these bandits,', 'kill them, and return', 'my cargo here, I\'ll pay', 'you 2000 gold and a ruby', 'my grandfather gave me.', ''],
    grateful:   ['The merchant is GRATEFUL!', 'He pays you 2000 gold and', 'hands you a red gem.', ''],
    cant_carry: ["You can't carry the gem."],
    picked_up:  ['You pick up the gem.'],
  },

  // case 2 — ranger with letter. {ranger_name} + {ranger_loc} are
  // filled in by tx_fmt at call time.
  ranger: {
    intro:    ['- Greetings, adventurers.', 'I have a mission for you.', 'He hands you a letter.', ''],
    deliver:  ['- If you deliver this',
               'to my brother, {ranger_name},',
               'who lives {ranger_loc},',
               'he will give you',
               'a great weapon!',
               ''],
  },

  // case 3 — old fighter with Dancing Blade.
  fighter: {
    intro:      ['- Greetings. Once upon', 'a time, I was a mighty', 'fighter. Before I retired', 'I managed to slay over', 'two hundred orcs. All', 'of this, because of my', 'Dancing Blade. I have', 'no use for this weapon', ''],
    favour:     ['anymore, and I will give',
                 'it to you, if you do me a',
                 'small favour. A priest',
                 'named {priest_name} has got',
                 'one of my books. We are',
                 'old friends, and I lended',
                 'it to him. However, I',
                 "haven't heard much from",
                 'him lately.',
                 ''],
    blade:      ['- Oh! Thank you!!! He', 'removes a floor board', 'and gives you a WONDERFUL', 'blade. It sparkles in', 'the light!', ''],
    cant_carry: ["You can't carry it!!!.", ''],
    take_blade: ['You take the blade.'],
  },

  // case 4 — wizard robbed of book.
  wizard: {
    robbed: ['You persuade him to', 'give you the book.', 'After showing him your', 'sharp weapons, he', 'chickens out and pulls', 'it out of his robe.', 'He throws it at you and', 'flees...', ''],
  },

  // case 5 — priest who lost book. {wizard_name} + {giver_name} are
  // filled in by tx_fmt at call time (the wizard who stole the book
  // and the fighter to return it to, respectively).
  priest: {
    intro:  ['When you mention the',
             'book, he nods and looks',
             'a bit embarrased.',
             '- Yes, I know. I happened',
             'to lose it. A wizard',
             'called {wizard_name} stole it',
             'from my bedroom a week',
             'ago...',
             ''],
    fled:   ['He quickly fled, but I', "know it's him, because", 'he made inquieries about', 'it, and tried to steal', 'it from me when I was', 'having dinner.', ''],
    please: ["I don't know his",
             'whereabouts, but please',
             'find the book and',
             'take it back to {giver_name}',
             'if you can.',
             ''],
  },

  // case 6 — sells the Pit-of-the-Silver-Key map for 50000 gp.
  silver_key: {
    hiss:       ['- There is an item of', 'great power, he hisses.', ''],
    research:   ['- It is called the', 'SILVER KEY. It has taken', 'me many years of research', 'to find its location, and', 'this only to be stopped', 'by a guardian telling me', "that 'only those of pure", "heart can enter'.", ''],
    chased:     ['- I fled for my life as', 'horned creatures chased', 'me through the woods.', ''],
    offer:      ['I have an offer to make', 'thee. I will sell you', 'a map to the location of', 'the SILVER KEY for 50000', 'gold coins. The price is', 'resonable. 10000 gold for', 'each of those fruitless', 'years.', ''],
    deal:       ['- Deal? ', ''],
    broke:      ['- Sorry! 50000! No more', 'no less. Come back when', 'you have the gold.', ''],
    map:        ['He quietly slips you the',
                 'precious map. It',
                 'tells you that the Pit',
                 'of the Key is at',
                 '{pit_x}x{pit_y}!',
                 '',
                 ''],
  },

  // case 8 — poor man trades the Cloak info for Erethor's Lute.
  erethor: {
    rumour:      ['- Rumor has it that', "Erethor's Lute, a", 'musical instrument with', 'magical properties', 'exists somewhere in', 'the realm.', ''],
    demon:       ['- Erethor is a mighty', 'demon...', ''],
    poor_man:    ['- I am a very poor man', 'myself, but I know of', 'the Cloak of Gods,', 'the most powerful of', 'all armours. I will', ''],
    trade:       ['trade this information', "if you find me Erethor's", "Lute. One of Erethor's", 'temples, where mad', 'priests practise', 'blasphemous magic is', 'located at 6x20, near', 'the western peaks.', ''],
    dangerous:   ['- This may be a dangerous', 'mission for such a', 'small reward, but the', "Cloak will make it's", 'bearer almost', 'invulnerable.', ''],
    hand_lute:   ['You hand him the', 'golden lute...', ''],
    // First paragraph ("promise of the deal") — standalone screen.
    note:        ["- I can't believe you", 'actually made it!!!', '- Now for my part of', 'the deal. Listen closely,', 'for I shall say this only', 'once.', ''],
    // Second paragraph — fills {minstrel_name} (res_enum("name", 20))
    // and {minstrel_loc} (fmt_npc_loc: "in <town>" or "at <x>x<y>").
    // The "<name> lives " prefix and trailing period sit in the
    // record so the binding can be the standard fmt_npc_loc output
    // used everywhere else (§16.5 data-driven bindings).
    note_deliver:['- Take this note here',
                  'and seek out my friend',
                  '{minstrel_name}. He is also a',
                  'minstrel.',
                  '{minstrel_name} lives {minstrel_loc}.',
                  ''],
    together:    ['- We used to travel', 'together and he found', 'the Cloak in a long dead', "hero's tomb. Now that", 'we have the Lute, the', 'Cloak is yours. Just', 'deliver this explaining', 'note!', ''],
    paper:       ['He hands you a piece of', 'paper and bids you', 'farewell.', ''],
  },

  // case 13 — sells the Temple-of-Thun map for 10000 gp.
  thun: {
    legend:   ['- I have a map of the', 'road to the temple of', 'Thun! The legend says', 'it keeps the Bracelets', 'of Thun, which is one of', 'the objects that can', 'destroy baron Ydarg!', ''],
    offer:    ['- I will sell it to you', 'for 10000 gold pieces!', ''],
    broke:    ['- Sorry! 10000! No more', 'no less. Come back when', 'you have the gold.', ''],
    map:      ['- Ok, here. He slowly',
               'hands you an old map. It',
               'tells you that the temple',
               'of Thun is situated at',
               '{temple_x}x{temple_y}!',
               '',
               ''],
  },

  // case 14 — brother delivers sword for the ranger-letter.
  brother: {
    give_sword: ['- OH! A message from my', 'brother! This is indeed', 'great news. I will give', 'you this sword for', 'delivering the letter!', ''],
    produces:   ['He produces a sparkling', 'sword and wishes you a', 'happy journey.', ''],
    cant_carry: ["You can't carry it!!!.", ''],
    take_sword: ['You take the sword.'],
  },

  // case 15 — nymph sends party to seeker of Master Crown.
  // `location` folds the two inline tx() calls that followed the `know`
  // screen in the original (tx("%s lives\r\n", ...); tx("%s\r\n\r\n",
  // ...)) into a single tx_fmt record so the §16.5 dispatcher can emit
  // them via `{ screen: 'location' }`. Fixture-unreachable NPC, so the
  // added ryl_pause() boundary is benign.
  nymph: {
    know: ['I heard that a man called',
           '{seeker_name} knows of the',
           'Crown. I have roamed the',
           'land in search for him,',
           'since I want this item',
           'to be found. Here! Take',
           'this ring and show it',
           'to him. You are better fit',
           'for this mission than me.',
           ''],
    location: ['{seeker_name} lives',
               '{seeker_loc}',
               ''],
  },

  // case 18 — thief 2 squeezed for smith's name.
  thief2: {
    push:     ['You push him up against', 'a wall and start asking', 'him questions. After', "some 'mild' persuation", 'he tells you that he', 'sold the Key to a', 'travelling blacksmith', 'who was interested in', 'its metalurgic structure.', ''],
    // {smith_name} = res_enum("name", 24), filled by tx_fmt at call time.
    smith:    ['After breaking a few',
               'of his teeth, he also',
               'willinly reveals that',
               'the smith went by the',
               'name of {smith_name}...',
               ''],
    let_go:   ['You let go of your grip', 'of his collar, and he', 'falls to the floor.', ''],
  },

  // case 19 — husband quest (Tammy).
  husband: {
    depressed:  ["- Oh, I'm so depressed.", 'Orcs have kidnapped my', 'wife, Tammy, and demand', 'a ransom for her. I will', 'give you my entire fortune', 'if you retrieve her.', ''],
    fortune:    ['About 3000 gold coins,', 'a fine armour, and', 'some strange items my', 'father left me, will be', 'yours if you rescue her.', ''],
    cave:       ['The orcs have a cave', 'at 42x23 in Lonewood.', ''],
    reunion:    ['When he sees Tammy enter', 'the room, he cries tears', 'of happiness and kisses', 'her. When they have had', 'this happy reunion, he', 'motions to you to follow.', ''],
    gives:      ['He hands you 3000 gold,', 'an Adamantium Armour of', 'advanced craftmanship', 'and some other assorted', 'objects. (An amber potion', 'a holy handgrenade, a', 'fire wand and a crystal.', ''],
    cant_carry: ["You can't carry all the", 'items...', ''],
  },

  // case 20 — minstrel gives the Cloak. {minstrel_name} = res_enum(
  // "name", 20); {next_town} = res_enum("name", 8).
  minstrel: {
    reads:      ['After reading the note',
                 '{minstrel_name} cries tears',
                 'of happiness. He',
                 'shakes all your hands',
                 'and produces a purple',
                 'cloak.',
                 ''],
    cant_carry: ["You can't carry it!", ''],
    take_cloak: ['You take the cloak.'],
    travel:     ['He bids you farewell',
                 'and tells you that',
                 "he'll travel to",
                 '{next_town} the very',
                 'next day...',
                 ''],
  },

  // case 22 — ogre trades Foot-of-Jazzy location for a >34-value item.
  jazzy_ogre: {
    hear:         ['- ME HEAR YOU LOOK', 'FOR POWER ITEMS!', '',
                   '- ME VERY POOR! SELL', 'YOU INFORMATION ABOUT', 'FOOT OF JAZZY, YES?', ''],
    trade:        ['- LET US TRADE! OFFER', "ITEM AND I'LL TELL YA!", '',
                   '(You offer him something).', ''],
    refuse:  ['- NAH, THINK NOT!.'],
    accept:  ['- YEEES! NICE NIICE!',
              'GO TO CAVE AT {cave_x}x{cave_y}!',
              'BEAST HAS THE FOOT.',
              ''],
  },

  // case 23 — wizard's three tasks (kobolds / Skullweed / Dwarf Stone).
  wizard3t: {
    intro:       ['- Ah, a seeker! Yes, I', 'know about the Master', "Crown, but since I'm", 'neither good nor evil,', 'I have no interest in it.', 'I will give you the', 'information if you do', 'three tasks for me.', ''],
    agree:       ['(Since there is nothing', 'else you can do,you agree', 'to complete the three', 'tasks).', ''],
    // task1/task3 embed dungeon coords via tx_fmt at call time. task3
    // stays a two-record sequence (intro screen describing the task,
    // then a second paragraph with the location — separated by
    // ryl_pause + clw); task3_intro is the standalone description.
    task1:      ['- Firstly, I want you to',
                 'go to the kobold lair at',
                 '{kobold_x}x{kobold_y}, and kill all life',
                 'there. It is close to my',
                 'home village, and the foul',
                 'creatures have many times',
                 'attacked us. Farewell.',
                 ''],
    pendant:    ['You hand him the pendant.', 'He stares at you, almost', 'admiring.', '- WELL DONE! I will now', 'grant you the second', 'quest.', ''],
    task2:      ["- Being a magician, I'm", 'always in search for', 'powerful spell reagents.', 'There is one plant I need', "but can't find. It is", 'called Skullweed, and is', 'purple with small green', 'twigs. Find this plant', 'plant for me!', ''],
    task3_intro:['- Well done again,', 'adventurers. The third', 'of my tasks will perhaps', 'be the toughest one', 'of them all! Find me a', 'DWARF STONE. It is a', 'stone of magnetic iron', 'which gives the wielder', 'the power of levitation.', ''],
    task3:      ['- Begin your search in',
                 'the dwarven colony, near',
                 '{dwarf_x}x{dwarf_y}. Be sure to treat',
                 'the dwarves with respect,',
                 'for they are swift to',
                 'anger.',
                 ''],
    grateful:   ["- I JUST CAN'T TELL YOU",
                 'HOW GRATEFUL I AM!',
                 'He takes the stone and',
                 'smiles broadly at you.',
                 '- Very well, seekers! The',
                 'Master Crown is hidden in',
                 'a dungeon near {crown_x}x{crown_y}!',
                 'Fare thee well.',
                 ''],
  },

  // case 24 — smith reveals that hobgoblins stole the Silver Key.
  smith: {
    ask:      ['You ask him if he still', 'has the Key, prepared', 'for the worst...', ''],
    sorry:    ['- Nah, sorry. I kinda', 'studied it enough and', 'was gonna bring it to', 'Ollk to sell it. However', 'on the road between Wilor', 'and Ollk I was caught by', 'filthy hobgoblins!', ''],
    pursued:  ['- I managed to get away,', 'but they followed me! Just', 'to the south-west of here', 'one of their arrows hit', 'my horse.', ''],
    clubbed:  ['- They clubbed me', 'unconcious and took all', 'my belonings!!! Including', "that key. Find them and", "take it back. It's yours", 'if you get it.', ''],
  },

  // case 33 — hermit trades Fire-Shield cave location for a troll tooth.
  hermit: {
    welcome: ['- Welcome, chosen ones!', 'the hermit cackles.', '- I know of the Fire', 'Shield, an item of', 'great power.', 'Go find me teeth of', 'a troll, and I will', 'tell you about it.', ''],
    tooth:   ['You hand him the troll',
              'tooth.',
              '- Oh YES! He cackles.',
              'At areas uncharted, near',
              '{cave_x}x{cave_y} is the cave you',
              'seek. Beware of the',
              'guardian the ancients',
              'gave birth too...',
              ''],
  },
}
