// Priest-spell narration. Historical `spell.*` ids (singular) are kept
// for now so existing call sites keep working; as spells migrate into
// the DSL one by one, each record will move next to its spell node
// under world.json5 `spells:` and the `spell.*` root shrinks.
{
  not_enough_pts: ['Not enough spell pts!'],
  priest: {
    heal: {
      target_dead: ['Dead.'],
      heals:       ['{caster} heals'],
      target:      ['{target}'],
      points:      ['for {x} hit points...'],
    },
    restoration: {
      heals:  ['{caster} heals'],
      target: ['{target}'],
      fully:  ['fully...'],
    },
    rebirth: {
      alive:      ['{target} is alive and'],
      healthy:    ['healthy.'],
      eyelids:    ["{target}'s eyelids"],
      flicker:    ['flicker, and finally'],
      opens_eyes: ['{tgt_subj} opens {tgt_poss} eyes!'],
    },
    revelation: {
      nothing1:        ['There is nothing'],
      nothing2:        ['special near.', ''],
      special1:        ['Something special is'],
      special2:        ['near!'],
      you_find:        ['You find a'],
      object_dot:      ['{oc_name}.', ''],
      take_prompt:     ['(T)ake it'],
      leave_prompt:    ['(L)eave it'],
      added_blank:     [''],
      added_ok:        ['Ok.'],
      cant_carry:      ["You can't carry more."],
      dungeon_only1:   ['This spell can be used in'],
      dungeon_only2:   ['dungeons only, where there'],
      dungeon_only3:   ['is a limited radius for'],
      dungeon_only4:   ['the caster to enchant.', ''],
    },
    banish: {
      thunder: ['There is a deafening clap',
                'of thunder, and you hear',
                'beings scream in agony',
                'in the dungeon below...',
                ''],
      raises_hands:    ['{caster} raises {csr_poss} hands.'],
      divine_power:    ['{csr_subj} gathers divine power'],
      between_palms:   ['between {csr_poss} palms, and'],
      suddenly_clasps: ['suddenly clasps them.'],
      over_head:       ['together over {csr_poss} head.'],
      no_target1:      ['There is no particular'],
      no_target2:      ['target for this banishing.'],
      no_target3:      ['This spell is meant for'],
      no_target4:      ['use in dungeons and caves.', ''],
    },
    teleport: {
      satchel:  ['from his satchel and',
                 'uses a special instrument',
                 'to scratch the direction'],
      compass:  ['Teleport :',
                 '',
                 '   8',
                 ' 4-+-6',
                 '   2',
                 ''],
      how_far:  ['How many miles do you',
                 'want to travel? (1-9)'],
      arrived:  ['You appear to be',
                 'somewhere else.'],
      carefully:    ['{caster} carefully'],
      prepares:     ['prepares the ritual of'],
      spends:       ['Teleportation. {csr_subj} spends'],
      chanting:     ['an hour chanting mantras'],
      candles:      ['and burning blue candles.', ''],
      picks_slab:   ['{csr_subj} picks up a stone slab'],
      wants_you:    ['{csr_subj} wants you to teleport'],
      to:           ['to.', ''],
    },
    earthquake: {
      incantation: ['three syllabels in an', 'archaic tongue...', ''],
      eruption:    ['and the ground cracks', 'open!'],
    },
  },
}
