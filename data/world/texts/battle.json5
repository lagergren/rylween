// Combat text (battle.c). Grouped by combat-phase/effect so adjacent
// records cluster like they read in the game: encounter/run/item/
// prompt/spell/cry/rest/defend/attack/victory/monster/party/expgain/
// killed.
//
// Records that carry a {placeholder} token are emitted via tx_fmt with
// caller-supplied bindings; pure-static records use tx0(res_text(...)).
// The handful of remaining inline tx() calls in battle.c carry pure
// pass-through `%s\r\n` (monster name, caster name) or column-aligned
// table rows (`%-13s` spell list, `%c. %-7s (%3d hp)` target list) —
// no game-meaningful phrasing to lift.
{
  // Encounter banner + (still-)facing line. Used at fight start and
  // each round's F/R re-prompt.
  encounter: {
    banner:          ['ENCOUNTER!', ''],
    you_face:        ['You face'],
    still_face:      ['You still face'],
  },
  run: {
    coward:          ["Coward. You won't get",    'any EXP for this battle.'],
    desperate_fail:  ['You desperately try to',   'get away, but fail!'],
    fail_away:       ['You fail to get away!'],
    escaped:         ['You escaped...'],
  },
  item: {
    magic_immune:    ["The magic item doesn't seem",
                      'to work on this enemy!!!'],
    // §23.B shared opener for gem_of_confusion / gem_of_blindness.
    // Legacy `tx("%s throws the\r\n", caster_name)` — the second
    // line ('at the enemy. It' / 'gem at the enemy.') is per-item.
    throws_the:      ['{caster} throws the'],
    sparks_bump:     ['at the enemy. It',
                      'breaks before them in',
                      'a rain of sparks.',
                      'They bump into each',
                      'other as they try to',
                      'see you.',
                      ''],
    light_blind:     ['gem at the enemy.',
                      'It breaks, releasing',
                      'a brilliant cloud',
                      'of light which completely',
                      'surrounds them. As the',
                      'light fades, your enemies',
                      'are blind.',
                      ''],
    ghost_axe: {
      wounds:        ['It wounds them severely',
                      'as it spins around,',
                      'wielded by hands you',
                      'cannot see!'],
    },
    battle_cry:      ['With a raging battle',
                      'cry, you attack the',
                      'mortally wounded foes!'],
    // §23.B flute_of_madness narration. Six lines including a
    // trailing empty for the legacy `\r\n\r\n` blank-line tail.
    flute_of_madness: {
      played:        ['{caster} plays the',
                      'Flute of Madness.',
                      'It produces a shrill,',
                      'fragile sound, and breaks.',
                      'Nothing happens.',
                      ''],
    },
    // §23.B Group B: frost_wand single-target chill — caster name +
    // monster name in line 1; damage roll in line 2.
    frost_wand: {
      chills:        ['{caster} chills {monster_name}'],
      damage_pts:    ['for {dmg} damage pts.'],
    },
    // §23.B Group B: drums_of_death single-target instakill narration.
    // Three lines, then the shared battle.killed shard.
    drums_of_death: {
      summons_death: ['{caster} summons death',
                      'to take a {monster_name}',
                      'away...'],
    },
    // §23.B Group C: fire_wand AOE per-monster narration. Format
    // strings match the legacy `tx("...for %d pts!\\r\\n", dmg)` —
    // "pts!" with no "damage" prefix, distinct from mage Fire Cloud's
    // "for {dmg} damage pts!" wording.
    fire_wand: {
      burns:         ['{caster} burns {monster_name}'],
      points:        ['for {dmg} pts!'],
    },
    // §23.B Group C: kaels_axe opener (the "throws Kael's axe at the
    // enemy!" lines, before ghost_axe.wounds + battle_cry). Trailing
    // '' reproduces the legacy `\\r\\n\\r\\n` blank line.
    kaels_axe: {
      thrown:        ["{caster} throws Kael's",
                      'axe at the enemy!',
                      ''],
    },
    // §23.B Group C: holy_handgrenade narration. Five-line opener
    // and two-line KA-BLAM, both with trailing blank lines matching
    // the legacy `\\r\\n\\r\\n` tails.
    holy_handgrenade: {
      lobbed:        ['{caster} pulls the',
                      'holy pin, and lobbeth',
                      'the holy handgrenade',
                      'at the foes...',
                      ''],
      ka_blam:       ['KA-BLAM!',
                      ''],
    },
    // §23.B Group D: staff_of_healing — "X is fully healed."
    // narration. Two lines (legacy tx() pair).
    staff_of_healing: {
      fully_healed:  ['{target_name} is fully',
                      'healed.'],
    },
    // §23.B Group D: gem_of_resurrection. Success path renders the
    // possessive pronoun via engine_bind 'pronoun' + 'possessive';
    // the not-dead path is a single line + delay before the body
    // signals action_retry to the dispatcher.
    gem_of_resurrection: {
      opens_eyes:    ['{target_name} opens {target_possessive} eyes!'],
      not_dead:      ['{target_name} is not dead.'],
    },
  },
  prompt: {
    on_whom:         ['On Whom? (1-{party_max})'],
    who:             ['Who?', ''],
    // Per-round F/R prompt, the round-opening banner, and the
    // per-member action menu. `cast_spell` is only emitted when the
    // current member is_mage. Empty trailing strings reproduce the
    // legacy `\r\n\r\n` blank-line tails.
    fight:           ['(F)ight'],
    run:             ['(R)un'],
    blood_flow:      ['Blood shall flow!'],
    what_now:        ['What now?', ''],
    attack:          ['(A)ttack'],
    defend:          ['(D)efend'],
    use_item:        ['(U)se Item'],
    battle_cry:      ['(B)attle Cry'],
    cast_spell:      ['(C)ast Spell'],
    use_what:        ['Use what?', ''],
    not_possible:    ['Not possible.'],
  },
  spell: {
    morale_quest:    ['The party feels their',
                      'spirits grow. You are',
                      'all stronger than',
                      'before.',
                      ''],
    party_healed:    ['The party is fully', 'healed!', ''],
    fizzle:          ['The spell fizzles!',
                      'this creature is immune',
                      'to ordinary magic!!!'],
    not_enough_magic:['Not enough magic!'],
    // Shared opener for the three flag-setter spells (confusion /
    // hold / antimagic). §22 Lane A.
    utters_word:     ['{caster} utters a word.'],
    mirror:          ['Your images wavers and',
                      'blurs in front of your',
                      'enemies'],
    annihilate: {
      resist:        ['Through INCREDIBLE',
                      'resistance, the enemy',
                      'is still alive, badly',
                      'wounded.'],
      kill:          ['The enemy is wiped',
                      'straigt off the surface',
                      'of the earth!'],
    },
    hold_enemy:      ['The enemies freeze dead', 'in their tracks.'],
    silence:         ['The enemy is now',
                      'stopped from using magic.',
                      'against you this round.'],
    // Frost: migrated to script DSL spells.'mage.frost' do-body
    // (§22 Lane A). {caster} = caster name, {dmg} = damage roll —
    // both bound by the do: body via engine_bind 'pa_name' / let.
    frost: {
      chills:        ['{caster} chills the'],
      damage:        ['opponent for {dmg}'],
      damage_pts:    ['damage pts.'],
    },
    // Fire: §22 Lane A. {monster_name} comes from battle.c's binds;
    // {caster} via engine_bind, {dmg} via let.
    fire: {
      burns:  ['{caster} burns {monster_name}'],
      points: ['for {dmg} pts!'],
    },
    // Cast-menu Abort row (slot 7) shown after the six mage spell
    // entries. The numbered spell rows use a column-aligned format
    // (`%d. %-13s(%3d/%3d)`) and stay inline at the call site.
    abort:           ['7. Abort'],
  },
  cry: {
    off_guard:       ['(You manage to scare your',
                      ' enemies enough to get',
                      ' them off guard.)'],
    // Battle-cry pre-flavor — emitted before the off_guard body. The
    // trailing empty matches the legacy `\r\n\r\n` blank line.
    hi_yaaaa:        ['HI-YAAAA!', ''],
  },
  rest: {
    gain_hits:       ['You gain some hits pts', 'as you rest this round.'],
  },
  defend: {
    stance:          ['You put up a defensive', 'stance...'],
  },
  // Player melee narration. {attacker} = pm_name(caster); {dmg} =
  // dp roll. The miss arm has no damage to print.
  attack: {
    hits_for:        ['{attacker} hits for'],
    damage_pts:      ['{dmg} damage pts!'],
    misses:          ['{attacker} misses!'],
  },
  victory: {
    bested:          ['Thou hast bested', 'thy foes.', ''],
    // Reward header + per-survivor line + and-gold tail. `and_gold`
    // carries a trailing empty for the legacy `\r\n\r\n` blank line.
    each_survivor:   ['Each survivor gets'],
    exp_pts:         ['{exp} experience pts'],
    and_gold:        ['and {gold} gold pieces.', ''],
    // Post-fight loot drop. {object_name} = object(i) (already in the
    // legacy form with no leading article, hence the lifted `You find
    // a` opener stays in C as a separate emit).
    you_find_a:      ['You find a'],
    found_obj:       ['{object_name}.'],
  },
  monster: {
    // Shared opener: "<monster> casts" — emitted by battle.c's
    // monster_cast_spell dispatcher BEFORE the spell-pick RNG
    // draw, so the casting line is unconditional even though the
    // do: bodies own everything that follows. {monster_name} is
    // bound from battle.c's combat ctx (foe display name).
    casts:           ['{monster_name} casts'],
    hold_player:     ['You realize with horror', 'that you cannot move!'],
    confusion:       ['You are almost blinded', 'by a colorful haze.'],
    // §23.A: per-spell name + per-line shards used by the four
    // monster nasty-magic do: bodies in spells/monster.json5.
    // Color codes ([31m / [37m) match the legacy
    // tx("[31m...DIES![37m") byte-for-byte.
    player_dies:     ['[31m{target_name} DIES![37m'],
    frost: {
      name:          ['Frost Finger'],
      on_target:     ['on {target_name}!'],
      does_pts:      ['and does {dmg} pts'],
      of_damage:     ['of damage!'],
    },
    fire: {
      name:          ['Cloud of Fire!'],
      burnt_for:     ['{target_name} is burnt for'],
      dmg_pts:       ['{dmg} damage pts!'],
    },
    hold: {
      name:          ['Hold Creature!'],
    },
    confuse: {
      name:          ['Confusion!'],
    },
    // Monster melee turn — distinct from the §23.A nasty-magic
    // shards above. {monster_name} = foe display name (fn);
    // {target_name} = pm_name of victim. `melee_dies` carries a
    // triple bang to differentiate from the spell-cast `player_dies`
    // which uses a single bang. Color codes ([31m / [37m) match the
    // legacy `tx("[31m...DIES!!![37m")` byte-for-byte.
    attacks:         ['{monster_name} attacks'],
    target_excl:     ['{target_name}!'],
    and_hits_for:    ['And hits for'],
    damage_pts:      ['{dmg} damage pts!!!'],
    melee_dies:      ['[31m{target_name} DIES!!![37m'],
    blow_misses:     ['Blow misses!'],
  },
  // Status callout when every player is held — replaces the
  // status/F-R block for one round.
  party: {
    held:            ['PARTY IS HELD!'],
  },
  // Post-fight level-up narration (expcheck). {name} = pm_name;
  // {levels} = number of levels gained (typically 1, can be more
  // when crossing multiple thresholds).
  expgain: {
    gains:           ['{name} gains >{levels}<'],
    exp_levels:      ['experience levels.'],
  },
  killed:            ['...KILLED!'],
}
