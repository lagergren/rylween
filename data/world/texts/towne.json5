// Town menus, shop/inn/tavern/church/smith/merchant flows, and
// rumour() body — static text moved out of src/towne.c (A.3). Every
// remaining tx() in towne.c is either a pure %d format (gold prices,
// levels, hit points) or a {placeholder} record resolved via tx_fmt
// (§16.3). Interactive menus use ryl_menu (§16.1); where a menu has
// a wildcard fall-through the caller passes {0, <default>} as the
// sentinel.
//
// Layout conventions match speak.json5 / driv.json5:
//   - array-of-strings => each line joined with CRLF + trailing CRLF
//   - plain string     => verbatim (no trailing CRLF)
//   - {placeholder}    => resolved at call time by tx_fmt() (§16.3)
//
// towne.c is not on any replay-fixture path (fixtures never enter a
// town), so byte-stream parity wasn't required — grouped keys drop
// redundant CSI-right jumps the terminal would no-op anyway.
{
  // --- rumour() body ------------------------------------------------
  //
  // 33 cases, selected by ryl_random(0, 32). Cases with an NPC name
  // ({name_*}) or coord ({loc_*}) come through tx_fmt; the rest are
  // plain tx0(res_text(...)).
  rumour: {
    r0:  ["Baron Ydarg's castle",
          'Zadraz is hidden in a',
          'forest to the soutwest.'],
    r1:  ['The Silver Key unlocks',
          "the gate to Ydarg's",
          'dimension.'],
    r2:  ['You will need the Fire',
          'shield to defeat baron',
          'Ydarg.'],
    r3:  ['You will need the',
          'Master Crown to',
          'defeat baron Ydarg.'],
    r4:  ['You will need the',
          'Bracelets of Thun',
          'to resist the most',
          'evil of all spells...'],
    r5:  ['The scythe is a',
          'useless weapon.'],
    r6:  ['Some say that you',
          'need gems to enter',
          'the old Temple of',
          'Thun.'],
    r7:  ['Seek the Hermit if',
          'you want to know',
          'of the Fire Shield'],
    r8:  ['The Hermit lives in',
          'the swamp.'],
    r9:  ['Always post a guard',
          'when you camp in the',
          'wilderness.'],
    r10: ['The Foot of Jazzy is',
          'one of the objects',
          "Baron Ydarg can't",
          'control!'],
    r11: ['Skullweed plant grows',
          'deep in the swamp. It is',
          'a powerful reagent.'],
    // {name1} = res_enum("name", 1)
    r12: ['A man named {name1}',
          'will pay you for',
          'killing some bandits.'],
    // {name2} = res_enum("name", 2)
    r13: ['A hunter called {name2}',
          'seeks a brave party',
          'of adventurers.'],
    r14: ['It is always wise to',
          'haggle.'],
    r15: ['Cthulhu will rise again!'],
    r16: ["Baron Ydarg's castle",
          'in this dimension lies',
          'far to the southwest.'],
    r17: ['Exploring caves can',
          'be profitable.'],
    r18: ['Flee from all beasts',
          'that you are uncertain',
          'of.'],
    r19: ['Before tempering in',
          'the business of a God,',
          'be a demi god yourself.'],
    r20: ['Jazzy is a mighty',
          'lesser god or a demon.'],
    r21: ['Baron Ydargs castle',
          'Zadraz is a gate to',
          'another dimension.'],
    r22: ['Never meddle in the',
          'affairs of wizards, for',
          'they are subtle, and',
          'swift to anger.'],
    r23: ['Magical objects can be',
          'a great aid in battle.'],
    r24: ['Seek the holy handgrenade!'],
    // {name15} = res_enum("name", 15), {loc15} = "in <town>" or
    // "at NxN" per the npc[15].towne check.
    r25: ['A man named {name15}',
          'knows of the Crown.',
          'He lives {loc15}!'],
    r26: ['Murn is situated',
          'somewhere near 50x30!'],
    // {name13}, {loc13} — same pattern as r25.
    r27: ['Seek {name13} if you',
          'search the Temple of',
          'Thun! He lives {loc13}'],
    r28: ['The more powerful',
          'creatures, the more',
          'experience.'],
    r29: ['A good sword beats',
          'four aces!'],
    r30: ['You need FIVE items,',
          'no less, no more',
          'to kill Ydarg!'],
    r31: ['Wilor is situated',
          'at the coordinates',
          '43x20!'],
    r32: ['Ollk is situated',
          'somewhere near 50x10!'],
  },

  // --- enter() ------------------------------------------------------
  enter: {
    nothing:       ['Nothing to enter here!'],
    // {twn} = town display name
    welcome:       ['Welcome to {twn}'],
    // {pct} = tax rate (int), {amount} = gold owed (int)
    tax: ['Our current tax rate',
          'is {pct}% - In order to',
          'enter, we must request',
          'you pay {amount} au.',
          ''],
    tax_menu:      ['(P)ay to Enter',
                    '(L)eave'],
    thanks:        ['Thank you!'],
    // {twn} = town display name
    village:       ['Village of {twn}'],
    city:          ['City of {twn}'],
    divider:       ['=======================',
                    ''],
    menu_core:     ['(M)erchant  (I)nn',
                    '(T)avern    (G)uild'],
    menu_smith:    ['(S)mith'],
    menu_smith_ch: ['(S)mith     (C)hurch'],
    menu_leave:    ['(L)eave',
                    ''],
    prompt:        ': ',
    weapons_q: ['Do you want to ready',
                'some weapons before',
                'leaving?',
                ''],
    armours_q: ['Do you want to ready',
                'some armours before',
                'leaving?',
                ''],
  },

  // --- hut() --------------------------------------------------------
  hut: {
    enter: ['You enter the hut.'],
    // {job} = res_enum("job", npc[who].job), {name} = res_npc_name(who)
    greeter: ['A {job} who',
              'introduces himself as',
              '{name}, greets you.',
              ''],
    menu:    ['(T)alk',
              '(L)eave'],
  },

  // --- church() -----------------------------------------------------
  church: {
    intro: ['You enter the church',
            'of Dalina, a beautiful',
            'goddess. This is one of',
            'her two temples.',
            ''],
    menu:  ['(H)eal person',
            '(R)aise dead',
            '(E)nergize',
            '(L)eave'],
    who:   ['Who? (1-{party_max})'],
    // --- energize branch ---
    not_spellcaster: ['Not a spellcaster!'],
    no_need_sp: ['That character needs',
                 'no spell points',
                 'to be restored.'],
    // {cost} = gold cost for restoration/raise/heal
    cost: ["- That'll be {cost}",
           'gold coins, please.',
           ''],
    // price variant used by energize & raise (extra "That will be" rather
    // than "- That'll be"). Kept distinct so byte output matches the
    // original more/less exactly.
    cost2: ['- That will be {cost}',
            'gold coins, please.',
            ''],
    pn_menu: ['(P)ay',
              '(N)o thanks'],
    no_gold:   ["You don't have the gold!"],
    no_gold2:  ["You don't have enough",
                'gold!'],
    restored: ['The priestess',
               'restores his energy.'],
    // {pro_sub} = pronoun subject (he/she)
    alive: ['- {pro_sub} seems very alive',
            'at the moment.'],
    // {pro_obj} = pronoun object (him/her)
    raised: ['The priestess raises',
             '{pro_obj}.'],
    corpse: ['- GET THAT CORPSE',
             'OUTTA HERE!',
             '(You are thrown out).',
             ''],
    // {pro_sub} — same convention
    no_healing: ['{pro_sub} needs no healing.'],
    healed: ['The priestess heals',
             '{pro_obj} fully.'],
  },

  // --- smith() ------------------------------------------------------
  smith: {
    closed: ['Shop Closed.'],
    intro:  ['Smith.',
             '',
             'The smith welcomes you',
             'to his small shop.',
             ''],
    beer_offer: ['The smith offers you some',
                 'beer, and the latest news',
                 'from the realm.',
                 ''],
    beer_menu:  ['(A)ccept',
                 '(D)ecline'],
    accept_1:   ['You accept the invitation.'],
    accept_2:   ['After a while the smith',
                 'leaves to get more beer.'],
    accept_3:   ['When he returns, you ask',
                 'him for the latest news...',
                 ''],
    decline:    ['The smith is disappointed.',
                 '- Maybe another time,',
                 'you tell him.',
                 '- Yeah, he answers.',
                 ''],
    shop_menu:  ['(B)uy',
                 '(S)ell',
                 '(L)eave'],
    bye:        ['Well, bye then...'],
    buy_menu:   ['Armour or Weapon?',
                 '',
                 '(A)rmour',
                 '(W)eapon',
                 '(N)othing'],
    we_have:    ['We have...',
                 ''],
    // Shop menu prices: {cost:<itemkey>} pulls obcost straight from
    // data/world/items/{weapons,armour}.json5 — no per-shop binding
    // prelude in towne.json5. Item keys must match the shard record
    // names; bind_expand dies on a typo with a useful diagnostic.
    armour_menu: ['1. Leather     ({cost:leather} Au)',
                  '2. Chain Mail  ({cost:chain_mail} Au)',
                  '3. Plate Mail  ({cost:plate_mail} Au)',
                  '4. Ring Mail   ({cost:ring_mail} Au)',
                  '5. Elvin Cloak ({cost:elvin_cloak} Au)',
                  '6. Mith. Mail  ({cost:mithril_mail} Au)'],
    weapon_page1: ['1. Sword     ({cost:sword} Au)',
                   '2. Axe       ({cost:axe} Au)',
                   '3. Bow       ({cost:bow} Au)',
                   '4. Club      ({cost:club} Au)',
                   '5. Halbard   ({cost:halbard} Au)',
                   '6. Crossbow  ({cost:crossbow} Au)',
                   '',
                   'N. Next Page'],
    weapon_page2: ['7. Longsword ({cost:longsword} Au)',
                   '8. 2h-Sword  ({cost:two_hand_sword} Au)',
                   '9. Pole Arm  ({cost:pole_arm} Au)',
                   'A. Trident   ({cost:trident} Au)',
                   'B. Mgk Dagger({cost:magic_dagger} Au)',
                   'C. Mgk Sword ({cost:magic_sword} Au)',
                   '',
                   'P. Previous Page'],
    too_expensive: ['Too expensive...'],
    cant_carry: ['You cannot carry more.'],
    deal:    ['Deal!'],
    sell_prompt: ['Sell what?',
                  ''],
    not_w_or_a:  ['Not weapon or armour.'],
    // {pr} = offered gold
    offer: ['Ok! Give ya {pr}!',
            ''],
    bargain_opt: ['(B)argain'],
    no_thanks: ['No thanks.'],
  },

  // --- tavern() -----------------------------------------------------
  tavern: {
    closed: ['Tavern Closed.'],
    scruffy_1: ['Just as you are about',
                'to sit down at a,',
                'table, a scruffy',
                'little man, pulls',
                'at your sleeve...',
                ''],
    scruffy_2: ['- Hey, hey, hey! You!',
                '  yes... you! I have',
                '  and offer that may',
                '  interest you...',
                ''],
    // {item} = object(i), {price} = obcost(i)
    scruffy_offer: ['- I will sell you this',
                    '  {item}',
                    '  for the ridiculously',
                    '  low price of {price}',
                    '  Aurum!',
                    ''],
    buy_nothanks: ['(B)uy it',
                   '(N)o thanks'],
    scruffy_broke: ["- You don't have that",
                    '  much gold!'],
    scruffy_deal:  ['- Deal!!!'],
    scruffy_full:  ["- You can't carry it!"],
    scruffy_no:    ['- Fine, I can live with',
                    '  that.'],
    // {name} = res_enum("name", 28+twn) — the tavernkeeper for this town
    greeter: ['- Welcome! Have a seat',
              '{name}, the keeper',
              'of the tavern greets',
              'you...',
              ''],
    main_menu: ['(O)rder drink',
                '(S)peak',
                '(T)ell story',
                '(R)umors',
                '(L)eave'],
    story_who: ['Who wants to tell',
                'a story? (1-{party_max})'],
    dead_story: ['Dead men do not',
                 'tell any great',
                 'stories...'],
    // {who} = state.p[cpl].name[d-48]
    stands_up: ['{who} stands up',
                'and screams:',
                "- ANYONE WHO WANNA HEAR",
                "  A TRAVELLER'S STORY?",
                ''],
    yeah: ['- YEAAH! Roars the crowd!',
           ''],
    story_menu: ['(T)rue story',
                 '(B)oast'],
    liar_kicked: ['- Out with the liar!'],
    thrown_out:  ['You are thrown out.'],
    st_superb: ["Superb Story! Let's",
                "give 'em some ale, lads!",
                'You are given a whole',
                'tray of ale!',
                ''],
    st_vgood: ["Very good! You've been",
               'through much!',
               ''],
    st_nice: ['Nice story, Sir!',
              ''],
    st_bored: ['The mob is bored.',
               ''],
    st_asleep: ['Most of the crowd',
                'falls asleep. The rest',
                'beg you to stop.',
                ''],
    quiet: ['The tavern has suddenly',
            'become very quiet.',
            ''],
    // Trailing blank lines preserve the `tx("\r\n")` separator that
    // the C code emitted between the rumour intro and the rumour
    // body — see the R branch in towne.tavern.
    rum_old: ['After listening a while',
              'you hear an old man say',
              'to another:',
              ''],
    rum_bard: ['A drunken bard bellows:',
               ''],
    rum_halfling: ['A halfling you rescued',
                   'from a brawl whispers:',
                   ''],
    rum_keeper: ['The tavern keeper',
                 'motions to you to',
                 'come closer, and',
                 'whispers :',
                 ''],
    rum_bargirl: ['A bargirl tells you:',
                  ''],
    order_header: ['Order:',
                   ''],
    order_menu: ['A. Ale       2 au',
                 'B. Mead      3 au',
                 'C. Wine      4 au',
                 'D. Fanta     1 au',
                 'E. Nothing'],
    no_drink: ['No money - No drink!'],
    aah: ['AAH! (your health',
          'returns).'],
    laughed_at: ['You are the laughing',
                 'stock of the entire',
                 'tavern...'],
  },

  // --- inn() --------------------------------------------------------
  inn: {
    // {name} = res_enum("name", 24+twn)
    greeter: ['{name}, the Innkeeper',
              'welcomes you.',
              '',
              'Do you want supper,',
              'travellers?',
              ''],
    // {cost} = 15*lv[1]*lv[1] gold
    supper_cost: ['Sorry, supper is {cost}',
                  'gold.'],
    supper_served: ['You are served a well',
                    'tasting dinner. Some',
                    'of your health returns.',
                    ''],
    drink_q: ['Anything to drink?',
              ''],
    drink_menu: ["What'll it be?",
                 '',
                 'A. Ale         2 au',
                 'B. Mead        3 au',
                 'C. Wine        5 au',
                 'D. Whiskey     7 au',
                 'E. Fanta       1 au'],
    ahh: ['Ahh...!'],
    giggle: ['The other guests giggle.'],
    lodging_q: ['Are you in need',
                'of lodging?',
                ''],
    // {cost} = lv[1]*15*lv[1] gold
    room_cost: ['A room is {cost} gold/night.',
                ''],
    room_menu: ['(T)ake it',
                '(L)eave'],
    no_gold_kick: ['- AHA! No gold!',
                   'You are thrown out.'],
    bedtime: ['You go to bed...'],
    zzz: ['Zzzz...',
          ''],
    morning: ['You wake up a little',
              'before dawn, well',
              'rested.',
              '',
              'You have breakfast',
              'and leave the inn.',
              ''],
    leaves: ['The innkeeper leaves.',
             ''],
    chit_menu: ['(C)hitchat with guests',
                '(L)eave'],
  },

  // --- merchant() ---------------------------------------------------
  merchant: {
    closed: ['Shop Closed.'],
    intro:  ['Merchant',
             '',
             'Can I help you? I',
             'trade in the finest',
             'items in the realm!',
             ''],
    menu:   ['(B)uy item',
             '(S)ell item',
             '(L)eave'],
    bye:    ['Well, bye then...'],
    wrong_kind: ["- I don't deal in that",
                 '  kind of stuff!'],
    // {pr} = offered gold (obcost(oc)/2)
    sell_offer: ['- Ok. Give ya {pr}!',
                 ''],
    sold: ['Sold!'],
    // {food_price} = snprintf('%2d', lv[1]+1);
    // {potion_price} = obcost(36)+lv[1]*3 as an int formatted '%d'.
    buy_menu: ['(A) Torch           1 au',
               '(B) Food Ration    {food_price} au',
               '(C) Blanket        30 au',
               '(D) Tent           80 au',
               '(E) Rope           15 au',
               '(F) Healing Potion {potion_price} au',
               '(G) Donkey        800 au',
               '(H) Nothing'],
    desc: {
      torch: ['Ah, the finest torches',
              'in the realm.'],
      food:  ['Better food is not',
              'availible anywhere else',
              'in the entire realm.'],
      blanket: ['Our blankets are very',
                'warm and soft.'],
      tent: ['Noone manufactures',
             'better tents than',
             'we do!'],
      rope: ['The finest hemp',
             'ropes in the realm.'],
      potion: ['The best healing',
               'potions availible',
               'for money!'],
      donkey: ['Our stout donkeys',
               'are bred just for',
               'carrying your food',
               'and equipment.'],
    },
    // {pr} = per-unit price, used for torch/food "how many" path
    each: ['{pr} gold each, sir.'],
    how_many: 'How many? ',
    too_many_torches: ['You can carry no',
                       'more than 80',
                       'torches...'],
    // {cap} = 150 + y*150
    too_many_food: ['You can carry no',
                    'more than {cap} units!'],
    too_expensive: ['Too expensive!'],
    cant_carry: ['You cannot carry more.'],
    deal: ['Deal!'],
    // {pr} = price
    price: ['Price: {pr}',
            ''],
    pn_menu: ['(P)ay',
              '(N)one'],
  },
}
