// Rylween world file — root JSON5 tree. See docs/dsl.md for the full
// schema. This is the single source for every resource kind: flags,
// items, monsters, classes, spells, terrain, sextext, enums, and the
// text table. The flat data/resources.jsonl loader retired in Phase 6d.
{
  meta: {
    version: 1,
    schema:  'rylween-world-v0',
    // Forward-compat hook: when line-wrap becomes the default for
    // paragraph-form texts, the wrapper uses these dimensions. Not
    // consumed at runtime yet — existing texts ship pre-wrapped.
    text_window: { max_lines: 15, max_cols: 26 },
  },

  // Symbolic mission-flag names (§3.1). `slot` is the index in
  // state.p[cpl].flag[] (scope: "party") or an engine-managed encounter
  // slot (scope: "encounter"). Only the flags the runtime already
  // mutates are enumerated here; others land as their missions port.
  flags: {
    'garth.bandits':        { slot: 1,  values: ['none', 'accepted', 'recovered', 'closed'] },
    'hermit.troll_tooth':   { slot: 33, values: ['none', 'accepted', 'extracted', 'delivered'] },
    'church.donation.once': { slot: 5,  values: ['no', 'yes'] },
    'encounter.immune':     { slot: 0,  scope: 'encounter', values: ['no', 'yes'] },
  },

  // Items are split into section shards by kind. fold_items walks the
  // outer sections object, then each inner record, so sections are a
  // pure authoring convenience — the legacy ryl_item[0..111] table is
  // still keyed by the flat `id` field.
  items: {
    weapons:     { $import: 'world/items/weapons.json5' },
    armour:      { $import: 'world/items/armour.json5' },
    gear:        { $import: 'world/items/gear.json5' },
    potions:     { $import: 'world/items/potions.json5' },
    treasures:   { $import: 'world/items/treasures.json5' },
    magic_items: { $import: 'world/items/magic_items.json5' },
  },

  // Monsters shard — keyed by symbolic name; `id` is the runtime key the
  // legacy ryl_monster[0..90] table uses (map.dat stores ids verbatim).
  monsters: { $import: 'world/monsters.json5' },

  // Texts sharded by top-level prefix; each leaf is either a string
  // (verbatim) or an array of lines (joined with \r\n, trailing \r\n
  // appended). fold_texts recursively flattens the tree into dotted
  // ids and sorts them for bsearch lookup in res_text.
  texts: {
    title:  { $import: 'world/texts/title.json5' },
    driv:   { $import: 'world/texts/driv.json5' },
    strid:  { $import: 'world/texts/strid.json5' },
    subs:   { $import: 'world/texts/subs.json5' },
    cave:   { $import: 'world/texts/cave.json5' },
    spell:  { $import: 'world/texts/spell.json5' },
    common: { $import: 'world/texts/common.json5' },
  },

  // Class records (§3.3). Only the `spells` list is consumed today —
  // prereqs/starting gear stay in C (driv.c createparty) until those
  // call sites migrate. `casts_in` is recorded for the benefit of the
  // evaluator's future menu gating.
  classes: {
    mage: {
      spells: [
        'mage.frost', 'mage.fire', 'mage.confusion',
        'mage.death', 'mage.hold', 'mage.antimagic',
      ],
      casts_in: ['combat'],
    },
    priest: {
      spells: [
        'priest.heal', 'priest.restoration', 'priest.rebirth',
        'priest.banish', 'priest.revelation', 'priest.teleport',
        'priest.earthquake',
      ],
      casts_in: ['combat'],
    },
  },

  // Spells (§3.4). Nested by class so each shard owns its own file.
  // res_spell_node(class, slot) finds the entry whose slot matches,
  // then hands the `do` body to eval_effect. Spells without a `do`
  // carry `legacy_effect: "..."` — a string mapped to the SE_* enum
  // strid.c still switches on; those cases migrate to `do:` one by one.
  spells: {
    mage:   { $import: 'world/spells/mage.json5' },
    priest: { $import: 'world/spells/priest.json5' },
  },

  // Terrain glyphs — keyed by the literal map.dat byte so the author
  // can see exactly which map character gets which display/colour.
  // `kar` is the two-char ANSI cell; `frg` is the foreground colour.
  // Unknown glyphs render as "  " at frg=36.
  terrain: {
    'm': { kar: '/\\', frg: 37 },
    'w': { kar: '~~', frg: 34 },
    's': { kar: '..', frg: 33 },
    '0': { kar: 'TT', frg: 37 },
    '1': { kar: 'HH', frg: 37 },
    'f': { kar: '^^', frg: 37 },
    'd': { kar: '::', frg: 31 },
    't': { kar: '%%', frg: 35 },
    'g': { kar: 'gg', frg: 32 },
    '2': { kar: 'CC', frg: 37 },
  },

  // Pronouns. res_sextext(sex, xx) reads these with xx = 1 (subject),
  // 2 (object), 3 (possessive); sex = 1 (male) / 2 (female).
  sextext: {
    male:   { subject: 'he',  object: 'him', possessive: 'his' },
    female: { subject: 'she', object: 'her', possessive: 'her' },
  },

  // Enum tables — res_enum(id, index) reads values[index]. jobname[0]
  // and name[0] are intentionally empty: the runtime uses 1-based ids
  // and a 0 slot means "none / sentinel".
  enums: {
    jobname: [
      '', 'Merchant', 'Ranger', 'Fighter', 'Wizard', 'Priest',
      'Thief', 'Peasant', 'Bard', 'Drifter', 'Half-Orc', 'Half-Elf',
      'Smith', 'Bargirl', 'Innkeeper', 'Tavernkeeper', 'Hermit',
    ],
    name: [
      '', 'Garth', "Nrim'to", 'Areth', 'Nevaak', 'Gorm', 'Bernak',
      'Matias', 'Tybalt', 'Romeo', 'Werra', 'Arenjun', 'Oskar',
      'Harry', 'Marraga', 'Broth', 'Ebond', 'Bolph', 'Gotharp',
      'Ron', 'Kaal', 'Daniel', 'Leander', 'Ithienn', 'Azaaza',
      'Hassan', 'Luqas', 'Darth', 'Yog', 'Niklas', 'Tokawa',
      'Miyaki', 'Dargoth', 'Marcus', 'Deanna', 'Jeanne', 'Alex',
      'Galdon', 'Kosch', 'Ufarsin',
    ],
  },
}
