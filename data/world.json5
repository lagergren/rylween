// Rylween world file — root JSON5 tree. See docs/dsl.md for the full
// schema. This is the single source for every resource kind: flags,
// items, monsters, classes, spells, terrain, pronoun, enums, and the
// text table. The flat data/resources.jsonl loader retired in Phase 6d.
{
  meta: {
    version: 1,
    schema:  'rylween-world-v0',
    // Forward-compat hook: when line-wrap becomes the default for
    // paragraph-form texts, the wrapper uses these dimensions. Not
    // consumed at runtime yet — existing texts ship pre-wrapped.
    text_window: { max_lines: 15, max_cols: 26 },
  },

  // Cold-start realization knobs (port-plan §15.4). `npc_slack` is the
  // slack added to ceil(N/T) when computing the per-bin cap for the
  // capacity-capped NPC draw (N = random NPCs, T = wilderness + towns).
  // With today's N=23, T=5, slack=1 => cap=6 per bin. Raise for a more
  // uniform distribution at the cost of rerolls; lower for less.
  limits: {
    npc_slack: 1,
  },

  // UI prompt verbs picked at random by the engine. Indexed by
  // ryl_random(0, n-1) where n = the array length. Authors can grow
  // the pool by appending new verbs; existing fixtures will need
  // re-blessing whenever the modulo changes (the random pick consumes
  // one rng_next() call regardless of bounds, but the visible result
  // is `rng % n`). Keep the list ordered: first ten match the legacy
  // C-side order so historical RNG-divergence audits can re-correlate.
  prompts: {
    // Verb pool for ryl_pause()'s "(<verb> RETURN key)" prompt. The
    // legacy in-source array was the first ten entries below; the
    // additional twenty (Pummel..Decapitate) widen the pool so
    // reading the same prompt twice in close succession is less
    // likely to repeat the same verb. Tone matches the original —
    // aggressive verbs that read naturally as an action against a
    // physical key.
    pause_verbs: [
      'Smash', 'Bash', 'Slash', 'Lunge at', 'Crush',
      'Destroy', 'Mutilate', 'Thrash', 'Stab', 'Brain',
      'Pummel', 'Whack', 'Pulverize', 'Annihilate', 'Obliterate',
      'Demolish', 'Hammer', 'Pound', 'Maul', 'Wallop',
      'Cleave', 'Mangle', 'Skewer', 'Eviscerate', 'Vanquish',
      'Trample', 'Batter', 'Slam', 'Smite', 'Decapitate',
    ],
  },

  // Symbolic mission-flag names (§3.1). Authoritative dictionary:
  // every quest tag the runtime or a script can read or write lives
  // here. Tags are human-readable ids; `values:` names each state of
  // the per-quest state machine. Save format (`flags:` in
  // current-world.json5) and DSL ops (`set_flag`/`flag:`) both speak
  // these tags; the slot field is the legacy byte-array index the
  // save/load layer still keys on.
  flags: {
    // Robbed-merchant courier quest (speak NPC 1, missions block 1).
    'garth.bandits':        { slot: 1,  values: ['none', 'accepted', 'recovered', 'closed'] },
    // Ranger ↔ brother sword-delivery chain (speak NPCs 2, 14).
    'ranger.letter':        { slot: 2,  values: ['none', 'accepted', 'delivered'] },
    // Priest's stolen book → wizard → fighter's grateful Dancing
    // Blade. Shared flag advanced by three NPCs in sequence.
    'fighter.priest_book':  { slot: 3,  values: ['none', 'priest_told', 'priest_visited',
                                                 'wizard_robbed', 'fighter_grateful'] },
    // Church donation one-shot (speak NPC 7).
    'church.donation.once': { slot: 5,  values: ['no', 'yes'] },
    // Silver Key quest: map-buy → pit-note → thief2 squeeze →
    // smith → hobgoblin-caravan → key_taken.
    'silver_key':           { slot: 6,  values: ['none', 'map_bought', 'note_found',
                                                 'thief2_squeezed', 'smith_confessed',
                                                 'cave_located', 'key_taken'] },
    // Erethor / Lute of Legends → minstrel Cloak of Gods chain.
    'erethor.lute':         { slot: 8,  values: ['none', 'rumour_told', 'lute_taken',
                                                 'note_received', 'cloak_received'] },
    // Bracelets of Thun (speak temple NPC, dungeon case 25).
    'bracelets.thun':       { slot: 13, values: ['none', 'map_bought', 'bracelets_taken'] },
    // Nymph hint that starts the seeker / wizard3t chain.
    'nymph.seeker':         { slot: 15, values: ['none', 'told', 'wizard3t_active'] },
    // Peasant's wife (Tammy) abduction → rescue → payout.
    'peasant_wife':         { slot: 19, values: ['none', 'accepted', 'rescued', 'paid'] },
    // Jazzy ogre item trade → beast cave location.
    'jazzy_ogre':           { slot: 22, values: ['none', 'accepted',
                                                 'ogres_cleared', 'jazzy_defeated'] },
    // Wizard of Three Tasks → Master Crown chain. Ten-state machine
    // advanced in lockstep by wizard3t speak stages and the mission-
    // trigger scripts (kobold_village, skullweed, borin_meet / _gift,
    // nolrim_crypt / master_crown dungeons).
    'mastercrown':          { slot: 23, values: ['none',
                                                 'task1_assigned', 'task1_done',
                                                 'task2_assigned', 'task2_done',
                                                 'task3_assigned', 'borin_met',
                                                 'dagger_taken', 'borin_paid',
                                                 'crown_told', 'crown_taken'] },
    // Hermit troll-tooth → Fire Shield dungeon. Value 4 is the
    // fire-shield-acquired terminal state (dungeon.c case 21).
    'hermit.troll_tooth':   { slot: 33, values: ['none', 'accepted', 'extracted',
                                                 'delivered', 'fire_shield_acquired'] },
    // Engine-managed encounter-scope flag.
    'encounter.immune':     { slot: 0,  scope: 'encounter', values: ['no', 'yes'] },
  },

  // Items are split into section shards by kind. fold_items walks the
  // outer sections object, then each inner record, so sections are a
  // pure authoring convenience — the legacy ryl_item[0..111] table is
  // still keyed by the flat `id` field.
  items: {
    weapons:     { $import: 'world/items/weapons.json5' },
    armor:       { $import: 'world/items/armor.json5' },
    gear:        { $import: 'world/items/gear.json5' },
    potions:     { $import: 'world/items/potions.json5' },
    treasures:   { $import: 'world/items/treasures.json5' },
    magic_items: { $import: 'world/items/magic_items.json5' },
    specials:    { $import: 'world/items/specials.json5' },
  },

  // Monsters shard — keyed by symbolic name; `id` is the runtime key the
  // legacy ryl_monster[0..90] table uses (map.dat stores ids verbatim).
  monsters: { $import: 'world/monsters/monsters.json5' },

  // §20 L1: Dungeon scenario placements. Keyed by the `flag` arg to
  // dungeon(); see the shard's header for the encounter-id namespace.
  // L2 grows this shard with per-encounter scripts.
  dungeons: { $import: 'world/dungeons/dungeons.json5' },

  // Texts sharded by top-level prefix; each leaf is either a string
  // (verbatim) or an array of lines (joined with \r\n, trailing \r\n
  // appended). fold_texts recursively flattens the tree into dotted
  // ids and sorts them for bsearch lookup in res_text.
  texts: {
    title:  { $import: 'world/texts/title.json5' },
    driv:   { $import: 'world/texts/driv.json5' },
    battle: { $import: 'world/texts/battle.json5' },
    subs:   { $import: 'world/texts/subs.json5' },
    cave:   { $import: 'world/texts/cave.json5' },
    spell:  { $import: 'world/texts/spell.json5' },
    common: { $import: 'world/texts/common.json5' },
    ydarg:  { $import: 'world/texts/ydarg.json5' },
    speak:  { $import: 'world/texts/speak.json5' },
    towne:  { $import: 'world/texts/towne.json5' },
    missions: { $import: 'world/texts/missions.json5' },
    terrain: { $import: 'world/texts/terrain.json5' },
    dungeon: { $import: 'world/texts/dungeon.json5' },
    hunt:   { $import: 'world/texts/hunt.json5' },
    rest:   { $import: 'world/texts/rest.json5' },
  },

  // §16.4 dialogue scripts — arrays of one-op objects the interpreter
  // in src/script.c walks. Authored alongside the matching texts shard;
  // the `speak:` subtree resolves `{ screen: 'rumour' }` inside
  // `erethor.first_visit` to text id `speak.erethor.rumour`.
  scripts: {
    speak: { $import: 'world/scripts/speak.json5' },
    speak_missions: { $import: 'world/scripts/speak_missions.json5' },
    missions: { $import: 'world/scripts/missions.json5' },
    towne: { $import: 'world/scripts/towne.json5' },
    terrain: { $import: 'world/scripts/terrain.json5' },
    dungeon: { $import: 'world/scripts/dungeon.json5' },
    hunt: { $import: 'world/scripts/hunt.json5' },
    rest: { $import: 'world/scripts/rest.json5' },
    lodge: { $import: 'world/scripts/lodge.json5' },
    ydarg: { $import: 'world/scripts/ydarg.json5' },
  },

  // Per-tick upkeep. food_handler() reads these every hour; callers
  // are in subs.c. Keep keys stable — C-side hard-codes the names.
  upkeep: {
    food_cost_leader_div: 4,   // food -= pl + lv[1] / N every food_tick_every hours
    food_tick_every:      5,   // every N hours the food cost above fires
    starve_damage:        2,   // hp lost per tick at food=0 (alive members)
    mana_regen_chance:    50,  // pct; mage/priest with ma < wi regen +1 per hour
  },

  // Wilderness event dispatch. random_wilderness() rolls r = ryl_random(0, 99)
  // once per move, then falls through these bands:
  //   r < cave_chance                       -> cave-found prompt
  //   cave_chance <= r < (cave_chance + quiet_chance)
  //                                         -> no event (terrain msg only)
  //   otherwise                             -> encounter, split by
  //                                            encounter_split pct:
  //                                            encounter_easy_tier vs
  //                                            encounter_hard_tier
  //                                            (monster 'tier' keyword).
  // §20 S10: world-map dimensions and placement rules. `rows` is how
  // many lines driv.c::init reads from data/map.dat into state.map[]
  // (slots 1..rows; row 0 stays zero so res-driven walls aren't
  // overwritten). `rows_max` / `cols_max` are the storage capacity
  // (state.map is heap-allocated to rows_max × cols_max bytes at
  // world-load); both are bounded by MAP_ROWS_HARD_MAX /
  // MAP_COLS_HARD_MAX in state.h. The legacy data/map.dat layout
  // assumes 42 × 82 (40 used rows in slots 1..40 of a [42] array;
  // each row up to 81 cells + newline). `location_bounds` are the
  // inclusive-min, exclusive-max (x,y) box that position_locations
  // rejects ouside of when picking a random dungeon-cave coord.
  // `dungeon_avoid` lists every tile char position_locations
  // re-rolls on so dungeons land on plain/forest/foothill/desert/
  // swamp.
  map: {
    rows: 40,
    rows_max: 42,
    cols_max: 82,
    location_bounds: {
      x_min: 5, x_max: 74,
      y_min: 5, y_max: 34,
    },
    dungeon_avoid: 'wm012',
  },

  wilderness: {
    cave_chance:        3,
    quiet_chance:       91,
    encounter_split:    50,        // pct; else the hard tier
    encounter_easy_tier: 'weak',   // must match a monsters.*.tier value
    encounter_hard_tier: 'wild',
    cave_dungeon_lo:    3,
    cave_dungeon_hi:    16,
    cave_entry_cost:    10,        // time_left ticks consumed on cave (E)nter
  },

  // §20 S6: rest + hunt + fatigue tunables. Read by subs.c via
  // res_int_path("balance.<subtree>.<key>").
  balance: {
    rest: {
      ambush_chance:        19,    // pct; ryl_chance() to ambush a camped party
      health_gain:          15,    // hp restored per non-guard member on rest
      food_cost_per_member:  4,    // pa.food -= N * pl
      hours_advanced:        8,    // advance_hour() called this many times
      hours_rested_reset:   14,    // post-rest hours_rested floor
      temperature_max:      15,    // ryl_random(1, N) roll
      temp_low_lo:           6,    // [lo, hi) "low temperature" band
      temp_low_hi:          10,
      temp_very_low_lo:     10,    // [lo, ...) "very low temperature" band
      // Cold-band damage. Engine reads both knobs independently; today
      // both are 5 by author choice (no escalation between bands).
      // Port-plan §20.5 flagged the equality as "possible bug" — it
      // is not a code defect, it's a balance/design call left to the
      // author. Set temp_very_low_damage > temp_low_damage to make
      // the very-cold band hit harder.
      temp_low_damage:       5,    // hp -= N when no warm gear in [lo, hi)
      temp_very_low_damage:  5,    // hp -= N when no warm gear at very low
    },
    hunt: {
      success_chance: 45,   // pct; ryl_chance() to bag a rabbit
      time_cost:       5,   // time_left -= N (also the floor for "too few")
      food_min:       10,
      food_max:       19,   // ryl_random(food_min, food_max) + pa_first_level()
    },
    fatigue: {
      // Thresholds the food_handler ladder compares hours_rested to.
      // Exhausted and weak are equality checks today; the < weak
      // branch is the open-ended "faint" tail.
      exhausted: -4,
      weak:      -8,
    },
  },

  // §23.D: create_party() literals — stat-roll range and the
  // fresh-party initial state. Read via res_int_path("driv.<key>").
  // The `start:` block reproduces the original
  // state.p[a].{x,y,gold,torches,food,time_left,hours_rested}
  // assignment block at the end of create_party(); fixtures pin
  // these values byte-for-byte. The `daily:` block holds the
  // per-day refresh budget driv.c::init applies to every party at
  // the first-of-day rollover (intentionally smaller than `start.
  // time_left` — a fresh party gets a one-time bonus on day 0).
  driv: {
    stat_roll: { min: 15, max: 70 },
    start: {
      x:             12,
      y:              9,
      gold:        1000,
      torches:        5,
      food:         100,
      time_left:    200,
      hours_rested:  14,
    },
    daily: {
      time_left: 175,
    },
  },

  // Combat-system tuning. Named fields are read by battle.c via
  // res_combat_int("<dotted.path>"); keep keys stable across data edits
  // since the C side hard-codes the names (not the values). Drop
  // tables shape is `combat.drop_tables.<table>.{treasure_chance,
  // treasure_lo/hi, magic_lo/hi}` so new encounter shapes can layer
  // more tables without widening the accessor.
  combat: {
    flee_chance:    95,    // pct; ryl_chance() to escape a non-mandatory encounter
    defend_cap:     250,   // max accumulated defend pool before clamp
    hp_defense_div: 12,    // dp contribution per defender: hp[g] / N

    // §23.C: player-attack tunables. `hit_bonus` is the +1 floor in
    // ryl_chance(ws + N) so a 0-skill attacker still has a chance.
    // `damage_spread_max` is the upper bound of the ryl_random(0, N)
    // damage roll added on every successful hit. `confusion_div`
    // halves... thirds... the effective ws when player_confused is
    // set (mage confusion + monster confusion both go through this).
    attack: {
      hit_bonus:         1,
      damage_spread_max: 4,
      confusion_div:     3,
    },

    // §23.C: post-action ws penalties. battle_cry trades 4 ws for the
    // off-guard message; defend trades 2 ws for the rest/stance gain.
    // The `ws > N` guard prevents going below 1; tying penalty + guard
    // to the same field keeps them in lockstep.
    battle_cry: { ws_penalty: 4 },
    defend:     { ws_penalty: 2, rest_threshold: 5 },

    // §23.A residual: monster-melee formula. The g==5 magic gate
    // already routes nasty-magic through the script DSL; the melee
    // fallback arm's numbers stay in C but pull through res so they
    // can be tuned without a recompile. Hit-roll is ryl_chance(ws +
    // hit_bonus); damage is mh[idx]/damage_div + ryl_random(0,
    // damage_spread_max) - armor, floored at damage_min.
    monster_attack: {
      hit_bonus:         1,
      damage_div:        6,
      damage_spread_max: 9,
      damage_min:        1,
    },

    // §23.C: desperate-flee. (R)un after the F/R prompt rolls
    // ryl_chance(N); on success the party is locked into combat and
    // sees "Couldn't get away..."; on failure they escape.
    run: { desperate_chance: 31 },

    // §20 S5/S11: encounter HP scaling and victory rewards live as
    // named entries in the top-level `formulas:` block (encounter_h1_
    // scaled / encounter_h2_scaled / reward_xp_per_survivor /
    // reward_gold_party). The eleven flat knobs S5 added are inlined
    // into those expression trees so the multiplication structure
    // itself is now data, not C.

    // Cap on noc (number of co-encountered foes). monsters.json5
    // sets the per-record max; this is the global ceiling that
    // backs the same UI display ("XX XX XX..." 8 slots). Stays
    // a flat constant — it's a clamp, not a formula.
    encounter_foe_count_max:       8,

    drop_tables: {
      default: {
        drop_chance:     5,     // pct; outer roll to drop anything at all
        treasure_chance: 59,    // pct; on drop, else a magic item
        treasure_lo: 36, treasure_hi: 46,   // ryl_random(lo, hi) on treasures-shard ids
        magic_lo:    100, magic_hi: 111,    // ryl_random(lo, hi) on magic_items-shard ids
      },
    },
  },

  // XP totals needed to REACH each level. xp_thresholds[N] is the
  // cumulative experience a member needs to hit level N. Indexed
  // by target level (2..28); slots 0..1 unused sentinel-0s so the
  // array indexing reads naturally at call site. Final growth curve
  // matches the original game's linear-then-exponential ramp.
  xp_thresholds: [
    0, 0,
    2000, 4000, 8000, 12000, 20000, 28000, 36000, 48000, 54000,
    64000, 74000, 86000, 98000, 110000, 125000, 150000, 180000,
    240000, 300000, 400000, 550000, 700000, 900000, 1100000,
    1500000, 2000000, 2800000,
  ],

  // Named formulas. Flat arithmetic ("game logic that should be data")
  // authored as an expression tree and looked up by name from C via
  // res_formula_int(name, var_name, val). Bodies use the usual DSL
  // expression ops (+ - * / min max clamp cond rand) and may reference
  // a single `$var` local seeded by the caller. First pilot:
  //
  //   donkey_food_cap: 150 + 150 * y
  //
  // subs.c drop() used this both as the cap test and the cap clamp
  // when a donkey is dropped; before §17-O it was an inline literal
  // pair. Other formulas follow as the `a + b*v` / `a * v + b` shapes
  // across battle.c / dungeon.c / subs.c get lifted one by one.
  // §22 Lane A: formulas migrated from the S-expr DSL to script DSL
  // expression form. Each formula is a single expression node read
  // by play_formula_int (script.c); binding names match the int
  // bindings the C-side res_formula_int_n caller seeds. The cond
  // ternary in encounter_h1_scaled is expressed as `(test) * value`
  // — gt returns 0/1, multiplied by the then-arm gives 0 or
  // first_level*2 — since script DSL has no ternary expression.
  formulas: {
    donkey_food_cap: { add: [150, { mul: [150, { var: 'y' }] }] },

    // §20 S11: encounter HP scaling. Both h1 (min) and h2 (max) grow
    // with party stats so a low-level pool scales as the party levels.
    // h1 picks up a flat party-average bonus plus a leader-only bonus
    // once the leader passes level 2; h2 grows linearly with the leader
    // level. Bindings: $h1_base / $h2_base (monster's stock h1/h2 from
    // monsters.json5), $party_avg (average pm_lv across slots 1..4),
    // $first_level (pa_first_level()).
    encounter_h1_scaled: { add: [
      { var: 'h1_base' },
      { add: [
        { mul: [{ var: 'party_avg' }, 2] },
        { mul: [
          { gt: [{ var: 'first_level' }, 2] },
          { mul: [{ var: 'first_level' }, 2] },
        ]},
      ]},
    ]},
    encounter_h2_scaled: { add: [
      { var: 'h2_base' },
      { mul: [{ var: 'first_level' }, 3] },
    ]},

    // §20 S11: victory rewards. reward_xp_per_survivor backs the
    // "Each survivor gets X experience pts" display line. reward_
    // gold_party is both the figure handed to party_add_gold and
    // (post §22.6) the gold figure shown on the same victory line —
    // the legacy `reward_gold_per_survivor` divisor was a display
    // bug (kitty got 4× what the screen claimed) and has been
    // dropped. Bindings: $noc, $h2 (post-scaling), $ws (post-
    // scaling), $sp.
    reward_xp_per_survivor: { add: [
      { mul: [
        { var: 'noc' },
        { mul: [
          { div: [{ var: 'h2' }, 4] },
          { div: [{ var: 'weapon_skill' }, 4] },
        ]},
      ]},
      { mul: [{ var: 'sp' }, 3] },
    ]},
    reward_gold_party: { mul: [
      { var: 'noc' },
      { mul: [
        { div: [{ var: 'h2' }, 7] },
        { div: [{ var: 'weapon_skill' }, 4] },
      ]},
    ]},
  },

  // Spells (§3.4). Nested by class so each shard owns its own file.
  // res_spell_node(class, slot) finds the entry whose slot matches,
  // then hands the `do` body to play_spell_body — the script DSL
  // evaluator that runs every spell after §22 Lane A.
  spells: {
    mage:   { $import: 'world/spells/mage.json5' },
    priest: { $import: 'world/spells/priest.json5' },
  },

  // §23.A: monster nasty-magic spells. Sibling tree to `spells:`
  // because monsters cast outside the class+slot machinery — this
  // is an ordered list keyed by ryl_random(0, n-1), not a slot map.
  // battle.c::monster_cast_spell looks up `monster_spells.spells[i]`
  // by index after drawing the pick. See spells/monster.json5 for the
  // four ported entries (frost / fire / hold / confuse).
  monster_spells: { $import: 'world/spells/monster.json5' },

  // Terrain — keyed by the literal map.dat byte so the author can see
  // exactly which map character gets which rendered form. `glyph` is
  // the two-char cell the renderer writes to the terminal; `color` is
  // the ANSI foreground name (black/red/green/yellow/blue/magenta/
  // cyan/white). Unknown map bytes render as "  " in cyan. `class` is
  // an optional tag the engine routes through wld_tile_is_<class>:
  // 'mountain'/'water' classes mark impassable tiles (wld_is_passable
  // returns false); 'town'/'hut'/'castle' classes mark "enterable"
  // tiles the towne.c E-key flow dispatches on; tiles without a class
  // are open terrain. Adding a fourth settlement type is a pure data
  // edit + a new wld_tile_is_<name> helper.
  terrain: {
    'm': { glyph: '/\\', color: 'white',   class: 'mountain' },
    'w': { glyph: '~~', color: 'blue',     class: 'water'    },
    's': { glyph: '..', color: 'yellow'                      },
    '0': { glyph: 'TT', color: 'white',    class: 'town'     },
    '1': { glyph: 'HH', color: 'white',    class: 'hut'      },
    'f': { glyph: '^^', color: 'white'                       },
    'd': { glyph: '::', color: 'red'                         },
    't': { glyph: '%%', color: 'magenta'                     },
    'g': { glyph: 'gg', color: 'green'                       },
    '2': { glyph: 'CC', color: 'white',    class: 'castle'   },
  },

  // Pronouns. res_pronoun(gender, xx) reads these with xx = 1 (subject),
  // 2 (object), 3 (possessive); gender = 1 (male) / 2 (female).
  pronoun: {
    male:   { subject: 'he',  object: 'him', possessive: 'his' },
    female: { subject: 'she', object: 'her', possessive: 'her' },
  },

  // Towns — fixed display names and world-map coordinates. Slot
  // 0..n-1 are real towns; the runtime "in wilderness" / "no town"
  // marker is the WILDERNESS_TOWN sentinel (state.h, value -1),
  // never a towns[] index. The enums.towne table below carries the
  // same name list with a leading 'wilderness' entry that the
  // save-format bridge in driv.c::wcw_enum / rcw_enum reserves for
  // the sentinel — §25.B step 3b/C4 will drop that entry and the
  // bridge will switch to a literal-string match. The legacy
  // `interact.c:162-172` coord chain, `towne.c` twnname chain, and
  // `speak.c` "in %s" chains all resolve through this table.
  towns: [
    { name: 'Thord', x: 12, y: 11, tax:  7, has_church: true,  class: 'village' },
    { name: 'Ollk',  x: 48, y: 12, tax: 10, has_church: false, class: 'village' },
    { name: 'Wilor', x: 43, y: 20, tax:  9, has_church: true,  class: 'city'    },
    { name: 'Murn',  x: 55, y: 29, tax:  8, has_church: false, class: 'village' },
  ],

  // Per-building opening hours (§17-F). Keyed by a short building id
  // — each towne.c wrapper queries `res_building_hours(name, lo, hi)`
  // and passes `open_lo` / `open_hi` as bindings into the matching
  // DSL script, which emits the "Shop Closed." screen when the hour
  // falls outside the declared range. `opens_at` and `closes_at` are
  // both inclusive (0..23). When `opens_at > closes_at` the range
  // wraps around midnight: the tavern is `6..1`, i.e., open all day
  // except 2..5. The DSL per building chooses the matching check
  // (`hour_of_day<lo || hour_of_day>hi` for non-wrap,
  //  `hour_of_day<lo && hour_of_day>hi` for wrap).
  // Missing entries mean "always open" per the C wrapper's default.
  buildings: {
    smith:    { opens_at: 6, closes_at: 18 },
    tavern:   { opens_at: 6, closes_at: 1  },
    merchant: { opens_at: 6, closes_at: 18 },
  },

  // Town-menu keystroke dispatch. Each entry is one row of the
  // towne.c::enter() menu loop: when the user presses `key` (matched
  // case-insensitive), the named `action` runs. Optional `cond`
  // names a town-record bool that must be true for the entry to
  // fire; today only the (C)hurch arm is gated, on `has_church`.
  // Order matches the historical if/else cascade — the dispatcher
  // walks the table top-to-bottom so the first matching entry wins.
  // Actions are recognized by towne.c (small enum); adding a new
  // arm requires both a new entry here and a wired action there.
  town_keys: [
    { key: 'C', cond: 'has_church', action: 'enter_church'   },
    { key: 'S',                     action: 'enter_smith'    },
    { key: 'I',                     action: 'enter_inn'      },
    { key: 'M',                     action: 'enter_merchant' },
    { key: 'T',                     action: 'enter_tavern'   },
    { key: 'L',                     action: 'leave_town'     },
  ],

  // Castle Ydarg per-floor map dimensions. Each of the four floors
  // is a `size x size` grid (1-indexed; slot 0 is the unused C-array
  // padding). ydarg.c reads this once per ydarg() entry to seed the
  // room[] roll, the exit gate at room[size][size] = 50, and the
  // east/south boundary checks. Bump cautiously: the C array is
  // declared `room[8][8]` so size <= 7 is the safe ceiling without
  // touching the source.
  ydarg: {
    // Wilderness coordinates of the castle Ydarg gate tile. The
    // towne.c E-key flow consults this position (after confirming
    // the underlying tile carries the 'castle' class, see terrain
    // above) to dispatch into ydarg(). Read at trigger time via
    // res_int_path("ydarg.entry.x") / res_int_path("ydarg.entry.y").
    entry: { x: 14, y: 30 },

    map: { size: 5 },

    // Treasure-room (case 3) drop table. Original RNG draw order:
    //   ryl_random(0, gate_max)        — 0 selects magic, else regular
    //   if regular: ryl_random(0, kind_max) — picks kind_<n>
    //               ryl_random(lo, hi) on that kind's id range
    //   if magic:   ryl_random(magic.lo, magic.hi)
    // The bounds reflect the original ranges:
    //   weapons 1..14, armor 36..42, gear 39..46, magic 100..111.
    // Bumping any of these changes RNG identity — re-bless ydarg
    // fixtures after a tweak.
    drop_tables: {
      room: {
        gate_max:  4,                  // ryl_random(0, 4): 0 = magic, else regular
        kind_max:  2,                  // ryl_random(0, 2) picks kind_<n>
        kind_0: { lo: 1,   hi: 14  },  // weapons
        kind_1: { lo: 36,  hi: 42  },  // armor
        kind_2: { lo: 39,  hi: 46  },  // gear
        magic:  { lo: 100, hi: 111 },
      },
    },

    // Final-confrontation monster sequence (Baron Ydarg roof deck).
    // ydarg.c::confrontation() runs encounter(<sym>, 1) for each
    // entry in order; no narration between them (the act-1 narration
    // bookends the sequence). Baron Ydarg himself stays separate
    // because his fight is gated by its own act-2/3 narration block.
    confrontation_sequence: [
      'crypt_horror',
      'night_gaunt',
      'thyraga',
      'liche',
    ],

    // §23.H: per-room dispatch tunables.
    //   - `room_type_max` is the upper bound of ryl_random(1, N) at
    //     ydarg() room-init: each non-stairs slot rolls 1..N. Slots
    //     1..3 are active (monster/pitfall/treasure); 4..N fall
    //     through the room dispatcher as no-ops, padding the
    //     "empty room" probability. Bumping changes RNG identity.
    room: { type_max: 5 },

    // §23.H: pitfall (case 2) tunables. Trap-type narration is
    // a string-array; ydarg.c rolls ryl_random(0, count-1) and
    // emits res_text(trap_types[k]). Adding a fourth trap type
    // grows the array (and shifts RNG identity). `damage_div` is
    // the party-damage divisor in pm_hp / N applied to every alive
    // member when a trap is not disarmed.
    pitfall: {
      trap_types: [
        'ydarg.room.trap.arrows',
        'ydarg.room.trap.poison',
        'ydarg.room.trap.shurikens',
      ],
      damage_div: 6,
    },

    // §23.F: stairs (G)ive-item dispatch. The mage on each floor's
    // 50-tile asks for one of four quest items; the digit prompt
    // 1..4 maps onto a special-flag tag (matched against
    // data/world/items/specials.json5 via inv_special_id_for_tag)
    // and a rejection-message id ("...sing" for singular items,
    // "...plur" for the pluralized BRACELETS message).
    // Order matches the `give_menu` text byte-for-byte.
    stairs: {
      items: [
        { digit: 1, special: 'fireshield',  reject_msg: 'no_have_sing' },
        { digit: 2, special: 'mastercrown', reject_msg: 'no_have_sing' },
        { digit: 3, special: 'jazzyfoot',   reject_msg: 'no_have_sing' },
        { digit: 4, special: 'bracelets',   reject_msg: 'no_have_plur' },
      ],
    },

    // §23.I: confrontation() narration sequences. Each entry is an
    // ordered list of text ids that tx_narrate walks with the
    // standard `clw + tx_fmt + ryl_pause` step between screens.
    // The boundaries between act1/2/3/4 fall on encounters or state
    // mutations (mage-sphere fight, baron fight, save), not on
    // rendering shape — keeping them as separate calls leaves the
    // C side responsible for the inter-act side effects.
    narration: {
      conf_act1: [
        'ydarg.conf.trapdoor_slam', 'ydarg.conf.fools',
      ],
      conf_act2: [
        'ydarg.conf.corpses', 'ydarg.conf.impress', 'ydarg.conf.sphere',
        'ydarg.conf.mages',   'ydarg.conf.curses',  'ydarg.conf.trident',
        'ydarg.conf.commence',
      ],
      conf_act3: [
        'ydarg.conf.trident_falls', 'ydarg.conf.not_over',
        'ydarg.conf.cloak',         'ydarg.conf.dust',
        'ydarg.conf.congrats',
      ],
      conf_act4: [
        'ydarg.conf.heroes', 'ydarg.conf.signoff',
      ],
    },
  },

  // Sysop backdoors — name-keyed dispatch preserved from the Amiga
  // original. Each entry is keyed by an arbitrary author-stable slug
  // (the `name:` field is what the runtime matches against the
  // current player party's global name via `session_player_name()`).
  // `keys:` is a one-press dispatch table fired from primitives.c::
  // key(); the action field selects the handler:
  //   - add_time_left   { amount, refresh_status }
  //   - add_gold        { amount, refresh_status }
  //   - set_inventory   { slot, item: '<slug>' }   item resolves via
  //                     res_item_id at lookup time.
  // `step_trigger:` (optional) is a periodic check evaluated every
  // wilderness move from random_wilderness(). Today the only action
  // is `spawn_encounter` (spawns one encounter against the named
  // monster slug, resolved via res_monster_id). `every_n_steps`
  // gates the check on `pa_time_left() % N == 0` so a player whose
  // global name matches gets the encounter once every N moves.
  secrets: {
    marcus: {
      name: 'Marcus Lagergren',
      keys: [
        { key: '/', action: 'add_time_left', amount: 50, refresh_status: true },
        { key: '(', action: 'set_inventory', slot: 12, item: 'drums_of_death' },
        { key: ')', action: 'set_inventory', slot: 11, item: 'gem_of_resurrection' },
        { key: '&', action: 'set_inventory', slot: 10, item: 'kaels_axe' },
        { key: '*', action: 'set_inventory', slot:  9, item: 'holy_handgrenade' },
        { key: '+', action: 'add_gold', amount: 1000, refresh_status: true },
      ],
    },
    karl: {
      name: 'Karl Skagerberg',
      step_trigger: {
        every_n_steps: 101,
        action: 'spawn_encounter',
        monster: 'skagerberg_killer',
      },
    },
  },

  // NPCs — one entry per slot, keyed by symbolic id. The state.npc[]
  // slot is assigned positionally by declaration order: garth=0,
  // nrim_to=1, ..., ufarsin=38. Slot count comes from this object's
  // entry count (capped by NPC_SLOT_HARD_MAX), not a hard 40. `job`
  // is mandatory. An entry with `towne` declared is FIXED (apply the
  // declared job/towne/building/x/y verbatim); an entry without
  // `towne` is RANDOM (realizer rolls towne / building / wilderness
  // x,y at cold start). The realizer walks this object in
  // declaration order — reordering entries reorders slots and shifts
  // the random-placement RNG stream, so don't reorder casually.
  //
  // Two §15.3 oddities preserved as-is for byte-parity review:
  //   - Bargirls only in Thord (slot 0) and Wilor (slot 2); Ollk
  //     (slot 1) and Murn (slot 3) have none. Probably an Amiga-era
  //     omission; leaving it verbatim until the realizer gates land.
  //   - Slots 35..38 are Amiga-build leftovers (empty Merchant stubs
  //     in wilderness at 0,0). They survive because
  //     write_current_world iterates slots 0..res_npc_slot_max()-1
  //     and save() / npc.dat mirror the same range.
  npcs: {
    garth:    { name: 'Garth',    job: 'merchant', towne: 'Thord', building: 'inn' },
    nrim_to:  { name: "Nrim'to",  job: 'ranger'   },
    areth:    { name: 'Areth',    job: 'fighter'  },
    nevaak:   { name: 'Nevaak',   job: 'wizard'   },
    gorm:     { name: 'Gorm',     job: 'priest'   },
    bernak:   { name: 'Bernak',   job: 'thief'    },
    matias:   { name: 'Matias',   job: 'peasant'  },
    tybalt:   { name: 'Tybalt',   job: 'bard'     },
    romeo:    { name: 'Romeo',    job: 'drifter'  },
    werra:    { name: 'Werra',    job: 'half_orc' },
    arenjun:  { name: 'Arenjun',  job: 'half_elf' },
    oskar:    { name: 'Oskar',    job: 'smith'    },
    harry:    { name: 'Harry',    job: 'merchant' },
    marraga:  { name: 'Marraga',  job: 'ranger'   },
    broth:    { name: 'Broth',    job: 'fighter'  },
    ebond:    { name: 'Ebond',    job: 'wizard'   },
    bolph:    { name: 'Bolph',    job: 'priest'   },
    gotharp:  { name: 'Gotharp',  job: 'thief'    },
    ron:      { name: 'Ron',      job: 'peasant'  },
    kaal:     { name: 'Kaal',     job: 'bard'     },
    daniel:   { name: 'Daniel',   job: 'drifter'  },
    leander:  { name: 'Leander',  job: 'half_orc' },
    ithienn:  { name: 'Ithienn',  job: 'half_elf' },
    azaaza:   { name: 'Azaaza',   job: 'smith'    },
    // Innkeepers: job 14, in the inn (building = 'inn'). The legacy
    // person.c:95-121 had these at building = 'tavern', which is
    // backwards — Hassan is the innkeeper of Thord's INN (towne.c:1265
    // "%s, the Innkeeper welcomes you" runs inside inn()), not its
    // tavern. Fixed here because struct person.building is a
    // write-only field today (grep confirms no reader), so the
    // correction is behavior-neutral but makes the save file say what
    // it should.
    hassan:   { name: 'Hassan',   job: 'innkeeper',    towne: 'Thord', building: 'inn' },
    luqas:    { name: 'Luqas',    job: 'innkeeper',    towne: 'Ollk',  building: 'inn' },
    darth:    { name: 'Darth',    job: 'innkeeper',    towne: 'Wilor', building: 'inn' },
    yog:      { name: 'Yog',      job: 'innkeeper',    towne: 'Murn',  building: 'inn' },
    niklas:   { name: 'Niklas',   job: 'tavernkeeper', towne: 'Thord', building: 'tavern' },
    tokawa:   { name: 'Tokawa',   job: 'tavernkeeper', towne: 'Ollk',  building: 'tavern' },
    miyaki:   { name: 'Miyaki',   job: 'tavernkeeper', towne: 'Wilor', building: 'tavern' },
    dargoth:  { name: 'Dargoth',  job: 'tavernkeeper', towne: 'Murn',  building: 'tavern' },
    marcus:   { name: 'Marcus',   job: 'hermit',       towne: 'Wilderness', x: 48, y: 7 },

    // Bargirls: job 13, in the tavern. Legacy person.c:163 had these
    // at building = 'inn' — another latent write-only bug: towne.c:1189
    // encounters bargirls in the tavern rumour-switch, never in the
    // inn. Fixed along with innkeeper/tavernkeeper above;
    // behavior-neutral.
    //
    // These are the only two female NPCs; `gender: 'female'` drives
    // the res_pronoun lookup and the well_f / health_f chitchat
    // branches in speak.c. All other NPC records omit `gender` and
    // fall through the rn_enum default of 1 (male).
    deanna:   { name: 'Deanna',   job: 'bargirl',      towne: 'Thord', building: 'tavern', gender: 'female' },
    jeanne:   { name: 'Jeanne',   job: 'bargirl',      towne: 'Wilor', building: 'tavern', gender: 'female' },
    alex:     { name: 'Alex',     job: 'merchant',     towne: 'Wilderness' },
    galdon:   { name: 'Galdon',   job: 'merchant',     towne: 'Wilderness' },
    kosch:    { name: 'Kosch',    job: 'merchant',     towne: 'Wilderness' },
    ufarsin:  { name: 'Ufarsin',  job: 'merchant',     towne: 'Wilderness' },
  },

  // Role -> NPC binding. The C side (rumour dispatch, speak cases,
  // silver-key note) asks for an NPC by quest-role name via
  // res_npc_role("<role>"), which resolves through this table to an
  // npcs: shard key and then to the runtime slot. Rename a character
  // in npcs: above (e.g. Garth -> Gareth) and update the matching
  // role here; the C never sees the character's name.
  //
  // Adding a new role means both a line here AND a C call site that
  // asks for it — those two together define a new quest hook. Removing
  // or renaming a role IS a C-visible change since the role key is a
  // string literal at the call site.
  npc_roles: {
    bandits_quest_giver: 'garth',    // towne.c rumour r12 + speak stages_npc1
    rangers_quest_giver: 'nrim_to',  // towne.c rumour r13 + speak stages_npc2
    crown_seer:          'broth',    // towne.c rumour r25 + speak stages_npc15
    temple_of_thun_seer: 'harry',    // towne.c rumour r27 + speak case 13
    master_thief:        'gotharp',  // dungeon.c silver-key note + speak stages_npc18
    fighter_intro:       'areth',    // speak.c case 3 + bard fighter_name + speak stages_npc3
    priest_with_book:    'gorm',     // speak.c case 3 target + speak stages_npc5
    silver_key_vendor:   'bernak',   // speak.c case 6
    jazzy_ogre_trader:   'leander',  // speak.c case 22
    wizard_robbed:       'nevaak',   // speak stages_npc4 (stolen-book chain)
    erethor_lute_bard:   'tybalt',   // speak stages_npc8 (Erethor / Lute intro)
    ranger_brother:      'marraga',  // speak stages_npc14 (sword delivery)
    peasant_husband:     'ron',      // speak stages_npc19 + missions husband_cave bind
    minstrel_cloak:      'kaal',     // speak stages_npc20 (Lute -> Cloak handoff)
    wizard_three_tasks:  'ithienn',  // speak stages_npc23 (wizard3t / Master Crown)
    silver_key_smith:    'azaaza',   // speak stages_npc24 (after thief2 squeeze)
    hermit_troll_tooth:  'marcus',   // speak stages_npc33 (tooth trade)
  },

  // Enum tables — res_enum(id, index) reads values[index]. Slot 0 is
  // empty ('') for 1-based enums so a 0 raw id means "none / sentinel";
  // 0-based enums (towne, building) use a real value at 0. current-world.json5
  // stores these fields as the string value; the reader does an inverse
  // lookup via res_enum_id to recover the int id.
  enums: {
    // NPC job (struct person.job). Lowercase key is the script-stable
    // symbol; `name` is the visible label rendered by the speak() listing
    // and saved into current-world.json5. Hyphenated display names
    // ('Half-Orc' / 'Half-Elf') become snake-cased symbols.
    job: {
      merchant:     { name: 'Merchant'     },
      ranger:       { name: 'Ranger'       },
      fighter:      { name: 'Fighter'      },
      wizard:       { name: 'Wizard'       },
      priest:       { name: 'Priest'       },
      thief:        { name: 'Thief'        },
      peasant:      { name: 'Peasant'      },
      bard:         { name: 'Bard'         },
      drifter:      { name: 'Drifter'      },
      half_orc:     { name: 'Half-Orc'     },
      half_elf:     { name: 'Half-Elf'     },
      smith:        { name: 'Smith'        },
      bargirl:      { name: 'Bargirl'      },
      innkeeper:    { name: 'Innkeeper'    },
      tavernkeeper: { name: 'Tavernkeeper' },
      hermit:       { name: 'Hermit'       },
    },
    // (`name` / `innkeepers` / `tavernkeepers` enums retired — the
    // DSL town-greeter binds resolve via npc_in_town(job_sym, twn)
    // and res_npc_name(slot) reads each NPC's `name:` field directly
    // from the npcs subtree.)

    // Player-party race (struct party.ra[]). Lowercase key is the
    // script-stable symbol; `name` is what the show() screen renders.
    // Slot ids are 1-indexed positional (object-key order); slot 0 is
    // the "no race" sentinel. driv.c's create_party digit menu reads
    // 1..4 directly so the data file order doubles as the keystroke
    // mapping.
    race: {
      human:    { name: 'Human'    },
      dwarf:    { name: 'Dwarf'    },
      elf:      { name: 'Elf'      },
      halfling: { name: 'Halfling' },
    },

    // Player-party class (struct party.cl[]). The lowercase key is the
    // script-stable symbol; `name` is the show()-screen display string.
    // `levelup` deltas are applied by battle.c on each level gained
    // (hp clamped up to (2/3)*h post-gain; stat keys mirror the party
    // fields). Caster classes also carry their `spells:` list and a
    // `casts_in:` annotation for the future menu-gating pass.
    // Slot ids are 1-indexed positional (object-key order); slot 0 is
    // the "no class" sentinel. Storage in struct party.cl[] is the
    // slug pointer post-§24bis phase 3; the int form is recovered via
    // res_enum_id at the snapshot / save / DSL boundary, so the
    // historical PC_FIGHTER=1 .. PC_RANGER=6 numbering is preserved by
    // keeping the data-file order matching.
    // `min_stat:` (optional) is the create_party() class gate: if the
    // rolled stat named here is below `value`, the prompt prints
    // `fail_text` and re-rolls. Classes without a min (thief, ranger)
    // omit the field. Matches the original driv.c switch on
    // state.p[].cl case 1..6 byte-for-byte.
    pc_class: {
      fighter: {
        name: 'Fighter',
        min_stat: { name: 'weapon_skill', value: 50, fail_text: 'driv.create.weapon_skill_low' },
        levelup: { weapon_skill: 3, health: 8, wisdom: 1, charisma: 1 },
      },
      thief: { name: 'Thief', levelup: { weapon_skill: 1, health: 5, wisdom: 1, charisma: 2 } },
      mage: {
        name: 'Mage',
        min_stat: { name: 'wisdom', value: 50, fail_text: 'driv.create.wisdom_low' },
        spells: [
          'mage.frost', 'mage.fire', 'mage.confusion',
          'mage.death', 'mage.hold', 'mage.antimagic',
        ],
        casts_in: ['combat'],
        levelup: { weapon_skill: 1, health: 4, wisdom: 7, charisma: 2 },
      },
      priest: {
        name: 'Priest',
        min_stat: { name: 'wisdom', value: 50, fail_text: 'driv.create.wisdom_low' },
        spells: [
          'priest.heal', 'priest.restoration', 'priest.rebirth',
          'priest.banish', 'priest.revelation', 'priest.teleport',
          'priest.earthquake',
        ],
        casts_in: ['combat'],
        levelup: { weapon_skill: 1, health: 5, wisdom: 8, charisma: 3 },
      },
      bard: {
        name: 'Bard',
        min_stat: { name: 'charisma', value: 50, fail_text: 'driv.create.charisma_low' },
        levelup: { weapon_skill: 2, health: 7, wisdom: 2, charisma: 6 },
      },
      ranger: { name: 'Ranger', levelup: { weapon_skill: 2, health: 8, wisdom: 3, charisma: 3 } },
    },

    // Player-party member gender (struct party.gender[]). Not displayed
    // as text directly; keys match the pronoun table above.
    gender: ['', 'male', 'female'],

    // Town name strings as they appear in current-world.json5 saves
    // and npcs[].towne entries. Slots 0..N-1 line up with the
    // towns[] runtime array entry-for-entry; the runtime sentinel
    // WILDERNESS_TOWN (-1) is bridged separately by the literal
    // string "wilderness" in the save-format / fixed-NPC paths
    // (driv.c::wcw_enum / rcw_enum towne, res.c::res_realize_npcs,
    // res.c::res_npc_in_town) — never an enum entry here.
    towne: ['Thord', 'Ollk', 'Wilor', 'Murn'],

    // Building within a town (struct person.building). 0 = none
    // (wilderness NPCs); 1 = inn; 2 = tavern. Symbolic ids; not
    // displayed. speak.c:106 filters NPCs in inn/tavern by this id.
    building: ['none', 'inn', 'tavern'],

    // Calendar month (1..12). 1-based; slot 0 is the empty sentinel
    // so res_enum("month", kl[2]) returns the display name for the
    // wall-clock month byte from getclk(). Used by ydarg.c's
    // confrontation() to format the heroes.txt timestamp line.
    month: [
      '',
      'January', 'February', 'March',     'April',
      'May',     'June',     'July',      'August',
      'September', 'October', 'November', 'December',
    ],

    // blitgfx pic ids — mirrors the #defines in src/ryl.h. The
    // table is sparse (slots 0, 6..9 have no pic); empty strings
    // fill the gaps so the array index matches the #define. Read
    // from the DSL via `{ pic: '<name>' }`; unknown-name probes
    // die at first fire, catching typos. Keeping the sparse shape
    // avoids renumbering the C-side constants during migration.
    pic: [
      '',                                                  // 0
      'inn', 'tavern', 'smith', 'church', 'merchant',      // 1..5
      '', '', '', '',                                      // 6..9  (reserved)
      'insidecave', 'cave', 'death', 'hut', 'ydarg',       // 10..14
      'city', 'wonbattle', 'tent', 'notent', 'guild',      // 15..19
    ],

    // Dungeon level-event ids (struct lvl[] entries dispatched by
    // dungeon.c). Slots 1..9 are generic cave events placed by the
    // random fill (`ryl_random(1, 9)`); slots 10..28 are hand-authored
    // quest encounters set by dungeons.scenarios.<flag>.placements.
    // dungeons.json5 placements may write these as either ints or
    // strings; res_dungeon_apply_placements resolves strings via
    // res_enum_id. Each non-empty symbol matches a top-level
    // `dungeon.<symbol>` script in data/world/scripts/dungeon.json5
    // — the dispatcher in dungeon.c builds the script id from this
    // enum slot.
    dungeon_encounter: [
      '',                                                  // 0  visited
      'find_object', 'gold',                               // 1..2
      'encounter_weak_a', 'encounter_weak_b',              // 3..4
      'encounter_deep',                                    // 5
      'nothing_a', 'nothing_b',                            // 6..7
      'gold_chest', 'torches',                             // 8..9
      'fire_shield_guardian', 'fire_shield',               // 10..11
      'thun_riddle1', 'thun_riddle2', 'thun_riddle3',      // 12..14
      'bracelets',                                         // 15
      'spectrum_message', 'colour_riddle',                 // 16..17
      'nolrim_tomb', 'master_crown',                       // 18..19
      'silver_sanctum',                                    // 20
      'hobgoblin_patrol',                                  // 21
      'royal_guard1', 'royal_guard2', 'hobgoblin_chief',   // 22..24
      'orc_nest', 'tammys_prison',                         // 25..26
      'erethor_priests', 'lute_chamber',                   // 27..28
    ],

    // Random-rolled map locations (struct state.dx[]/state.dy[],
    // populated by driv.c::position_locations on cold-start). Slots
    // 1..9 each hold a fixed quest/encounter; the lowercase key is
    // the script-stable symbol, `name` is the in-game label
    // (matching what the journal text uses). Engine_int args
    // `wld_location_x` / `wld_location_y` accept these symbols
    // directly via the §20.20 arg_enums shortcut.
    world_locations: {
      hermit_dungeon:       { name: 'Hermit dungeon'        },
      thun_temple:          { name: 'Temple of Thun'        },
      kobold_village:       { name: 'Kobold village'        },
      borin_camp:           { name: 'Borin camp'            },
      nolrim_crypt:         { name: "Nolrim's crypt"        },
      master_crown_dungeon: { name: 'Master Crown dungeon'  },
      beast_cave:           { name: 'Beast Cave'            },
      silver_key_pit:       { name: 'Pit of the Silver Key' },
      hobgoblin_cave:       { name: 'Hobgoblin cave'        },
    },
  },
}
